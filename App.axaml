<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DLSS_5_MANAGER.App"
             xmlns:local="using:DLSS_5_MANAGER"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Glare: over a bright background picture the glass surfaces and the
             text on them wash out. MainViewModel.ApplyGlare replaces these as
             the picture or its brightness changes (BackgroundStore.glare); the
             values here are the look over a dark picture, where they are the
             surfaces exactly as they always were. -->
        <SolidColorBrush x:Key="GlareVeilBrush" Color="Transparent" />
        <SolidColorBrush x:Key="GlareCardBrush" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="GlareHeaderBrush" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="GlareScreenCardBrush" Color="#10000000" />
        <SolidColorBrush x:Key="GlareBackingBrush" Color="Transparent" />
        <LinearGradientBrush x:Key="GlareCapsuleBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#30FFFFFF" Offset="0.0" />
            <GradientStop Color="#12FFFFFF" Offset="0.5" />
            <GradientStop Color="#20FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="Transparent" />
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#45FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#60FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF" />

        <!-- ToggleSwitch Glass Theme (Apple Frosted Light Silver / Grey) -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#94A3B8" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#CBD5E1" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#64748B" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#CBD5E1" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#71717A" />
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#30FFFFFF" />

        <!-- ============================================================= -->
        <!-- PILL SLIDER - LIVE FLOW's bar, and Settings' brightness        -->
        <!-- ============================================================= -->
        <!-- The value is the bar, not a knob sitting on one: the fill is
             rounded at both ends and where it stops is the setting, the way a
             phone draws brightness.

             The round end IS the thumb: 32 px, as wide as the bar is tall, so
             the Track lays the fill out as ratio * (width - 32) + 32 - a
             straight line from the lowest setting to the highest. The old bar
             drew a fixed 32 px stub under a thumb 2 px wide: the first ~6 % of
             every bar did not move at all, and near the bottom the fill was a
             clipped rounded sliver on top of the stub, which is what looked
             broken.

             The pill is three plain shapes: a round start cap, a square from
             its centre to the thumb's centre, and the round thumb. That is
             exactly a pill at every value, including the lowest. -->
        <SolidColorBrush x:Key="PillSliderFill" Color="#C3CDDB" />
        <SolidColorBrush x:Key="PillSliderFillPointerOver" Color="#DCE4EE" />

        <ControlTheme x:Key="PillSlider" TargetType="Slider">
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Margin="0,3" ClipToBounds="False">
                        <!-- The groove -->
                        <Border Height="32" CornerRadius="16" Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" />

                        <!-- The start cap: the fill's rounded beginning, always there.
                             At the lowest setting the thumb sits exactly on it. -->
                        <Border Name="PART_StartCap" Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left"
                                Background="{DynamicResource PillSliderFill}" />

                        <Track Name="PART_Track" Orientation="Horizontal" ClipToBounds="False"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <!-- Neither half of the track is hit-testable: a press
                                 anywhere on the bar moves the value to it. -->
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Focusable="False" IsHitTestVisible="False"
                                              HorizontalAlignment="Stretch" Padding="0" BorderThickness="0"
                                              ClipToBounds="False"
                                              Background="{DynamicResource PillSliderFill}">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <!-- Square, and shifted half a thumb right: it runs from the
                                                 centre of the start cap to the centre of the thumb. A
                                                 render offset, because layout will not let the button
                                                 grow past the width the track gives it. -->
                                            <Border Height="32" Background="{TemplateBinding Background}"
                                                    RenderTransform="translate(16px,0px)" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>

                            <Track.Thumb>
                                <Thumb Name="PART_Thumb" Width="32" Height="32" ZIndex="1"
                                       Background="{DynamicResource PillSliderFill}">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                <StackPanel Orientation="Horizontal" Spacing="3"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="3" Height="3" Fill="#4D0B1214" />
                                                    <Ellipse Width="3" Height="3" Fill="#4D0B1214" />
                                                    <Ellipse Width="3" Height="3" Fill="#4D0B1214" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Focusable="False" IsHitTestVisible="False"
                                              HorizontalAlignment="Stretch" Padding="0" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>

            <!-- Touching it brightens the fill, so the bar answers the hand. -->
            <Style Selector="^:pointerover /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{DynamicResource PillSliderFillPointerOver}" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_StartCap">
                <Setter Property="Background" Value="{DynamicResource PillSliderFillPointerOver}" />
            </Style>
            <Style Selector="^:pointerover /template/ Thumb#PART_Thumb">
                <Setter Property="Background" Value="{DynamicResource PillSliderFillPointerOver}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
            </Style>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Base Window & Container Theme Overrides -->
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe UI, Inter, SF Pro Display, System-UI, sans-serif" />
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>

        <!-- Global ToolTip Glass Popover Theme (Apple macOS Glassmorphism ToolTip) -->
        <Style Selector="ToolTip">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#20FFFFFF" Offset="0.5" />
                    <GradientStop Color="#30FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#75FFFFFF" Offset="0.0" />
                    <GradientStop Color="#30FFFFFF" Offset="0.5" />
                    <GradientStop Color="#50FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="ToolTip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Glass Search Input Box Style (Integrated Dark Obsidian Glass) -->
        <Style Selector="TextBox.GlassSearchBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#15000000" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="SelectionBrush" Value="#35FFFFFF" />
            <Setter Property="CaretBrush" Value="#CBD5E1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <ThicknessTransition Property="Margin" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox.GlassSearchBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.GlassSearchBox /template/ Border#PART_BorderElement">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#15000000" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style Selector="TextBox.GlassSearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#20000000" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
        </Style>

        <Style Selector="TextBox.GlassSearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#2C000000" />
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>

        <!-- Glass Window Control Buttons (Minimize, Maximize, Close) -->
        <Style Selector="Button.GlassWindowControlBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.GlassWindowControlBtn:pointerover">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>

        <Style Selector="Button.GlassWindowControlBtn.Close">
            <Setter Property="Background" Value="#30FF3B30" />
            <Setter Property="BorderBrush" Value="#50FF3B30" />
        </Style>

        <Style Selector="Button.GlassWindowControlBtn.Close:pointerover">
            <Setter Property="Background" Value="#50FF3B30" />
            <Setter Property="BorderBrush" Value="#80FF3B30" />
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>

        <!-- Segmented Tab Button [ GAMES ] [ APPS ] -->
        <Style Selector="Button.SegmentedTab">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="Padding" Value="22,7" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.SegmentedTab:pointerover">
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>

        <Style Selector="Button.SegmentedTab.Active">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#20FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.SegmentedTab.Active:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#30FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Disabled (an install is running). The Fluent theme paints its own
             pale background on a disabled button, which made every tab look
             selected at once; these keep the selected one distinguishable. -->
        <Style Selector="Button.SegmentedTab:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.SegmentedTab:disabled">
            <Setter Property="Foreground" Value="#5A6068" />
        </Style>

        <Style Selector="Button.SegmentedTab.Active:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#2AFFFFFF" Offset="0.0" />
                    <GradientStop Color="#14FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.SegmentedTab.Active:disabled">
            <Setter Property="Foreground" Value="#C7CDD4" />
        </Style>

        <!-- Utility Action Buttons (Pure Translucent Glass - matches the app shell) -->
        <!-- COMMUNITY: the game card in the grid. A bare button so the whole
             card is one click target; the border inside does the painting. -->
        <Style Selector="Button.CommunityCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.CommunityCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.CommunityCard:pointerover Border">
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>
        <Style Selector="Button.CommunityCard:pressed">
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!-- COMMUNITY: the route tally chips and the emoji buttons. Both are
             wrappers with no chrome of their own. -->
        <Style Selector="Button.RouteChip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.RouteChip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.RouteChip:pointerover Border">
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
        </Style>

        <Style Selector="Button.EmojiBtn">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.EmojiBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
        </Style>

        <Style Selector="Button.EmptyActionBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#25FFFFFF" Offset="0.0" />
                    <GradientStop Color="#10FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.EmptyActionBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.EmptyActionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1DFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.EmptyActionBtn:pointerover">
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.EmptyActionBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Disabled state for every glass button family -->
        <Style Selector="Button.EmptyActionBtn:disabled, Button.ApplePrimaryBtn:disabled, Button.AppleSecondaryBtn:disabled, Button.AppleDangerBtn:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Sub-Header Filter Pill Button (Pure Translucent Glass) -->
        <Style Selector="Button.FilterPill">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="#D1D1D6" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.FilterPill:pointerover">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>

        <Style Selector="Button.FilterPill.Active">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#25FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>

        <!-- Bottom Control Dock Panel (Border-less Pure Glass Dock) -->
        <Style Selector="Border.ControlDock">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#40FFFFFF" Offset="0.0" />
                    <GradientStop Color="#16FFFFFF" Offset="0.4" />
                    <GradientStop Color="#10FFFFFF" Offset="0.7" />
                    <GradientStop Color="#2EFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BoxShadow" Value="0 18 50 0 #80000000" />
        </Style>

        <!-- Clean Card Button (Seamless Transparent Host for Rounded Glass Cards) -->
        <Style Selector="Button.CleanCardBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.CleanCardBtn:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransform" Value="scale(1.008)" />
        </Style>

        <Style Selector="Button.CleanCardBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.CleanCardBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="Button.CleanCardBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Primary Action Button (Apple macOS Frosted Glass) -->
        <Style Selector="Button.ApplePrimaryBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1CFFFFFF" Offset="0.5" />
                    <GradientStop Color="#30FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#65FFFFFF" Offset="0.0" />
                    <GradientStop Color="#15FFFFFF" Offset="0.5" />
                    <GradientStop Color="#40FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ApplePrimaryBtn:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#28FFFFFF" Offset="0.5" />
                    <GradientStop Color="#45FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>

        <Style Selector="Button.ApplePrimaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#28FFFFFF" Offset="0.5" />
                    <GradientStop Color="#45FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Secondary Subdued Button (Pure macOS Translucent Glass) -->
        <Style Selector="Button.AppleSecondaryBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#25FFFFFF" Offset="0.0" />
                    <GradientStop Color="#10FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AppleSecondaryBtn:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1DFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.AppleSecondaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1DFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Danger / Stop Button (Pure macOS Translucent Crimson Frost Glass) -->
        <Style Selector="Button.AppleDangerBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#40FF453A" Offset="0.0" />
                    <GradientStop Color="#18FF453A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FF6B6B" />
            <Setter Property="BorderBrush" Value="#60FF453A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AppleDangerBtn:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FF453A" Offset="0.0" />
                    <GradientStop Color="#25FF453A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#80FF453A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.AppleDangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FF453A" Offset="0.0" />
                    <GradientStop Color="#25FF453A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#80FF453A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Minimal Input Styling -->
        <Style Selector="TextBox.AppleInput">
            <Setter Property="Background" Value="#14151C" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#252733" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBox.AppleInput:focus">
            <Setter Property="BorderBrush" Value="#00F0FF" />
        </Style>

        <!-- Modern Glass Card Overlay Frame -->
        <Style Selector="Border.GlassModalCard">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#F0121A15" Offset="0.0" />
                    <GradientStop Color="#F8080D0A" Offset="0.6" />
                    <GradientStop Color="#FD0C1410" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#55FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#4500FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BoxShadow" Value="0 24 60 0 #A0000000" />
        </Style>

        <!-- Glass ComboBox & Dropdown Popup Theme (macOS Glassmorphism Popover) -->
        <Style Selector="ComboBox.GlassComboBox">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox.GlassComboBox /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ComboBox.GlassComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
        </Style>

        <!-- Glass Popover Container (Dropdown List Box - Neutral Frosted Smoky Glass) -->
        <Style Selector="ComboBox.GlassComboBox /template/ Border#PopupBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E8161622" Offset="0.0" />
                    <GradientStop Color="#D50C0C14" Offset="0.5" />
                    <GradientStop Color="#DF10101A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#65FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#40FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="0 22 55 0 #B0000000, 0 0 1 1 #25FFFFFF" />
        </Style>

        <Style Selector="ComboBox.GlassComboBox /template/ ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Glass ComboBoxItem (Dropdown Items) -->
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>

        <!-- Item Hover State (Subtle Neutral Frosted Glass Glow) -->
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Item Selected State (Luminous Pure Frosted Glass Highlight) -->
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#50FFFFFF" Offset="0.0" />
                    <GradientStop Color="#2CFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Item Selected + Hover State -->
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#65FFFFFF" Offset="0.0" />
                    <GradientStop Color="#38FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Custom Glass FlyoutPresenter (Border-less Pure Dark Glass Popup) -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- Glass Quick Action Dropdown Item Button -->
        <Style Selector="Button.GlassMenuActionBtn">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pointerover">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pressed">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>

        <!-- Glass ContextMenu & MenuItem Theme (Strong Frosted Blur Glass) -->
        <Style Selector="ContextMenu.GlassContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="18" 
                            ClipToBounds="True" 
                            BorderThickness="1.5"
                            BoxShadow="0 18 45 0 #90000000">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#C0FFFFFF" Offset="0.0" />
                                <GradientStop Color="#45FFFFFF" Offset="0.5" />
                                <GradientStop Color="#85FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Panel>
                            <!-- Dense Diffuse Misty Base (Diffuses and completely softens background clutter) -->
                            <Border CornerRadius="18" Background="#D51C182A" />
                            
                            <!-- Pure Steamed White Vapor Gradient Overlay -->
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#65FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#22FFFFFF" Offset="0.4" />
                                        <GradientStop Color="#18FFFFFF" Offset="0.7" />
                                        <GradientStop Color="#50FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Content Items List -->
                            <Border Padding="6">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                KeyboardNavigation.TabNavigation="Continue" />
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ContextMenu.GlassContextMenu MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="ContextMenu.GlassContextMenu MenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#45FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- GAME CARD INNER ARTWORK EXPANSION (WIDTH & HEIGHT)             -->
        <Style Selector="Border.InnerGameCard">
            <Setter Property="Width" Value="198" />
            <Setter Property="Height" Value="268" />
        </Style>
        <Style Selector="StackPanel.GameCardItem:pointerover Border.InnerGameCard">
            <Setter Property="Width" Value="205" />
            <Setter Property="Height" Value="275" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #70000000" />
        </Style>
        <Style Selector="StackPanel.GameCardItem:pointerdown Border.InnerGameCard">
            <Setter Property="Width" Value="194" />
            <Setter Property="Height" Value="264" />
        </Style>

        <!-- ================================================================= -->
        <!-- STATIC BACKGROUNDS — NO CONTINUOUS ANIMATION                        -->
        <!-- ================================================================= -->
<!-- Slim Glass Overlay Scroller (Minimal macOS Scrollbar) -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#5CFFFFFF" />
        </Style>

        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- ============================================================== -->
        <!-- PAGE REVEAL                                                     -->
        <!-- Switching pages used to snap every card and icon into place at   -->
        <!-- once. Each card now rises and fades in on a slightly later beat, -->
        <!-- which reads as one motion instead of a flash.                    -->
        <!-- ============================================================== -->
        <Style Selector="Border.SettingsCard">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Holds the settled state only. The motion belongs to the Stagger
             styles below - putting an animation here too would match the same
             card twice and play the reveal on top of itself. -->
        <Style Selector="Border.SettingsCard.Shown">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Staggered entry: 60 ms between neighbours keeps it brisk. -->
        <Style Selector="Border.SettingsCard.Shown.Stagger1">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.00" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger2">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.06" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger3">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.12" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger4">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.18" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger5">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.24" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger6">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.30" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The games grid comes back as one soft pane rather than a snap. -->
        <Style Selector="Border.PageReveal">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border.PageReveal.Shown">
            <Setter Property="Opacity" Value="1" />
            <Style.Animations>
                <Animation Duration="0:0:0.38" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ============================================================== -->
        <!-- Route reveal                                                    -->
        <!-- Switching install route shows and hides whole rows - the API    -->
        <!-- picker, the build picker, the two add-on switches. Appearing    -->
        <!-- instantly reads as a jump, so they slide in the way the app's   -->
        <!-- own pages do, only shorter: this is a row inside a sheet, not a -->
        <!-- page. Bind Classes.Shown and IsVisible to the same property.    -->
        <!-- ============================================================== -->
        <Style Selector=":is(Control).RouteReveal.Shown">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ============================================================== -->
        <!-- Glass link buttons (Ko-fi / YouTube)                            -->
        <!-- ============================================================== -->
        <Style Selector="Button.GlassLinkBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#22FFFFFF" Offset="0.0" />
                    <GradientStop Color="#0EFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#2BFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.GlassLinkBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>

        <!-- Each link picks up a hint of its own brand on hover, no more -->
        <Style Selector="Button.GlassLinkBtn.Donate:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3CFF5E8A" Offset="0.0" />
                    <GradientStop Color="#16FF5E8A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#66FF5E8A" />
        </Style>

        <Style Selector="Button.GlassLinkBtn.Tutorials:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3CFF4444" Offset="0.0" />
                    <GradientStop Color="#16FF4444" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#66FF4444" />
        </Style>

        <!-- Header pill announcing a newer build -->
        <Style Selector="Button.UpdatePill">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3800FF88" Offset="0.0" />
                    <GradientStop Color="#1400FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#5500FF88" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.UpdatePill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <Style Selector="Button.UpdatePill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#5500FF88" Offset="0.0" />
                    <GradientStop Color="#2400FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#8000FF88" />
        </Style>

        <!-- A settings section title that folds its own contents away. It has
             to look like the plain heading it replaces, so the button chrome
             is stripped entirely and only the hover tint remains. -->
        <Style Selector="Button.SectionHeader">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- The whole title row is the hit target, but it must still read as a
             heading: no button chrome at all, and nothing that fills the card. -->
        <Style Selector="Button.SectionHeader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.SectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- The affordance lives in one small round control on the right, the
             same shape as the fold button in the Manage sheet. -->
        <Style Selector="Border.SectionChevron">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.SectionHeader:pointerover Border.SectionChevron">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
        </Style>

        <Style Selector="Button.SectionHeader:pointerover TextBlock.SectionTitle">
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="LetterSpacing" Value="0.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Holds one family of chips - a route and its variants - so the
             groups read apart instead of running together in one long row. -->
        <Style Selector="Border.ChipGroup">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="#0C1014" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A route that already installs a file of the same name is ruled
             out, and has to look ruled out. -->
        <Style Selector="Border.ChipGroup:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- The mark a card wears once the mod is on it: a small frosted bead
             in the top-right corner. Says "done" without covering the artwork;
             which route it was is on the tooltip. -->
        <!-- A frosted halo with the bead floating in it, so it reads as part
             of the glass rather than a sticker dropped on the artwork. -->
        <Style Selector="Border.ModDot">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,9,9,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="Background" Value="#59060A08" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #66000000" />
        </Style>

        <Style Selector="Border.ModDot > Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background">
                <RadialGradientBrush Center="35%,28%" GradientOrigin="35%,28%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Color="#FFDFFFEE" Offset="0.0" />
                    <GradientStop Color="#FF3BFFA6" Offset="0.45" />
                    <GradientStop Color="#FF00C46E" Offset="1.0" />
                </RadialGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 0 9 0 #A000FF88" />
        </Style>

        <!-- Read-only chips stating what the game turned out to be. Deliberately
             colourless - they are facts, not controls, and must not compete
             with the accent that marks the live route. -->
        <Style Selector="Border.DetectChip">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.DetectChipText">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#A8B3C2" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>

        <!-- Frosted marker pinned to the install route that is actually live -->
        <Style Selector="Border.ActiveRouteDot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,4,6,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="Background">
                <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%" RadiusX="70%" RadiusY="70%">
                    <GradientStop Color="#FF9BFFC8" Offset="0.0" />
                    <GradientStop Color="#E600FF88" Offset="0.55" />
                    <GradientStop Color="#B300C264" Offset="1.0" />
                </RadialGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 0 8 0 #8000FF88" />
        </Style>

        <!-- ============================================================== -->
        <!-- Glass Context Menu / Flyout (matches the Apple frosted popover) -->
        <!-- ============================================================== -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E8121A15" Offset="0.0" />
                    <GradientStop Color="#D5080D0A" Offset="0.5" />
                    <GradientStop Color="#DF0C1410" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#4500FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="MenuFlyoutPresenter /template/ ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#2600FF88" />
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Plain (non-menu) flyouts get the same frosted shell -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E8121A15" Offset="0.0" />
                    <GradientStop Color="#DF0C1410" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!-- ================================================================= -->
        <!-- DOWNLOADS (CloudAssets)                                            -->
        <!-- ================================================================= -->

        <!-- The round button beside the tabs. Its colours go on the
             ContentPresenter: in this theme that is what draws a button's
             background, and Fluent repaints it on hover. -->
        <Style Selector="Button.AssetsBadgeBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AssetsBadgeBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderBrush" Value="#4535D22B" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#302FCB6A" Offset="0.0" />
                    <GradientStop Color="#12FFFFFF" Offset="0.5" />
                    <GradientStop Color="#20FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.AssetsBadgeBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>

        <Style Selector="Button.AssetsBadgeBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#8035D22B" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#5035D22B" Offset="0.0" />
                    <GradientStop Color="#1C35D22B" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Turns only while a download is running: the class is bound to
             that, so nothing animates the rest of the time. -->
        <Style Selector="Ellipse.AssetsSpin.Busy">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The green action in the Downloads sheet (and the lock's way out in
             the Manage sheet). Painted on the presenter for the reason above;
             the text colour is held there too, or Fluent turns it white on hover. -->
        <Style Selector="Button.AssetPrimaryBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AssetPrimaryBtn.Small">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button.AssetPrimaryBtn.Large">
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Button.AssetPrimaryBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#06170A" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#4AE840" Offset="0.0" />
                    <GradientStop Color="#2BB023" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.AssetPrimaryBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>

        <Style Selector="Button.AssetPrimaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#06170A" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#63F559" Offset="0.0" />
                    <GradientStop Color="#35C22B" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.AssetPrimaryBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#06170A" />
            <Setter Property="Background" Value="#2BB023" />
        </Style>

        <Style Selector="Button.AssetPrimaryBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#6B7F71" />
            <Setter Property="Background" Value="#16211A" />
        </Style>

        <Style Selector="ProgressBar.AssetBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="Foreground">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#35D22B" Offset="0.0" />
                    <GradientStop Color="#00FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Border.AssetCard">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1EFFFFFF" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#12FFFFFF" Offset="0.0" />
                    <GradientStop Color="#05FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.AssetCard.Ready">
            <Setter Property="BorderBrush" Value="#4535D22B" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1635D22B" Offset="0.0" />
                    <GradientStop Color="#0535D22B" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Border.AssetIcon">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4035D22B" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#2C35D22B" Offset="0.0" />
                    <GradientStop Color="#0800FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- ================================================================= -->
        <!-- MANAGE SHEET: ANTI-CHEAT MARK                                      -->
        <!-- ================================================================= -->
        <!-- The same glass as the rescan button beside it (GlassWindowControlBtn);
             only the "!" is amber, so it still reads as a warning. Painted on the
             presenter, like every coloured button here. -->
        <Style Selector="Button.AntiCheatBadge">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AntiCheatBadge /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AntiCheatBadge:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>

        <Style Selector="Button.AntiCheatBadge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#66FCD34D" />
        </Style>

        <!-- ================================================================= -->
        <!-- MANAGE SHEET: CHANGE KEY                                           -->
        <!-- ================================================================= -->
        <Style Selector="Border.KeyRow">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <!-- The key as a keycap, then the word that says it can be changed -->
        <Style Selector="Border.KeyCap">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#34FFFFFF" Offset="0.0" />
                    <GradientStop Color="#14FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.KeyChip">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="5,4,11,4" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.KeyChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#1035D22B" />
            <Setter Property="BorderBrush" Value="#3535D22B" />
        </Style>

        <Style Selector="Button.KeyChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2435D22B" />
            <Setter Property="BorderBrush" Value="#7035D22B" />
        </Style>

        <Style Selector="Button.KeyChip:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
        </Style>

        <Style Selector="Button.KeyChip:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- ================================================================= -->
        <!-- SETTINGS: BACKGROUND PICKER                                        -->
        <!-- ================================================================= -->
        <Style Selector="Button.BgTile">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.BgTile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.BgTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.BgTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- The ring, with a 3 px gap to the picture. The picture has its own
             rounded clip one step tighter, so the two curves stay parallel. -->
        <Style Selector="Button.BgTile Border.BgTileFrame">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="Background" Value="#0A0E0C" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.BgTile Border.BgTileImage">
            <Setter Property="Height" Value="82" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#0C1014" />
        </Style>

        <Style Selector="Button.BgTile:pointerover Border.BgTileFrame">
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>

        <Style Selector="Button.BgTile.Selected Border.BgTileFrame">
            <Setter Property="BorderBrush" Value="#35D22B" />
            <Setter Property="BoxShadow" Value="0 0 16 0 #5035D22B" />
        </Style>

        <Style Selector="Button.BgTileRemove">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.BgTileRemove /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D00B1210" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
        </Style>

        <Style Selector="Button.BgTileRemove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E0B42318" />
            <Setter Property="BorderBrush" Value="#80FF6961" />
        </Style>

        <Style Selector="Button.BgTile TextBlock.BgTileLabel">
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>

        <Style Selector="Button.BgTile:pointerover TextBlock.BgTileLabel">
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="Button.BgTile.Selected TextBlock.BgTileLabel">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

    </Application.Styles>
</Application>
