<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DLSS_5_MANAGER.ViewModels"
        xmlns:views="using:DLSS_5_MANAGER.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        x:Class="DLSS_5_MANAGER.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.ico"
        Title="DLSS 5 MANAGER"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowDecorations="None"
        PointerMoved="OnCardPointerMoved"
        PointerReleased="OnCardPointerReleased">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- GAME CARD INNER ARTWORK EXPANSION (WIDTH & HEIGHT TRANSITION) -->
        <Style Selector="StackPanel.GameCardItem Border.InnerGameCard">
            <Setter Property="Width" Value="198" />
            <Setter Property="Height" Value="268" />
        </Style>
        <Style Selector="StackPanel.GameCardItem:pointerover Border.InnerGameCard">
            <Setter Property="Width" Value="205" />
            <Setter Property="Height" Value="275" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #70000000" />
        </Style>
        <Style Selector="StackPanel.GameCardItem:pointerdown Border.InnerGameCard">
            <Setter Property="Width" Value="194" />
            <Setter Property="Height" Value="264" />
        </Style>
        <Style Selector="StackPanel.GameCardItem:pointerover Border.GameCardBezel">
            <Setter Property="Background" Value="#141C18" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BoxShadow" Value="0 10 30 0 #65000000, 0 0 20 1 #30FFFFFF" />
        </Style>

        <!-- The card being dropped onto, repeated from the card's own styles.
             This copy is the one that decides: the resting rule at the top of
             this block outranks anything the item template says, so a drag
             target declared only down there is silently flattened back to
             198x268. Keep it last here as well. -->
        <Style Selector="StackPanel.GameCardItem.DragTarget Border.InnerGameCard">
            <Setter Property="Width" Value="211" />
            <Setter Property="Height" Value="281" />
            <Setter Property="BorderBrush" Value="#AAFFFFFF" />
            <Setter Property="BoxShadow" Value="0 8 26 0 #80000000" />
        </Style>
        <Style Selector="StackPanel.GameCardItem.Still.DragTarget Border.InnerGameCard">
            <Setter Property="Width" Value="198" />
            <Setter Property="Height" Value="268" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
    </Window.Styles>

    <!-- The frame and, outside its rounded clip, the resize grips. They sit in
         the window's square corners, which the rounded frame leaves empty. -->
    <Panel>
    <!-- Main Outer Window Frame (Seamless Rounded Glass Frame) -->
    <Border CornerRadius="28" ClipToBounds="True" BorderThickness="0" Background="Transparent">
        <Panel>
            <!-- Invisible Focus Sink to reliably clear TextBox focus when clicking blank areas -->
            <Border x:Name="DummyFocusSink" Focusable="True" IsHitTestVisible="False" Width="0" Height="0" Opacity="0" />

            <!-- The window's background: the atmosphere's picture, or the user's
                 own. A change cross-fades, and the black layer over it is the
                 brightness slider in Settings - these are bright, saturated
                 pictures behind white text, so they are kept dim by default. -->
            <Panel x:Name="DynamicBackgroundCanvas" ClipToBounds="True" IsHitTestVisible="False">
                <!-- What shows if the picture cannot be read -->
                <Border Background="{Binding BgBaseBrush}" />

                <TransitioningContentControl Content="{Binding BackgroundImage}"
                                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.45" />
                    </TransitioningContentControl.PageTransition>
                    <TransitioningContentControl.ContentTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </DataTemplate>
                    </TransitioningContentControl.ContentTemplate>
                </TransitioningContentControl>

                <!-- Brightness: 1 - slider / 100 of plain black -->
                <Border Background="#000000" Opacity="{Binding BackgroundDimOpacity}" />

                <!-- Glare: a little more black only while the picture on screen is
                     bright enough to wash out the text over it (App.axaml) -->
                <Border Background="{DynamicResource GlareVeilBrush}" />

                <!-- Soft Glass Vignette Backdrop Overlay -->
                <Border Background="{Binding BgVignetteBrush}" />
            </Panel>

            <!-- Light Diffusion Backdrop Acrylic Overlay -->
            <Border Background="#18000000" />

            <!-- Inner Glass Specular Rim Border -->
            <Border CornerRadius="28" BorderThickness="1" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1CFFFFFF" Offset="0.0" />
                        <GradientStop Color="#08FFFFFF" Offset="0.5" />
                        <GradientStop Color="#14FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <Grid ColumnDefinitions="Auto,*">

                <!-- 1. LEFT SIDEBAR NAVIGATION PANEL (Active when IsSidebarLayout = True) -->
                <Border Grid.Column="0" Width="186" IsVisible="{Binding IsSidebarLayout}"
                        Margin="14,14,0,14" CornerRadius="20" BorderThickness="1"
                        Padding="10,18,10,16" PointerPressed="OnHeaderPointerPressed"
                        BoxShadow="0 14 36 0 #30000000" Background="{DynamicResource GlareCapsuleBrush}">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#45FFFFFF" Offset="0.0" />
                            <GradientStop Color="#15FFFFFF" Offset="0.5" />
                            <GradientStop Color="#30FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Top: Brand Wordmark -->
                        <Image Grid.Row="0" Source="/Assets/logo_bar.png" Width="162" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               HorizontalAlignment="Center" Margin="0,8,0,28" />

                        <!-- Middle: Clean Text Navigation (Games only) -->
                        <StackPanel Grid.Row="1" Spacing="4">
                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsGamesTabActive}" Click="OnTabGamesClicked"
                                    Content="{Binding Loc.Games}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" />
                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsEmulatorsTabActive}" Click="OnTabEmulatorsClicked"
                                    Content="{Binding Loc.TabEmulators}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" />
                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsCommunityTabActive}" Click="OnTabCommunityClicked"
                                    Content="{Binding Loc.TabCommunity}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" />
                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsScreenTabActive}" Click="OnTabScreenClicked" Content="LIVE FLOW" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" />
                        </StackPanel>

                        <!-- Bottom: Settings -->
                        <Button Grid.Row="2" Classes="SegmentedTab" Classes.Active="{Binding IsSettingsOpen}" Click="OnSettingsClicked"
                                Content="SETTINGS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" ToolTip.Tip="{Binding Loc.Settings}" />
                    </Grid>
                </Border>

                <!-- 2. MAIN WORKSPACE HOST AREA -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*">

                    <!-- TOP HEADER BAR (Only visible when IsTopBarLayout = True) -->
                    <Border Grid.Row="0" Height="56" Background="Transparent" BorderThickness="0" Padding="22,6,20,0"
                            IsVisible="{Binding IsTopBarLayout}" PointerPressed="OnHeaderPointerPressed">
                        <!-- Two star columns either side of the capsule keep it centred
                             between the logo and the window controls, as it was, while
                             leaving room beside it for the download button. -->
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">

                            <!-- Left: Brand Wordmark -->
                            <Image Grid.Column="0" Source="/Assets/logo_bar.png"
                                   Height="32" Stretch="Uniform"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />

                            <!-- Downloads: only while something is still missing. It stands
                                 apart from the capsule on purpose - something to come back
                                 to, not a page. -->
                            <Button Grid.Column="1" Classes="AssetsBadgeBtn" Click="OnOpenAssetsClicked" Cursor="Hand"
                                    IsVisible="{Binding HasMissingAssets}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                    ToolTip.Tip="{Binding Loc.AssetsButtonTip}">
                                <Panel Width="34" Height="34">
                                    <PathIcon Data="M 12,3 A 1,1 0 0 1 13,4 V 13.59 L 16.29,10.29 A 1,1 0 0 1 17.71,11.71 L 12.71,16.71 A 1,1 0 0 1 11.29,16.71 L 6.29,11.71 A 1,1 0 0 1 7.71,10.29 L 11,13.59 V 4 A 1,1 0 0 1 12,3 Z M 5,19 H 19 A 1,1 0 0 1 19,21 H 5 A 1,1 0 0 1 5,19 Z"
                                              Width="14" Height="14" Foreground="#86EFAC"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Classes="AssetsSpin" Classes.Busy="{Binding IsAssetsBusy}" IsVisible="{Binding IsAssetsBusy}"
                                             Width="30" Height="30" StrokeThickness="2"
                                             StrokeDashArray="3,2" StrokeLineCap="Round" Stroke="#35D22B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             RenderTransformOrigin="50%,50%" />
                                    <Border IsVisible="{Binding !IsAssetsBusy}" Width="8" Height="8" CornerRadius="4"
                                            Background="#FCD34D" BorderBrush="#0B1210" BorderThickness="1.5"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                                </Panel>
                            </Button>

                            <!-- Center: Segmented Control Capsule -->
                            <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Padding="3" BorderThickness="1"
                                    Background="{DynamicResource GlareCapsuleBrush}">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#45FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#15FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#30FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsGamesTabActive}" Click="OnTabGamesClicked" Content="{Binding Loc.Games}" />
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsEmulatorsTabActive}" Click="OnTabEmulatorsClicked" Content="{Binding Loc.TabEmulators}" />


                                    <!-- Add Game / Folder Button (+) -->
                                    <Button Classes="SegmentedTab" x:Name="BtnAddGame" ToolTip.Tip="{Binding Loc.AddGame}" Padding="12,7">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                                        HorizontalOffset="-10" VerticalOffset="10">
                                                <MenuItem Header="Add Game Folder..." Click="OnAddCustomFolderClicked" IsVisible="{Binding !IsEmulatorsTabActive}" />
                                                <MenuItem Header="Add Game Executable (.exe)..." Click="OnAddSingleGameFileClicked" IsVisible="{Binding !IsEmulatorsTabActive}" />
                                                <MenuItem Header="Detect Games Automatically" Click="OnRescanClicked" IsVisible="{Binding !IsEmulatorsTabActive}" />
                                                <MenuItem Header="Add Emulator (.exe)..." Click="OnAddEmulatorClicked" IsVisible="{Binding IsEmulatorsTabActive}" />
                                                <MenuItem Header="Detect Emulators Automatically" Click="OnDetectEmulatorsClicked" IsVisible="{Binding IsEmulatorsTabActive}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <PathIcon Data="M 19,13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z"
                                                  Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Search Button. In the community grid this pair moves down
                                         beside the filters, where the search actually applies -
                                         so it leaves the title bar entirely while that is open. -->
                                    <Button Classes="SegmentedTab" x:Name="BtnSearch" Click="OnSearchClicked" ToolTip.Tip="{Binding Loc.SearchGames}" Padding="12,7"
                                            IsVisible="{Binding !IsCommunityGridActive}">
                                        <PathIcon Data="M 15.5,14 H 14.71 L 14.43,13.73 A 6.47,6.47 0 0 0 16,9.5 A 6.5,6.5 0 1 0 9.5,16 C 11.11,16 12.59,15.41 13.73,14.43 L 14,14.71 V 15.5 L 19,20.49 L 20.49,19 L 15.5,14 Z M 9.5,14 C 7.01,14 5,11.99 5,9.5 C 5,7.01 7.01,5 9.5,5 C 12,5 14,7.01 14,9.5 C 14,11.99 12,14 9.5,14 Z"
                                                  Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Expanding Search Input Box -->
                                    <TextBox x:Name="SearchInputBox"
                                             Classes="GlassSearchBox"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             IsVisible="{Binding !IsCommunityGridActive}"
                                             IsHitTestVisible="{Binding IsSearchOpen}"
                                             Focusable="{Binding IsSearchOpen}"
                                             PlaceholderText="{Binding SearchPlaceholder}"
                                             Width="{Binding SearchBoxWidth}"
                                             Opacity="{Binding SearchBoxOpacity}"
                                             Margin="{Binding SearchBoxMargin}"
                                             Height="26"
                                             VerticalAlignment="Center" />

                                    <!-- Settings Button -->
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsSettingsOpen}" x:Name="BtnSettings" Click="OnSettingsClicked" ToolTip.Tip="{Binding Loc.Settings}" Padding="12,7">
                                        <PathIcon Data="M 19.14,12.94 C 19.18,12.64 19.2,12.33 19.2,12 C 19.2,11.68 19.18,11.36 19.13,11.06 L 21.16,9.48 C 21.34,9.34 21.39,9.07 21.28,8.87 L 19.36,5.55 C 19.24,5.33 18.99,5.26 18.77,5.33 L 16.38,6.29 C 15.88,5.91 15.35,5.59 14.76,5.35 L 14.4,2.81 C 14.36,2.57 14.16,2.4 13.92,2.4 H 10.08 C 9.84,2.4 9.65,2.57 9.61,2.81 L 9.25,5.35 C 8.66,5.59 8.12,5.92 7.63,6.29 L 5.24,5.33 C 5.02,5.25 4.77,5.33 4.65,5.55 L 2.73,8.87 C 2.61,9.08 2.66,9.34 2.86,9.48 L 4.89,11.06 C 4.84,11.36 4.8,11.69 4.8,12 C 4.8,12.31 4.82,12.64 4.87,12.94 L 2.84,14.52 C 2.66,14.66 2.61,14.93 2.72,15.13 L 4.64,18.45 C 4.76,18.67 5.01,18.74 5.23,18.67 L 7.62,17.71 C 8.12,18.09 8.65,18.41 9.24,18.65 L 9.6,21.19 C 9.65,21.43 9.84,21.6 10.08,21.6 H 13.92 C 14.16,21.6 14.36,21.43 14.39,21.19 L 14.75,18.65 C 15.34,18.41 15.88,18.09 16.37,17.71 L 18.76,18.67 C 18.98,18.75 19.23,18.67 19.35,18.45 L 21.27,15.13 C 21.39,14.91 21.34,14.66 21.14,14.52 L 19.14,12.94 Z M 12,15.6 C 10.02,15.6 8.4,13.98 8.4,12 C 8.4,10.02 10.02,8.4 12,8.4 C 13.98,8.4 15.6,10.02 15.6,12 C 15.6,13.98 13.98,15.6 12,15.6 Z"
                                                  Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsCommunityTabActive}" Click="OnTabCommunityClicked" Content="{Binding Loc.TabCommunity}" />
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsScreenTabActive}" Click="OnTabScreenClicked" Content="LIVE FLOW" />
                                </StackPanel>
                            </Border>

                            <!-- Right: Glass Window Controls -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Checked on every launch; only appears when a newer build exists -->
                                <Button Classes="UpdatePill" Click="OnUpdateBadgeClicked" Cursor="Hand"
                                        IsVisible="{Binding HasUpdateAvailable}" Margin="0,0,6,0"
                                        ToolTip.Tip="{Binding UpdateStatusText}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="M 12,2 L 6,8 H 10 V 15 H 14 V 8 H 18 Z M 5,18 H 19 V 21 H 5 Z"
                                                  Width="11" Height="11" Foreground="#86EFAC" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UpdateBadgeText}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="#DCFCE7" LetterSpacing="0.4" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="GlassWindowControlBtn" Click="OnMinimizeClicked" ToolTip.Tip="{Binding Loc.Minimize}">
                                    <PathIcon Data="M 19,13 H 5 V 11 H 19 V 13 Z" Width="10" Height="10" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="GlassWindowControlBtn" Click="OnMaximizeClicked" ToolTip.Tip="{Binding Loc.Maximize}">
                                    <PathIcon Data="M 19,3 H 5 C 3.9,3 3,3.9 3,5 V 19 C 3,20.1 3.9,21 5,21 H 19 C 20.1,21 21,20.1 21,19 V 5 C 21,3.9 20.1,3 19,3 Z M 19,19 H 5 V 5 H 19 V 19 Z" Width="10" Height="10" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="GlassWindowControlBtn Close" Click="OnCloseClicked" ToolTip.Tip="{Binding Loc.Close}">
                                    <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z" Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- MINIMAL TOP DRAG BAR (Only visible when IsSidebarLayout = True) -->
                    <Border Grid.Row="0" Height="56" Background="Transparent" BorderThickness="0" Padding="16,6,20,0"
                            IsVisible="{Binding IsSidebarLayout}" PointerPressed="OnHeaderPointerPressed">
                        <Grid ColumnDefinitions="*,Auto,*">
                            <Panel Grid.Column="0" Background="Transparent" />

                            <!-- Downloads, beside the capsule as in the top-bar layout -->
                            <Button Grid.Column="0" Classes="AssetsBadgeBtn" Click="OnOpenAssetsClicked" Cursor="Hand"
                                    IsVisible="{Binding HasMissingAssets}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                    ToolTip.Tip="{Binding Loc.AssetsButtonTip}">
                                <Panel Width="34" Height="34">
                                    <PathIcon Data="M 12,3 A 1,1 0 0 1 13,4 V 13.59 L 16.29,10.29 A 1,1 0 0 1 17.71,11.71 L 12.71,16.71 A 1,1 0 0 1 11.29,16.71 L 6.29,11.71 A 1,1 0 0 1 7.71,10.29 L 11,13.59 V 4 A 1,1 0 0 1 12,3 Z M 5,19 H 19 A 1,1 0 0 1 19,21 H 5 A 1,1 0 0 1 5,19 Z"
                                              Width="14" Height="14" Foreground="#86EFAC"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Classes="AssetsSpin" Classes.Busy="{Binding IsAssetsBusy}" IsVisible="{Binding IsAssetsBusy}"
                                             Width="30" Height="30" StrokeThickness="2"
                                             StrokeDashArray="3,2" StrokeLineCap="Round" Stroke="#35D22B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             RenderTransformOrigin="50%,50%" />
                                    <Border IsVisible="{Binding !IsAssetsBusy}" Width="8" Height="8" CornerRadius="4"
                                            Background="#FCD34D" BorderBrush="#0B1210" BorderThickness="1.5"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                                </Panel>
                            </Button>

                            <!-- Center: Quick Actions Capsule -->
                            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Padding="3" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#30FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#12FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#20FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#45FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#15FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#30FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="SegmentedTab" ToolTip.Tip="{Binding Loc.AddGame}" Padding="12,7">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                                        HorizontalOffset="-10" VerticalOffset="10">
                                                <MenuItem Header="Add Game Folder..." Click="OnAddCustomFolderClicked" IsVisible="{Binding !IsEmulatorsTabActive}" />
                                                <MenuItem Header="Add Game Executable (.exe)..." Click="OnAddSingleGameFileClicked" IsVisible="{Binding !IsEmulatorsTabActive}" />
                                                <MenuItem Header="Detect Games Automatically" Click="OnRescanClicked" IsVisible="{Binding !IsEmulatorsTabActive}" />
                                                <MenuItem Header="Add Emulator (.exe)..." Click="OnAddEmulatorClicked" IsVisible="{Binding IsEmulatorsTabActive}" />
                                                <MenuItem Header="Detect Emulators Automatically" Click="OnDetectEmulatorsClicked" IsVisible="{Binding IsEmulatorsTabActive}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <PathIcon Data="M 19,13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z"
                                                  Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Same pair as the top-bar layout, and it steps aside for the
                                         community grid in the same way. -->
                                    <Button Classes="SegmentedTab" Click="OnSearchClicked" ToolTip.Tip="{Binding Loc.SearchGames}" Padding="12,7"
                                            IsVisible="{Binding !IsCommunityGridActive}">
                                        <PathIcon Data="M 15.5,14 H 14.71 L 14.43,13.73 A 6.47,6.47 0 0 0 16,9.5 A 6.5,6.5 0 1 0 9.5,16 C 11.11,16 12.59,15.41 13.73,14.43 L 14,14.71 V 15.5 L 19,20.49 L 20.49,19 L 15.5,14 Z M 9.5,14 C 7.01,14 5,11.99 5,9.5 C 5,7.01 7.01,5 9.5,5 C 12,5 14,7.01 14,9.5 C 14,11.99 12,14 9.5,14 Z"
                                                  Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Button>

                                    <TextBox x:Name="SearchInputBoxSidebar"
                                             Classes="GlassSearchBox"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             IsVisible="{Binding !IsCommunityGridActive}"
                                             IsHitTestVisible="{Binding IsSearchOpen}"
                                             Focusable="{Binding IsSearchOpen}"
                                             PlaceholderText="{Binding SearchPlaceholder}"
                                             Width="{Binding SearchBoxWidth}"
                                             Opacity="{Binding SearchBoxOpacity}"
                                             Margin="{Binding SearchBoxMargin}"
                                             Height="26"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Right: Window Controls -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="GlassWindowControlBtn" Click="OnMinimizeClicked" ToolTip.Tip="{Binding Loc.Minimize}">
                                    <PathIcon Data="M 19,13 H 5 V 11 H 19 V 13 Z" Width="10" Height="10" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="GlassWindowControlBtn" Click="OnMaximizeClicked" ToolTip.Tip="{Binding Loc.Maximize}">
                                    <PathIcon Data="M 19,3 H 5 C 3.9,3 3,3.9 3,5 V 19 C 3,20.1 3.9,21 5,21 H 19 C 20.1,21 21,20.1 21,19 V 5 C 21,3.9 20.1,3 19,3 Z M 19,19 H 5 V 5 H 19 V 19 Z" Width="10" Height="10" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="GlassWindowControlBtn Close" Click="OnCloseClicked" ToolTip.Tip="{Binding Loc.Close}">
                                    <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z" Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 1: CONTENT HOST (Settings View OR Games Grid View) -->
                    <Panel Grid.Row="1">
                        <Panel IsVisible="{Binding IsScreenTabActive}">
                            <views:ScreenView DataContext="{Binding Screen}" />
                        </Panel>

                        <!-- 1. SETTINGS & PREFERENCES VIEW -->
                        <ScrollViewer x:Name="SettingsScrollViewer"
                                      IsVisible="{Binding IsSettingsOpen}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      PointerWheelChanged="OnSettingsWheelChanged"
                                      Padding="28,14,28,24">
                            <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch" Margin="0,0,0,110">

                                <!-- Header: Title + Back Button -->
                                <Border Background="{DynamicResource GlareHeaderBrush}" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="18" Padding="18,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Loc.SettingsPreferences}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" LetterSpacing="0.5" />

                                        <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnBackToGamesClicked" Cursor="Hand" Padding="14,7">
                                            <TextBlock Text="{Binding Loc.BackToGames}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Card 1b: DYNAMIC MODS - the payload files, user replaceable. First of
                                     all the cards: it is what people open Settings for. -->
                                <Border Classes="SettingsCard Stagger5" Classes.Shown="{Binding IsSettingsOpen}" IsVisible="{Binding ShowPayloadCard}"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <StackPanel Spacing="14">
                                        <Button Classes="SectionHeader" Click="OnToggleSectionClicked" Tag="payload" Cursor="Hand">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="SectionTitle" Text="{Binding Loc.ModPayloadFiles}" />
                                                <Border Grid.Column="1" Classes="SectionChevron">
                                                    <PathIcon Data="{Binding PayloadChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <StackPanel Spacing="12" IsVisible="{Binding IsPayloadSectionOpen}">
                                            <!-- Swappable files, each with its own on/off switch -->
                                            <ItemsControl ItemsSource="{Binding PayloadRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PayloadRowViewModel">
                                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14"
                                                                Padding="14,10" Margin="0,0,0,10">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="#94A3B8" />
                                                                </StackPanel>

                                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                              IsVisible="{Binding CanDisable}"
                                                                              OnContent="" OffContent="" VerticalAlignment="Center"
                                                                              ToolTip.Tip="Off means this file is left out of every install" />

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <Button Classes="EmptyActionBtn" Click="OnReplacePayloadRowClicked" Cursor="Hand" Padding="14,7">
                                                                        <TextBlock Text="{Binding $parent[Window].DataContext.Loc.Replace}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    </Button>
                                                                    <Button Classes="EmptyActionBtn" Click="OnRestorePayloadRowClicked" Cursor="Hand" Padding="14,7">
                                                                        <TextBlock Text="{Binding $parent[Window].DataContext.Loc.Restore}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- ReShade installer: any newer build can take its place -->
                                            <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,10">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="ReShade setup" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                        <TextBlock Text="{Binding ReShadeSetupState}" FontSize="11" Foreground="#94A3B8" />
                                                    </StackPanel>

                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsReShadeEnabled, Mode=TwoWay}"
                                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                                  ToolTip.Tip="Off means no install runs the ReShade setup" />

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Classes="EmptyActionBtn" Click="OnReplaceReShadeClicked" Cursor="Hand" Padding="14,7"
                                                                ToolTip.Tip="Pick a newer ReShade_Setup .exe">
                                                            <TextBlock Text="{Binding Loc.Replace}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Button>
                                                        <Button Classes="EmptyActionBtn" Click="OnRestoreReShadeClicked" Cursor="Hand" Padding="14,7">
                                                            <TextBlock Text="{Binding Loc.Restore}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- OptiScaler: a folder, so no switch - nothing installs
                                                 without it. There used to be two of these; the plain
                                                 build was dropped in 1.2.1 and the neural upstream one
                                                 is now what every OptiScaler install uses. -->
                                            <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="OptiScaler" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                        <TextBlock Text="{Binding OptiScalerNeuralState}" FontSize="11" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Classes="EmptyActionBtn" Click="OnReplaceOptiScalerNeuralClicked" Cursor="Hand" Padding="14,7"
                                                                ToolTip.Tip="Pick the folder the neural-upstream build was extracted into - it must contain OptiScaler.dll">
                                                            <TextBlock Text="{Binding Loc.Replace}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Button>
                                                        <Button Classes="EmptyActionBtn" Click="OnRestoreOptiScalerNeuralClicked" Cursor="Hand" Padding="14,7">
                                                            <TextBlock Text="{Binding Loc.Restore}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- The RTX 40 build of OptiScaler. An RTX 40 card installs
                                                 this one instead, so it needs its own Replace/Restore -
                                                 without them those cards had no way to update it. -->
                                            <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="OptiScaler RTX 40" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                        <TextBlock Text="{Binding OptiScalerRtx40State}" FontSize="11" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Classes="EmptyActionBtn" Click="OnReplaceOptiScalerRtx40Clicked" Cursor="Hand" Padding="14,7"
                                                                ToolTip.Tip="Pick the folder the RTX 40 build was extracted into - it must contain OptiScaler.dll">
                                                            <TextBlock Text="{Binding Loc.Replace}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Button>
                                                        <Button Classes="EmptyActionBtn" Click="OnRestoreOptiScalerRtx40Clicked" Cursor="Hand" Padding="14,7">
                                                            <TextBlock Text="{Binding Loc.Restore}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- AMD payload: swappable, but never switchable - the
                                                 route has nothing to install without it. -->
                                            <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="AMD payload (version.dll)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                        <TextBlock Text="{Binding AmdPayloadState}" FontSize="11" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Classes="EmptyActionBtn" Click="OnReplaceAmdPayloadClicked" Cursor="Hand" Padding="14,7"
                                                                ToolTip.Tip="Pick one or more files - each replaces the one of the same name">
                                                            <TextBlock Text="{Binding Loc.Replace}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Button>
                                                        <Button Classes="EmptyActionBtn" Click="OnRestoreAmdPayloadClicked" Cursor="Hand" Padding="14,7">
                                                            <TextBlock Text="{Binding Loc.Restore}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Rectangle Height="1" Fill="#12FFFFFF" HorizontalAlignment="Stretch" />

                                            <!-- User extras -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Loc.Extras}" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="0.5" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Classes="EmptyActionBtn" Cursor="Hand" Padding="14,8" VerticalAlignment="Center">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="Add folder..." Click="OnAddExtraFolderClicked" />
                                                            <MenuItem Header="Add file(s)..." Click="OnAddExtraFilesClicked" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <TextBlock Text="{Binding Loc.BtnAddExtra}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Button>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Extras}" IsVisible="{Binding HasExtras}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ExtraRowViewModel">
                                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14"
                                                                Padding="14,12" Margin="0,0,0,10">
                                                            <StackPanel Spacing="11">
                                                                <!-- Identity and the switch that decides if it ships -->
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10.5" Foreground="#64748B"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="430" HorizontalAlignment="Left" />
                                                                    </StackPanel>

                                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                                                  ToolTip.Tip="Off means this is left out of every install" />

                                                                    <Button Grid.Column="2" Classes="EmptyActionBtn" Click="OnRemoveExtraClicked" Cursor="Hand" Padding="14,7">
                                                                        <TextBlock Text="REMOVE" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                                                    </Button>
                                                                </Grid>

                                                                <!-- What the batch actually contains -->
                                                                <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                                                        CornerRadius="10" Padding="10,7" IsVisible="{Binding HasManyFiles}">
                                                                    <TextBlock Text="{Binding FilesLabel}" FontSize="10.5" Foreground="#94A3B8"
                                                                               TextWrapping="Wrap" LineHeight="16" />
                                                                </Border>

                                                                <Rectangle Height="1" Fill="#12FFFFFF" HorizontalAlignment="Stretch" />

                                                                <!-- Where it installs -->
                                                                <StackPanel Spacing="8">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                        <TextBlock Grid.Column="0" Text="INSTALLS WITH" FontSize="9.5" FontWeight="Bold"
                                                                                   Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding ModesText}" FontSize="10.5" FontWeight="SemiBold"
                                                                                   Foreground="#94A3B8" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </Grid>

                                                                    <!-- One row per family, so the variants read as variants
                                                                         rather than nine equal buttons in a heap. -->
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="ChipGroup">
                                                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsAllModes}" Click="OnToggleExtraModeClicked"
                                                                                    Tag="all" Padding="13,5" Content="ALL MODES" Cursor="Hand" FontSize="10.5" />
                                                                        </Border>

                                                                        <Border Classes="ChipGroup" IsEnabled="{Binding IsOptiDx12Allowed}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsOptiDx12Mode}" Click="OnToggleExtraModeClicked"
                                                                                        Tag="optiscaler-dx12" Padding="11,5" Content="OPTI" Cursor="Hand" FontSize="10.5" />
                                                                                <!-- There is no third OptiScaler variant to aim at
                                                                                     since 1.2.1, so "optiscaler-neural" can no longer
                                                                                     be produced at install time and the chip that set
                                                                                     it is gone with it. -->
                                                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsOptiVulkanMode}" Click="OnToggleExtraModeClicked"
                                                                                        Tag="optiscaler-vulkan" Padding="11,5" Content="VK" Cursor="Hand" FontSize="10.5" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Border Classes="ChipGroup" IsEnabled="{Binding IsDx12Allowed}">
                                                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx12Mode}" Click="OnToggleExtraModeClicked"
                                                                                    Tag="dx12" Padding="11,5" Content="DX12" Cursor="Hand" FontSize="10.5" />
                                                                        </Border>

                                                                        <Border Classes="ChipGroup" IsEnabled="{Binding IsDx11Allowed}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx1164Mode}" Click="OnToggleExtraModeClicked"
                                                                                        Tag="dx11-64" Padding="11,5" Content="DX11 - 10" Cursor="Hand" FontSize="10.5" />
                                                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx1132Mode}" Click="OnToggleExtraModeClicked"
                                                                                        Tag="dx11-32" Padding="11,5" Content="32b" Cursor="Hand" FontSize="10.5" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Border Classes="ChipGroup" IsEnabled="{Binding IsDx9Allowed}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx964Mode}" Click="OnToggleExtraModeClicked"
                                                                                        Tag="dx9-64" Padding="11,5" Content="DX9" Cursor="Hand" FontSize="10.5" />
                                                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx932Mode}" Click="OnToggleExtraModeClicked"
                                                                                        Tag="dx9-32" Padding="11,5" Content="32b" Cursor="Hand" FontSize="10.5" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Border Classes="ChipGroup" IsEnabled="{Binding IsAmdAllowed}">
                                                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsAmdMode}" Click="OnToggleExtraModeClicked"
                                                                                    Tag="amd" Padding="11,5" Content="AMD" Cursor="Hand" FontSize="10.5" />
                                                                        </Border>

                                                                        <Border Classes="ChipGroup" IsEnabled="{Binding IsEmulatorAllowed}">
                                                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsEmulatorMode}" Click="OnToggleExtraModeClicked"
                                                                                    Tag="emulator" Padding="11,5" Content="EMU" Cursor="Hand" FontSize="10.5" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <TextBlock Text="{Binding ConflictText}" IsVisible="{Binding HasConflict}"
                                                                               FontSize="10.5" Foreground="#D6C08A" TextWrapping="Wrap" LineHeight="15" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding PayloadStatusText}" IsVisible="{Binding HasPayloadStatus}"
                                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#86EFAC" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3d: Features. Three toggles that used to be three
                                     whole cards - same switches, a third of the height, and
                                     they now read as a list of what the app can do. Each row
                                     keeps its own search property so a query still hides the
                                     rows it does not match. -->
                                <Border Classes="SettingsCard Stagger4" Classes.Shown="{Binding IsSettingsOpen}"
                                        IsVisible="{Binding ShowFeaturesCard}"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Loc.FeaturesSection}" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="0.5" />

                                        <!-- Dynamic Overlay -->
                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14"
                                                Padding="14,11" IsVisible="{Binding ShowOverlayCard}">
                                            <StackPanel Spacing="11">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="#1A00FF88"
                                                            BorderBrush="#3300FF88" BorderThickness="1" VerticalAlignment="Center">
                                                        <PathIcon Data="M 3,5 H 21 V 19 H 3 Z M 5,7 V 17 H 19 V 7 Z M 6.5,8.5 H 12 V 11 H 6.5 Z"
                                                                  Width="14" Height="14" Foreground="#00FF88" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Loc.OverlayTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- The look only. On or off is chosen per game, in its Manage
                                                     sheet; the key that opens it is set there too, in the CHANGE
                                                     KEY card, beside the game it is written into. -->
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc.OverlayStyle}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" Classes="GlassComboBox"
                                                              ItemsSource="{Binding Loc.OverlayThemeNames}"
                                                              SelectedIndex="{Binding SelectedOverlayThemeIndex, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" Height="34" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- AMD RDNA 4 -->
                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14"
                                                Padding="14,11" IsVisible="{Binding ShowAmdCard}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="#1AF59E0B"
                                                        BorderBrush="#33F59E0B" BorderThickness="1" VerticalAlignment="Center">
                                                    <PathIcon Data="M 4,4 H 20 V 20 H 4 Z M 6,6 V 18 H 18 V 6 Z M 8,8 H 16 V 10 H 8 Z M 8,12 H 13 V 14 H 8 Z"
                                                              Width="14" Height="14" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Loc.AmdTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                        <Border Background="#26F59E0B" BorderBrush="#55F59E0B" BorderThickness="1" CornerRadius="6"
                                                                Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Loc.Beta}" FontSize="8.5" FontWeight="Bold" Foreground="#FCD34D" LetterSpacing="0.6" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsAmdModeEnabled, Mode=TwoWay}"
                                                              OnContent="" OffContent="" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Performance mode -->
                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14"
                                                Padding="14,11" IsVisible="{Binding ShowPerformanceCard}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="#1A60A5FA"
                                                        BorderBrush="#3360A5FA" BorderThickness="1" VerticalAlignment="Center">
                                                    <PathIcon Data="M 13,2 L 4,14 H 11 L 10,22 L 20,9 H 13 Z"
                                                              Width="14" Height="14" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Loc.PerformanceMode}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                </StackPanel>

                                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsPerformanceMode, Mode=TwoWay}"
                                                              OnContent="" OffContent="" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 1: Interface & Navigation -->
                                <Border Classes="SettingsCard Stagger1" Classes.Shown="{Binding IsSettingsOpen}" IsVisible="{Binding ShowInterfaceCard}"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <StackPanel Spacing="14">
                                        <Button Classes="SectionHeader" Click="OnToggleSectionClicked" Tag="interface" Cursor="Hand">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="SectionTitle" Text="{Binding Loc.InterfaceNavigation}" />
                                                <Border Grid.Column="1" Classes="SectionChevron">
                                                    <PathIcon Data="{Binding InterfaceChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <StackPanel Spacing="14" IsVisible="{Binding IsInterfaceSectionOpen}">

                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding Loc.NavbarPosition}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />

                                            <Border Grid.Column="1" CornerRadius="14" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsTopBarLayout}" Click="OnSetTopBarLayout" Padding="16,7" Content="{Binding Loc.TopBar}" />
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsSidebarLayout}" Click="OnSetSidebarLayout" Padding="16,7" Content="{Binding Loc.SideBar}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#12FFFFFF" HorizontalAlignment="Stretch" />

                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="Language" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Classes="GlassComboBox"
                                                      ItemsSource="{Binding Languages}"
                                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                                      Width="200" Height="36" VerticalAlignment="Center" />
                                        </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Visual Atmosphere -->
                                <Border Classes="SettingsCard Stagger2" Classes.Shown="{Binding IsSettingsOpen}" IsVisible="{Binding ShowAtmosphereCard}"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <StackPanel Spacing="14">
                                        <Button Classes="SectionHeader" Click="OnToggleSectionClicked" Tag="atmosphere" Cursor="Hand">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="SectionTitle" Text="{Binding Loc.VisualAtmosphere}" />
                                                <Border Grid.Column="1" Classes="SectionChevron">
                                                    <PathIcon Data="{Binding AtmosphereChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <StackPanel Spacing="14" IsVisible="{Binding IsAtmosphereSectionOpen}">

                                        <!-- The atmosphere is its picture now: one tile each, then
                                             the user's own picture. The accent colour still follows
                                             the atmosphere even while a custom picture is showing. -->
                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,12">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="{Binding Loc.ColorAtmosphere}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />

                                                <ItemsControl ItemsSource="{Binding BackgroundTiles}" Margin="0,0,-10,-10">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="5" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:AtmosphereOption">
                                                            <Button Classes="BgTile" Classes.Selected="{Binding IsSelected}"
                                                                    Click="OnBackgroundTileClicked" Cursor="Hand"
                                                                    Margin="0,0,10,10" ToolTip.Tip="{Binding Display}">
                                                                <StackPanel Spacing="7">
                                                                    <!-- A matted frame: a thin ring, a small gap, then the
                                                                         picture in its own rounded clip - so the ring never
                                                                         cuts across the picture's corners. -->
                                                                    <Border Classes="BgTileFrame">
                                                                        <Border Classes="BgTileImage">
                                                                            <Panel>
                                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                                       IsVisible="{Binding HasThumbnail}"
                                                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />

                                                                                <!-- The custom tile before a picture has been picked -->
                                                                                <Border IsVisible="{Binding !HasThumbnail}" Width="32" Height="32" CornerRadius="16"
                                                                                        Background="#1A35D22B" BorderBrush="#4435D22B" BorderThickness="1"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <PathIcon Data="M 19,13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z"
                                                                                              Width="12" Height="12" Foreground="#86EFAC"
                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>

                                                                                <!-- The custom tile's own way to take its picture back out -->
                                                                                <Button Classes="BgTileRemove" IsVisible="{Binding CanRemove}"
                                                                                        Click="OnRemoveCustomBackgroundClicked" Cursor="Hand"
                                                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0">
                                                                                    <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                                                                              Width="8" Height="8" Foreground="#F1F5F9"
                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Button>

                                                                                <Border IsVisible="{Binding IsSelected}" Width="20" Height="20" CornerRadius="10"
                                                                                        Background="#35D22B" BorderBrush="#0B1210" BorderThickness="2"
                                                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                                                                    <PathIcon Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 Z"
                                                                                              Width="9" Height="9" Foreground="#06170A"
                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </Panel>
                                                                        </Border>
                                                                    </Border>
                                                                    <TextBlock Classes="BgTileLabel" Text="{Binding Display}" FontSize="11" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- How much of the picture comes through the black layer over it -->
                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <TextBlock Grid.Column="0" Text="{Binding Loc.BackgroundBrightness}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="15" Maximum="100"
                                                        SmallChange="1" LargeChange="10"
                                                        Value="{Binding BackgroundBrightness, Mode=TwoWay}"
                                                        VerticalAlignment="Center" MinWidth="140" />
                                                <Border Grid.Column="2" Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                        CornerRadius="8" Padding="9,3" MinWidth="48" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BackgroundBrightnessText}" FontSize="11" FontWeight="Bold"
                                                               Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Library & Cache -->
                                <Border Classes="SettingsCard Stagger3" Classes.Shown="{Binding IsSettingsOpen}" IsVisible="{Binding ShowLibraryCard}"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <StackPanel Spacing="14">
                                        <Button Classes="SectionHeader" Click="OnToggleSectionClicked" Tag="library" Cursor="Hand">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <!-- A product name, so it reads the same in every language
                                                     rather than being translated section by section. -->
                                                <TextBlock Grid.Column="0" Classes="SectionTitle" Text="DYNAMIC LIBRARY" />
                                                <Border Grid.Column="1" Classes="SectionChevron">
                                                    <PathIcon Data="{Binding LibraryChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <StackPanel Spacing="14" IsVisible="{Binding IsLibrarySectionOpen}">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <TextBlock Text="{Binding Loc.FastCacheGameIndex}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                                        <TextBlock Text="{Binding TotalGamesText}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" />
                                                    </Border>
                                                    <Border Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="STATUS:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                            <TextBlock Text="{Binding ScanStatusText}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="EmptyActionBtn" Click="OnRescanClicked" Cursor="Hand" Padding="14,8">
                                                    <TextBlock Text="{Binding Loc.RescanLibrary}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Button>
                                                <Button Classes="EmptyActionBtn" Click="OnClearCacheClicked" Cursor="Hand" Padding="14,8">
                                                    <TextBlock Text="{Binding Loc.ClearCache}" FontSize="11.5" FontWeight="Bold" Foreground="#EF4444" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3c: Support & Tutorials -->
                                <Border Classes="SettingsCard Stagger5" Classes.Shown="{Binding IsSettingsOpen}"
                                        IsVisible="{Binding ShowSupportCard}"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="{Binding Loc.SectionSupportTutorials}" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="0.5" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc.SupportTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                <TextBlock Text="{Binding Loc.SupportTagline}" FontSize="11" Foreground="#7C8595" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                <Button Classes="GlassLinkBtn Tutorials" Click="OnTutorialsClicked" Cursor="Hand"
                                                        ToolTip.Tip="youtube.com/@Nodix-Tech">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon Data="M 21.58,7.19 C 21.35,6.33 20.67,5.65 19.81,5.42 18.25,5 12,5 12,5 12,5 5.75,5 4.19,5.42 3.33,5.65 2.65,6.33 2.42,7.19 2,8.75 2,12 2,12 2,12 2,15.25 2.42,16.81 2.65,17.67 3.33,18.35 4.19,18.58 5.75,19 12,19 12,19 12,19 18.25,19 19.81,18.58 20.67,18.35 21.35,17.67 21.58,16.81 22,15.25 22,12 22,12 22,12 22,8.75 21.58,7.19 Z M 10,15 V 9 L 15,12 Z"
                                                                  Width="15" Height="15" Foreground="#FF6B6B" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Loc.BtnWatchTutorials}" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Classes="GlassLinkBtn Donate" Click="OnDonateClicked" Cursor="Hand"
                                                        ToolTip.Tip="ko-fi.com/nodix">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon Data="M 12,21.35 L 10.55,20.03 C 5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3 9.24,3 10.91,3.81 12,5.09 13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5 22,12.28 18.6,15.36 13.45,20.04 Z"
                                                                  Width="15" Height="15" Foreground="#FF8FB1" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Loc.BtnSupportKofi}" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: About & Updates -->
                                <Border Classes="SettingsCard Stagger6" Classes.Shown="{Binding IsSettingsOpen}"
                                        IsVisible="{Binding ShowAboutCard}"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                                            <Image Grid.Column="0" Source="/Assets/logo_card.png" Width="228" VerticalAlignment="Center"
                                                   Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Loc.AppTitle}" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    <Border Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,1.5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AppVersionText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding CreditsText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1"
                                                           TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left" />

                                                <TextBlock Text="{Binding UpdateStatusText}" IsVisible="{Binding HasUpdateStatus}"
                                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding UpdateStatusBrush}"
                                                           TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Classes="EmptyActionBtn" Click="OnCheckUpdatesClicked" Cursor="Hand"
                                                    IsEnabled="{Binding CanCheckUpdates}" Padding="16,9" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UpdateButtonText}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Button>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#12FFFFFF" HorizontalAlignment="Stretch" />

                                        <!-- The card this machine has: what the install routes read, -->
                                        <!-- and on an RTX 40 the build OptiScaler picks because of it. -->
                                        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center"
                                                    IsVisible="{Binding HasDetectedGpu}">
                                            <TextBlock Text="GRAPHICS CARD" FontSize="10" FontWeight="Bold" Foreground="#64748B"
                                                       LetterSpacing="0.6" VerticalAlignment="Center" />
                                            <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                                    CornerRadius="8" Padding="9,3">
                                                <TextBlock Text="{Binding DetectedGpuText}" FontSize="10.5" Foreground="#CBD5E1" />
                                            </Border>
                                            <Border Background="#1400FF88" BorderBrush="#4400FF88" BorderThickness="1"
                                                    CornerRadius="8" Padding="9,3" IsVisible="{Binding IsRtx40Gpu}"
                                                    ToolTip.Tip="OptiScaler installs its RTX 40/50 build on this machine">
                                                <TextBlock Text="RTX 40/50 BUILD" FontSize="10" FontWeight="Bold" Foreground="#7CFFC4" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding CopyrightText}" FontSize="10.5" FontWeight="Medium"
                                                   Foreground="#64748B" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Nothing on this page answers the search -->
                                <Border IsVisible="{Binding HasNoSettingsMatch}" Margin="0,30,0,0"
                                        Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="24"
                                        HorizontalAlignment="Center">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="No matching setting" FontSize="13.5" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                        <TextBlock Text="Clear the search box to see every setting again." FontSize="11.5" Foreground="#7C8595" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- 2. MAIN GAMES GRID VIEW -->
                        <Border Classes="PageReveal" Classes.Shown="{Binding IsGamesViewVisible}"
                                IsVisible="{Binding IsGamesViewVisible}" Padding="20,4,20,0" ClipToBounds="False">
                            <ScrollViewer x:Name="GamesScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,12,0,0"
                                          ClipToBounds="False"
                                          PointerWheelChanged="OnGamesWheelChanged">
                                <StackPanel Spacing="14">

                                    <!-- Dynamic Island Scanning HUD Capsule -->
                                    <Border CornerRadius="20"
                                            Padding="16,7"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8"
                                            IsVisible="{Binding IsScanning}"
                                            BorderThickness="1"
                                            BorderBrush="#35FFFFFF">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#30FFFFFF" Offset="0.0" />
                                                <GradientStop Color="#15FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#20FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ProgressBar IsIndeterminate="True" Width="60" Height="3.5" VerticalAlignment="Center" Foreground="{Binding MotifAccentBrush}" />
                                            <TextBlock Text="{Binding ScanStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- The six seconds before an automatic scan starts. A very
                                         large library can take minutes to walk, so it can be
                                         turned down - and that is remembered until the next
                                         update, restarts included. -->
                                    <Border IsVisible="{Binding IsAutoScanPending}" HorizontalAlignment="Center"
                                            Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                            CornerRadius="14" Padding="16,10" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AutoScanCountdownText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#E2E8F0" VerticalAlignment="Center" />
                                            <Button Classes="EmptyActionBtn" Click="OnDisableAutoScanClicked" Cursor="Hand" Padding="12,5"
                                                    ToolTip.Tip="It will not start by itself again - not after a restart either - until the next update. Scan any time from + → Detect Games Automatically.">
                                                <TextBlock Text="DON'T SCAN" FontSize="10.5" FontWeight="Bold" Foreground="#F1F5F9" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Games Cards Grid -->
                                    <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GameCardViewModel">
                                                <!-- Container for Card + External Title Below -->
                                                <StackPanel Classes="GameCardItem" Margin="10" Width="216" HorizontalAlignment="Center" Background="Transparent"
                                                            Classes.Still="{Binding $parent[Window].DataContext.IsPerformanceMode}"
                                                            Classes.Dragging="{Binding IsDragging}"
                                                            Classes.DragTarget="{Binding IsDragTarget}"
                                                            PointerPressed="OnCardPointerPressed"
                                                            PointerMoved="OnCardPointerMoved"
                                                            PointerReleased="OnCardPointerReleased"
                                                            PointerCaptureLost="OnCardPointerCaptureLost">
                                                    <!-- Right-click: take the title out of the library (nothing on disk is touched) -->
                                                    <StackPanel.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="Change cover image..." Click="OnChangeCoverClicked" />
                                                            <!-- Puts the scan's own artwork back. The pick is a file
                                                                 beside the cache, so removing it is all it takes. -->
                                                            <MenuItem Header="Restore the original cover" Click="OnRestoreCoverClicked" />
                                                            <MenuItem Header="Remove from library" Click="OnRemoveGameClicked" />
                                                            <MenuItem Header="Remove and add to exclusion list"
                                                                      Click="OnRemoveAndExcludeGameClicked" />
                                                        </MenuFlyout>
                                                    </StackPanel.ContextFlyout>
                                                    <StackPanel.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="0.16,1,0.3,1" />
                                                        </Transitions>
                                                    </StackPanel.Transitions>
                                                    <StackPanel.Styles>
                                                        <!-- Dragging Placeholder State -->
                                                        <Style Selector="StackPanel.GameCardItem.Dragging">
                                                            <Setter Property="Opacity" Value="0.2" />
                                                            <Setter Property="RenderTransform" Value="scale(0.92)" />
                                                        </Style>

                                                        <!-- Drag Target State: Magnetic Lift & Glass Halo -->
                                                        <Style Selector="StackPanel.GameCardItem.DragTarget">
                                                            <Setter Property="ZIndex" Value="500" />
                                                        </Style>
                                                        <Style Selector="StackPanel.GameCardItem.DragTarget Border.GameCardBezel">
                                                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                                                            <Setter Property="Background" Value="#1E2C24" />
                                                            <Setter Property="BoxShadow" Value="0 16 40 0 #90000000, 0 0 28 2 #60FFFFFF" />
                                                        </Style>

                                                        <!-- Title brightens on hover -->
                                                        <Style Selector="StackPanel.GameCardItem:pointerover TextBlock.CardTitle">
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Style>

                                                        <!-- Hover Action Overlay -->
                                                        <Style Selector="Border.HoverActionOverlay">
                                                            <Setter Property="Opacity" Value="0" />
                                                        </Style>
                                                        <Style Selector="StackPanel.GameCardItem:pointerover Border.HoverActionOverlay">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </Style>

                                                        <!-- Inner Artwork Expansion -->
                                                        <Style Selector="Border.InnerGameCard">
                                                            <Setter Property="Width" Value="198" />
                                                            <Setter Property="Height" Value="268" />
                                                        </Style>
                                                        <Style Selector="StackPanel.GameCardItem:pointerover Border.InnerGameCard">
                                                            <Setter Property="Width" Value="205" />
                                                            <Setter Property="Height" Value="275" />
                                                            <Setter Property="BorderBrush" Value="#55FFFFFF" />
                                                            <Setter Property="BoxShadow" Value="0 6 20 0 #70000000" />
                                                        </Style>
                                                        <Style Selector="StackPanel.GameCardItem:pointerdown Border.InnerGameCard">
                                                            <Setter Property="Width" Value="194" />
                                                            <Setter Property="Height" Value="264" />
                                                        </Style>
                                                        <Style Selector="StackPanel.GameCardItem:pointerover Border.GameCardBezel">
                                                            <Setter Property="Background" Value="#141C18" />
                                                            <Setter Property="BorderBrush" Value="#70FFFFFF" />
                                                            <Setter Property="BoxShadow" Value="0 10 30 0 #65000000, 0 0 20 1 #30FFFFFF" />
                                                        </Style>

                                                        <!-- Performance mode: hovering changes nothing, so the size
                                                             transitions above never have anything to animate. The
                                                             card still lights its border so it stays clear which
                                                             one is under the cursor. -->
                                                        <Style Selector="StackPanel.GameCardItem.Still:pointerover Border.InnerGameCard">
                                                            <Setter Property="Width" Value="198" />
                                                            <Setter Property="Height" Value="268" />
                                                            <Setter Property="BoxShadow" Value="none" />
                                                        </Style>
                                                        <Style Selector="StackPanel.GameCardItem.Still:pointerdown Border.InnerGameCard">
                                                            <Setter Property="Width" Value="198" />
                                                            <Setter Property="Height" Value="268" />
                                                        </Style>
                                                        <Style Selector="StackPanel.GameCardItem.Still:pointerover Border.GameCardBezel">
                                                            <Setter Property="BoxShadow" Value="0 6 24 0 #45000000" />
                                                        </Style>

                                                        <!-- Dragging captures the pointer on the card that started
                                                             it, so no other card ever sees :pointerover and the
                                                             artwork expansion above never fires while reordering.
                                                             The drop target grows here instead, by the same amounts,
                                                             so a card being dropped onto looks like a hovered one.
                                                             These MUST stay last in the collection: the resting
                                                             Border.InnerGameCard rule above would otherwise win,
                                                             which is exactly why the first attempt did nothing.
                                                             It grows further than hover does — the floating ghost
                                                             sits centred on the cursor, over the card being aimed
                                                             at, so a hover-sized 205 would be hidden underneath
                                                             it. 211 is the widest the 216 bezel can hold. -->
                                                        <Style Selector="StackPanel.GameCardItem.DragTarget Border.InnerGameCard">
                                                            <Setter Property="Width" Value="211" />
                                                            <Setter Property="Height" Value="281" />
                                                            <Setter Property="BorderBrush" Value="#AAFFFFFF" />
                                                            <Setter Property="BoxShadow" Value="0 8 26 0 #80000000" />
                                                        </Style>

                                                        <!-- Performance mode leaves the size alone here too. -->
                                                        <Style Selector="StackPanel.GameCardItem.Still.DragTarget Border.InnerGameCard">
                                                            <Setter Property="Width" Value="198" />
                                                            <Setter Property="Height" Value="268" />
                                                            <Setter Property="BoxShadow" Value="none" />
                                                        </Style>
                                                    </StackPanel.Styles>

                                                    <!-- Squircle Bezel Card (Floating Artwork Island) -->
                                                    <Border Classes="GameCardBezel" Width="216" Height="286" CornerRadius="24" ClipToBounds="True"
                                                            Background="#0D1210" BorderThickness="1.5" BorderBrush="#35FFFFFF"
                                                            BoxShadow="0 6 24 0 #45000000">
                                                        <Border.Transitions>
                                                            <Transitions>
                                                                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                            </Transitions>
                                                        </Border.Transitions>

                                                        <!-- Inner Island Container (Expands on hover) -->
                                                        <Border Classes="InnerGameCard" CornerRadius="18" ClipToBounds="True"
                                                                Background="#080C0A" BorderThickness="1" BorderBrush="#20FFFFFF"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                    <DoubleTransition Property="Height" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                </Transitions>
                                                            </Border.Transitions>
                                                            <Panel>
                                                                <!-- 1. Full HD Vertical Cover Poster -->
                                                                <Border CornerRadius="18" ClipToBounds="True" IsVisible="{Binding IsVerticalCover}">
                                                                    <Image Source="{Binding BannerImage}" Stretch="UniformToFill"
                                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                </Border>

                                                                <!-- 2. Centered App Icon Display -->
                                                                <Border CornerRadius="18" ClipToBounds="True" IsVisible="{Binding IsAppIcon}" Background="#0F1613">
                                                                    <Panel>
                                                                        <!-- An icon or a square picture fills the card the same way a
                                                                             cover does. A blown-up, blurred copy sits behind it so the
                                                                             edges never read as empty gutters. -->
                                                                        <Image Source="{Binding BannerImage}" Stretch="UniformToFill"
                                                                               Opacity="0.45"
                                                                               RenderOptions.BitmapInterpolationMode="HighQuality">
                                                                            <Image.RenderTransform>
                                                                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                                                                            </Image.RenderTransform>
                                                                        </Image>
                                                                        <Border Background="#66070B09" />
                                                                        <Image Source="{Binding BannerImage}" Stretch="UniformToFill"
                                                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                    </Panel>
                                                                </Border>

                                                                <!-- 3. Fallback: no artwork at all -->
                                                                <Border CornerRadius="18" ClipToBounds="True" IsVisible="{Binding !HasBannerImage}" Background="#121A16">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#94A3B8"
                                                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="160"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <!-- One quiet dot in the corner: the artwork stays the
                                                                     subject, and the route is a hover away. -->
                                                                <Border Classes="ModDot" IsVisible="{Binding HasModBadge}"
                                                                        ToolTip.Tip="{Binding ModBadgeText}" ZIndex="10">
                                                                            <Border />
                                                                        </Border>

                                                                <!-- 4. Hover Action Hint: Frosted Glass Pill -->
                                                                <Border Classes="HoverActionOverlay" CornerRadius="18" ClipToBounds="True" Background="#15000000" IsHitTestVisible="False">
                                                                    <Border.Transitions>
                                                                        <Transitions>
                                                                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                                                        </Transitions>
                                                                    </Border.Transitions>
                                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                                                            CornerRadius="13" ClipToBounds="True" BorderThickness="1"
                                                                            Padding="10,5" BoxShadow="0 4 16 0 #70000000">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                                <GradientStop Color="#85050C08" Offset="0.0" />
                                                                                <GradientStop Color="#A0050C08" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <Border.BorderBrush>
                                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                                <GradientStop Color="#63FFFFFF" Offset="0.0" />
                                                                                <GradientStop Color="#18FFFFFF" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.BorderBrush>

                                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding $parent[Window].DataContext.Loc.ClickManage}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                                            <Rectangle Width="1" Height="11" Fill="#30FFFFFF" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding $parent[Window].DataContext.Loc.DragMove}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Border>
                                                            </Panel>
                                                        </Border>
                                                    </Border>

                                                    <!-- Bottom Game Title: fixed-height 2-line box keeps every card
                                                         aligned; long names wrap then trim with an ellipsis, and the
                                                         full name is always available on hover. -->
                                                    <Border Width="214" Height="36" Background="Transparent" Margin="2,7,2,1">
                                                      <!-- Only visible over a bright picture (GlareBackingBrush) -->
                                                      <Border Background="{DynamicResource GlareBackingBrush}" CornerRadius="8" Padding="7,1"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Classes="CardTitle"
                                                                   Text="{Binding Title}"
                                                                   ToolTip.Tip="{Binding Title}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#E2E8F0"
                                                                   LineHeight="16"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                      </Border>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty State -->
                                    <Border IsVisible="{Binding !HasGames}" Margin="0,50,0,0" HorizontalAlignment="Center">
                                        <StackPanel Spacing="18" HorizontalAlignment="Center">
                                            <!-- Brand Wordmark Plate -->
                                            <Border CornerRadius="20" Padding="26,18" Background="#0EFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                    HorizontalAlignment="Center" BoxShadow="0 10 30 0 #45000000">
                                                <Image Source="/Assets/logo_hero.png" Width="320" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Border>

                                            <TextBlock Text="No games detected" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" />

                                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <Button Classes="EmptyActionBtn" Click="OnAddCustomFolderClicked" Cursor="Hand">
                                                    <TextBlock Text="Add Game Folder" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Classes="EmptyActionBtn" Click="OnAddSingleGameFileClicked" Cursor="Hand">
                                                    <TextBlock Text="Add Game (.exe)" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Classes="EmptyActionBtn" Click="OnRescanClicked" Cursor="Hand">
                                                    <TextBlock Text="Rescan Libraries" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bottom Spacer -->
                                    <Border Height="70" IsHitTestVisible="False" />

                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 3. EMULATORS VIEW - hand-curated, never scanned -->
                        <Border Classes="PageReveal" Classes.Shown="{Binding IsEmulatorsViewVisible}"
                                IsVisible="{Binding IsEmulatorsViewVisible}" Padding="20,4,20,0" ClipToBounds="False">
                            <ScrollViewer x:Name="EmulatorsScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,12,0,0"
                                          ClipToBounds="False"
                                          PointerWheelChanged="OnEmulatorsWheelChanged">
                                <StackPanel Spacing="14">

                                    <!-- Same inspection HUD as the games grid, so adding an
                                         emulator reports itself exactly the same way -->
                                    <Border CornerRadius="20"
                                            Padding="16,7"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8"
                                            IsVisible="{Binding IsScanning}"
                                            BorderThickness="1"
                                            BorderBrush="#35FFFFFF">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#30FFFFFF" Offset="0.0" />
                                                <GradientStop Color="#15FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#20FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ProgressBar IsIndeterminate="True" Width="60" Height="3.5" VerticalAlignment="Center" Foreground="{Binding MotifAccentBrush}" />
                                            <TextBlock Text="{Binding ScanStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Emulators}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GameCardViewModel">
                                                <StackPanel Classes="GameCardItem" Margin="10" Width="216" HorizontalAlignment="Center"
                                                            Background="Transparent"
                                                            PointerReleased="OnEmulatorCardPressed">
                                                    <StackPanel.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="Change cover image..." Click="OnChangeCoverClicked" />
                                                            <!-- Puts the scan's own artwork back. The pick is a file
                                                                 beside the cache, so removing it is all it takes. -->
                                                            <MenuItem Header="Restore the original cover" Click="OnRestoreCoverClicked" />
                                                            <MenuItem Header="Remove from library" Click="OnRemoveEmulatorClicked" />
                                                        </MenuFlyout>
                                                    </StackPanel.ContextFlyout>

                                                    <Border Classes="GameCardBezel" Width="216" Height="286" CornerRadius="24" ClipToBounds="True"
                                                            Background="#0D1210" BorderThickness="1.5" BorderBrush="#35FFFFFF"
                                                            BoxShadow="0 6 24 0 #45000000">
                                                        <Border.Transitions>
                                                            <Transitions>
                                                                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                            </Transitions>
                                                        </Border.Transitions>

                                                        <!-- Same inner island as a game card, so it lifts on hover -->
                                                        <Border Classes="InnerGameCard" CornerRadius="18" ClipToBounds="True"
                                                                Background="#080C0A" BorderThickness="1" BorderBrush="#20FFFFFF"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                    <DoubleTransition Property="Height" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                                                </Transitions>
                                                            </Border.Transitions>
                                                            <Panel>
                                                                <Image Source="{Binding BannerImage}" Stretch="UniformToFill"
                                                                       IsVisible="{Binding HasBannerImage}"
                                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />

                                                                <Border IsVisible="{Binding !HasBannerImage}" Background="#121A16">
                                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#64748B"
                                                                               TextAlignment="Center" TextWrapping="Wrap" Margin="18"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <!-- Same mark as a game card gets -->
                                                                <Border Classes="ModDot" IsVisible="{Binding HasModBadge}"
                                                                        ToolTip.Tip="{Binding ModBadgeText}" ZIndex="10">
                                                                            <Border />
                                                                        </Border>
                                                            </Panel>
                                                        </Border>
                                                    </Border>

                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                               MaxLines="2" Height="34" Margin="0,9,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state: the list starts empty by design -->
                                    <Border IsVisible="{Binding !HasEmulators}" Margin="0,60,0,0" HorizontalAlignment="Center">
                                        <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="440">
                                            <TextBlock Text="{Binding Loc.NoEmulatorsTitle}" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Loc.NoEmulatorsDesc}"
                                                       FontSize="12" Foreground="#7C8595" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" />
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                <Button Classes="EmptyActionBtn" Click="OnDetectEmulatorsClicked" Cursor="Hand"
                                                        IsEnabled="{Binding !IsScanning}"
                                                        ToolTip.Tip="Looks for the emulators the app knows, in the folders they are usually installed in">
                                                    <TextBlock Text="{Binding Loc.BtnDetectEmulators}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </Button>
                                                <Button Classes="EmptyActionBtn" Click="OnAddEmulatorClicked" Cursor="Hand">
                                                    <TextBlock Text="{Binding Loc.BtnAddEmulator}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Height="70" IsHitTestVisible="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 4. COMMUNITY VIEW - what other people got working.
                             Everything on this page comes from the Worker in
                             front of Cloudflare D1; nothing is fetched until
                             the tab is opened for the first time. -->
                        <Border Classes="PageReveal" Classes.Shown="{Binding IsCommunityViewVisible}"
                                IsVisible="{Binding IsCommunityViewVisible}" Padding="20,4,20,0" ClipToBounds="False">
                            <Grid RowDefinitions="Auto,Auto,*">

                                <!-- Header -->
                                <Border Grid.Row="0" Background="{DynamicResource GlareHeaderBrush}" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        CornerRadius="18" Padding="18,12" Margin="0,8,0,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc.CommunitySection}" FontSize="13.5" FontWeight="Bold"
                                                       Foreground="#FFFFFF" LetterSpacing="0.5" VerticalAlignment="Center" />

                                            <!-- The two halves of the section. PULSE gets a live dot so it
                                                 reads as the place where things are happening right now. -->
                                            <Border CornerRadius="12" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF"
                                                    BorderThickness="1" VerticalAlignment="Center" IsVisible="{Binding Community.IsNamed}">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsCommunityGamesOpen}"
                                                            Click="OnCommunityGamesTabClicked" Padding="14,5"
                                                            Content="{Binding Loc.CommunityTabGames}" />
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsPulseOpen}"
                                                            Click="OnPulseTabClicked" Padding="14,5" ToolTip.Tip="{Binding Loc.PulseTagline}">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Ellipse Width="7" Height="7" Fill="#00FF88" VerticalAlignment="Center">
                                                                <Ellipse.Styles>
                                                                    <Style Selector="Ellipse">
                                                                        <Style.Animations>
                                                                            <Animation Duration="0:0:1.6" IterationCount="Infinite">
                                                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                                                                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                                                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                                                            </Animation>
                                                                        </Style.Animations>
                                                                    </Style>
                                                                </Ellipse.Styles>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding Loc.PulseTitle}" FontWeight="Bold" LetterSpacing="0.8"
                                                                       VerticalAlignment="Center" />
                                                            <!-- Replies to your messages you have not looked at yet -->
                                                            <Border IsVisible="{Binding Pulse.HasUnreadReplies}" Background="#00FF88"
                                                                    CornerRadius="8" Padding="5,0" MinWidth="16" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Pulse.UnreadRepliesText}" FontSize="9.5" FontWeight="Bold"
                                                                           Foreground="#04130B" HorizontalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- The gallery. The amber count is the developer's queue,
                                                         so it is only ever drawn on their machine. -->
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsGalleryOpen}"
                                                            Click="OnGalleryTabClicked" Padding="14,5"
                                                            ToolTip.Tip="{Binding Loc.GalleryTagline}">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <PathIcon Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z"
                                                                      Width="11" Height="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Loc.GalleryTitle}" FontWeight="Bold" LetterSpacing="0.8"
                                                                       VerticalAlignment="Center" />
                                                            <Border IsVisible="{Binding Gallery.HasPending}" Background="#FCD34D"
                                                                    CornerRadius="8" Padding="5,0" MinWidth="16" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Gallery.PendingText}" FontSize="9.5" FontWeight="Bold"
                                                                           Foreground="#1A1206" HorizontalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- The private chat. What is written there is seen by the
                                                         person who wrote it and by the developer, and by nobody
                                                         else - which is what the padlock is saying. -->
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsDmOpen}"
                                                            Click="OnDmTabClicked" Padding="14,5"
                                                            ToolTip.Tip="A private line to the developer">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                                                      Width="11" Height="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="PRIVATE" FontWeight="Bold" LetterSpacing="0.8"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                    CornerRadius="9" Padding="10,4" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsCommunityGamesOpen}">
                                                <TextBlock Text="{Binding Community.TotalText}" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                            </Border>

                                            <!-- Who you post as. Tapping it lets you change it. -->
                                            <Border Background="#1A00FF88" BorderBrush="#3300FF88" BorderThickness="1"
                                                    CornerRadius="9" Padding="10,4" VerticalAlignment="Center"
                                                    IsVisible="{Binding Community.IsNamed}">
                                                <TextBlock Text="{Binding Community.DisplayName}" FontSize="10.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Classes="GlassLinkBtn Tutorials" Click="OnCommunityTutorialsClicked" Cursor="Hand"
                                                    ToolTip.Tip="dlss5manager.numidiastudios.com/tutorials">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="M 21.58,7.19 C 21.35,6.33 20.67,5.65 19.81,5.42 18.25,5 12,5 12,5 12,5 5.75,5 4.19,5.42 3.33,5.65 2.65,6.33 2.42,7.19 2,8.75 2,12 2,12 2,12 2,15.25 2.42,16.81 2.65,17.67 3.33,18.35 4.19,18.58 5.75,19 12,19 12,19 12,19 18.25,19 19.81,18.58 20.67,18.35 21.35,17.67 21.58,16.81 22,15.25 22,12 22,12 22,12 22,8.75 21.58,7.19 Z M 10,15 V 9 L 15,12 Z"
                                                              Width="15" Height="15" Foreground="#FF6B6B" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Loc.BtnCommunityGuides}" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Something is on the wire. Without this the section
                                                 just sits there and reads as frozen. -->
                                            <Border Classes="ManageBusyRing" IsVisible="{Binding Community.IsBusy}"
                                                    Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center"
                                                    Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                    IsHitTestVisible="False" ToolTip.Tip="Loading">
                                                <Ellipse Width="14" Height="14" StrokeThickness="2"
                                                         StrokeDashArray="2.6,1.6" StrokeLineCap="Round"
                                                         Stroke="{Binding MotifAccentBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         RenderTransformOrigin="50%,50%">
                                                    <Ellipse.Styles>
                                                        <Style Selector="Ellipse">
                                                            <Style.Animations>
                                                                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                                                                    <KeyFrame Cue="0%">
                                                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                                                    </KeyFrame>
                                                                    <KeyFrame Cue="100%">
                                                                        <Setter Property="RotateTransform.Angle" Value="360" />
                                                                    </KeyFrame>
                                                                </Animation>
                                                            </Style.Animations>
                                                        </Style>
                                                    </Ellipse.Styles>
                                                </Ellipse>
                                            </Border>

                                            <Button Classes="EmptyActionBtn" Click="OnCommunityRefreshClicked" Cursor="Hand" Padding="14,7"
                                                    IsEnabled="{Binding Community.IsIdle}">
                                                <TextBlock Text="{Binding Loc.BtnRefresh}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- The toolbar: route, result and order as three compact dropdowns,
                                     and a chip for whatever the search box is filtering by. It took
                                     the place of two rows of nine buttons that filled the width. -->
                                <!-- The filters sit on the picture: the plate behind them only shows
                                     while it is bright (GlareBackingBrush). Margin and padding add up
                                     to the old margin, so nothing moves over a dark picture. -->
                                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,-6,0,8" Padding="12,6"
                                        CornerRadius="16" Background="{DynamicResource GlareBackingBrush}">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Community.IsNamed" />
                                            <Binding Path="IsCommunityGamesOpen" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                <StackPanel Orientation="Horizontal" Spacing="14">

                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc.FilterRoute}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="#7C8595" VerticalAlignment="Center" />
                                        <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Loc.CommunityRouteOptions}"
                                                  SelectedIndex="{Binding Community.SelectedRouteIndex, Mode=TwoWay}"
                                                  Width="150" Height="34" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc.FilterResult}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="#7C8595" VerticalAlignment="Center" />
                                        <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Loc.CommunityResultOptions}"
                                                  SelectedIndex="{Binding Community.SelectedResultIndex, Mode=TwoWay}"
                                                  Width="140" Height="34" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc.FilterSort}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="#7C8595" VerticalAlignment="Center" />
                                        <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Loc.CommunitySortOptions}"
                                                  SelectedIndex="{Binding Community.SelectedSortIndex, Mode=TwoWay}"
                                                  Width="150" Height="34" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- The search, moved down out of the title bar. It belongs with
                                         the other filters because this is where it applies, and it
                                         is the same box bound to the same text - one IsVisible flip
                                         each way, nothing animated and nothing polled. -->
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Button Classes="SegmentedTab" x:Name="BtnSearchCommunity" Click="OnSearchClicked"
                                                ToolTip.Tip="{Binding Loc.SearchGames}" Padding="12,7" Cursor="Hand">
                                            <PathIcon Data="M 15.5,14 H 14.71 L 14.43,13.73 A 6.47,6.47 0 0 0 16,9.5 A 6.5,6.5 0 1 0 9.5,16 C 11.11,16 12.59,15.41 13.73,14.43 L 14,14.71 V 15.5 L 19,20.49 L 20.49,19 L 15.5,14 Z M 9.5,14 C 7.01,14 5,11.99 5,9.5 C 5,7.01 7.01,5 9.5,5 C 12,5 14,7.01 14,9.5 C 14,11.99 12,14 9.5,14 Z"
                                                      Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        </Button>

                                        <TextBox x:Name="SearchInputBoxCommunity"
                                                 Classes="GlassSearchBox"
                                                 Text="{Binding SearchText, Mode=TwoWay}"
                                                 IsHitTestVisible="{Binding IsSearchOpen}"
                                                 Focusable="{Binding IsSearchOpen}"
                                                 PlaceholderText="{Binding SearchPlaceholder}"
                                                 Width="{Binding SearchBoxWidth}"
                                                 Opacity="{Binding SearchBoxOpacity}"
                                                 Margin="{Binding SearchBoxMargin}"
                                                 Height="30"
                                                 VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- What the search box is filtering by, with its own way out -->
                                    <Border IsVisible="{Binding Community.HasQuery}" Background="#1A00FF88" BorderBrush="#3300FF88"
                                            BorderThickness="1" CornerRadius="10" Padding="11,4,5,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding Loc.SearchingFor}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Community.QueryText}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="#7CFFC4" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                            <Button Classes="RouteChip" Click="OnClearCommunitySearchClicked" Cursor="Hand" Padding="4">
                                                <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                                          Width="8" Height="8" Foreground="#7CFFC4" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Button Classes="EmptyActionBtn" Click="OnCommunityClearFiltersClicked" Cursor="Hand" Padding="12,6"
                                            IsVisible="{Binding Community.HasActiveFilters}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc.FilterClear}" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                    </Button>
                                </StackPanel>
                                </Border>

                                <!-- THE PRIVATE CHAT. Laid over the games half like the other two.
                                     The list of people on the left belongs to the developer alone -
                                     a player has exactly one thread and never has to choose. -->
                                <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto,*,Auto" ZIndex="5" Margin="0,0,0,14"
                                      IsVisible="{Binding IsDmOpen}">

                                    <Border Grid.Row="0" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1"
                                            CornerRadius="14" Padding="12,9" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="A PRIVATE LINE TO THE DEVELOPER" FontSize="10" FontWeight="Bold"
                                                           Foreground="#94A3B8" LetterSpacing="1" />
                                                <TextBlock Text="Only you and the developer can see what you write here."
                                                           FontSize="10.5" Foreground="#64748B" />
                                                <TextBlock Text="{Binding Dm.ActiveTitle}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="#E2E8F0" IsVisible="{Binding Dm.IsDevViewer}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnDmRefreshClicked" Cursor="Hand"
                                                    Padding="10,6" IsEnabled="{Binding Dm.IsIdle}">
                                                <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                          Width="12" Height="12" Foreground="#CBD5E1" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">

                                        <!-- Everyone who has written, most recent first. Developer only. -->
                                        <Border Width="230" Background="#0A0F0D" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                                CornerRadius="14" IsVisible="{Binding Dm.ShowThreadList}" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="Nobody has written yet." IsVisible="{Binding Dm.ThreadsEmpty}"
                                                           FontSize="11" Foreground="#64748B"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Dm.Threads}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Classes="ChatIcon" Click="OnDmThreadClicked" Cursor="Hand"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Padding="11,9" CornerRadius="0">
                                                                    <StackPanel Spacing="3">
                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <TextBlock Text="{Binding Person}" FontSize="11.5" FontWeight="Bold"
                                                                                           Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                                                                <Border IsVisible="{Binding HasRole}" Background="{Binding RoleTint}"
                                                                                        BorderBrush="{Binding RoleEdge}" BorderThickness="1"
                                                                                        CornerRadius="6" Padding="4,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding RoleText}" FontSize="8" FontWeight="Bold"
                                                                                               Foreground="{Binding RoleAccent}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <!-- Amber means it is his turn to answer. -->
                                                                            <Ellipse Grid.Column="1" Width="7" Height="7" Fill="#FCD34D"
                                                                                     VerticalAlignment="Center" IsVisible="{Binding NeedsReply}" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Last}" FontSize="10.5" Foreground="#94A3B8"
                                                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                                        <TextBlock Text="{Binding Ago}" FontSize="9.5" Foreground="#64748B" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Panel>
                                        </Border>

                                        <!-- The conversation itself, drawn like the public chat - on the
                                             same glass, which darkens over a bright picture. -->
                                        <Border Grid.Column="1" Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF"
                                                BorderThickness="1" CornerRadius="14" Padding="6" ClipToBounds="True">
                                        <Panel>
                                            <TextBlock Text="Nothing here yet." IsVisible="{Binding Dm.IsEmpty}"
                                                       FontSize="12" Foreground="#64748B"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Dm.Messages}" Margin="2,0,8,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Spacing="4" Margin="0,5">
                                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                                    <TextBlock Text="{Binding Author}" FontSize="10.5" FontWeight="Bold"
                                                                               Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                    <Border IsVisible="{Binding FromDev}" Background="#2200FF88"
                                                                            BorderBrush="#4400FF88" BorderThickness="1" CornerRadius="6"
                                                                            Padding="5,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="DEV" FontSize="8.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                                                    </Border>
                                                                    <Border IsVisible="{Binding HasRole}" Background="{Binding RoleTint}"
                                                                            BorderBrush="{Binding RoleEdge}" BorderThickness="1" CornerRadius="6"
                                                                            Padding="5,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding RoleText}" FontSize="8.5" FontWeight="Bold"
                                                                                   Foreground="{Binding RoleAccent}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Ago}" FontSize="10" Foreground="#64748B"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <Border HorizontalAlignment="Left" CornerRadius="12" Padding="11,7"
                                                                        Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                                                        IsVisible="{Binding HasBody}">
                                                                    <SelectableTextBlock Text="{Binding Body}" FontSize="12.5" Foreground="#E2E8F0"
                                                                                         TextWrapping="Wrap" MaxWidth="560" LineHeight="18" />
                                                                </Border>

                                                                <!-- A click opens it full size, as in the public chat. -->
                                                                <Button Classes="ChatIcon" Padding="0" CornerRadius="12" HorizontalAlignment="Left"
                                                                        IsVisible="{Binding HasImage}" Click="OnDmImageClicked" Cursor="Hand">
                                                                    <Border CornerRadius="12" ClipToBounds="True" Background="#0A0F0D"
                                                                            BorderBrush="#1CFFFFFF" BorderThickness="1" MaxWidth="360">
                                                                        <Panel>
                                                                            <Image Source="{Binding Image}" Stretch="Uniform"
                                                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                            <TextBlock Text="..." IsVisible="{Binding ImageLoading}" FontSize="14"
                                                                                       Foreground="#64748B" Margin="40"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Panel>
                                                                    </Border>
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Panel>
                                        </Border>
                                    </Grid>

                                    <!-- The composer, the same shape as the public chat's -->
                                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Dm.Status}" IsVisible="{Binding Dm.HasStatus}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#FCD34D" TextWrapping="Wrap" />

                                        <Panel IsVisible="{Binding Dm.HasPendingImage}" HorizontalAlignment="Left">
                                            <Border CornerRadius="14" ClipToBounds="True" BorderBrush="#3300FF88" BorderThickness="1"
                                                    Width="120" Height="80">
                                                <Image Source="{Binding Dm.PendingPreview}" Stretch="UniformToFill" />
                                            </Border>
                                            <Button Classes="ChatRound" Click="OnDmRemoveImageClicked" Width="24" Height="24"
                                                    CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
                                                <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                                          Width="9" Height="9" Foreground="#94A3B8" />
                                            </Button>
                                        </Panel>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Button Classes="EmptyActionBtn" Click="OnDmAttachClicked" Cursor="Hand" Padding="11,8"
                                                    IsEnabled="{Binding Dm.IsIdle}" ToolTip.Tip="{Binding Loc.BtnAttachImage}">
                                                <PathIcon Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z"
                                                          Width="14" Height="14" Foreground="#CBD5E1" />
                                            </Button>
                                            <!-- Enter sends, Shift+Enter starts a new line, Ctrl+V takes a
                                                 picture - the same box the public chat has. -->
                                            <TextBox x:Name="DmDraftBox" Grid.Column="1" Text="{Binding Dm.Draft, Mode=TwoWay}"
                                                     PlaceholderText="Write privately to the developer" MaxLength="500"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110"
                                                     FontSize="12.5" Background="#080B0E" Foreground="#E2E8F0"
                                                     BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="11,8" />
                                            <Button Grid.Column="2" Classes="ApplePrimaryBtn" Click="OnDmSendClicked" Cursor="Hand"
                                                    Padding="16,8" IsEnabled="{Binding Dm.CanSend}"
                                                    Content="{Binding Loc.BtnSend}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- GALLERY. Laid over the games half the same way the chat is, and
                                     hidden rather than rebuilt so switching tabs stays instant.
                                     Uploads are never public until the developer approves them, which
                                     is why the line under the toolbar says so in plain words. -->
                                <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*" ZIndex="5" Margin="0,0,0,14"
                                      IsVisible="{Binding IsGalleryOpen}">

                                    <Border Grid.Row="0" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1"
                                            CornerRadius="14" Padding="12,10" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                            <!-- WALL / QUEUE. Nobody but the developer has a queue to look at. -->
                                            <Border Grid.Column="0" CornerRadius="10" Padding="3" Background="#080B0E"
                                                    BorderBrush="#20FFFFFF" BorderThickness="1" VerticalAlignment="Center"
                                                    IsVisible="{Binding Gallery.IsDevViewer}">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding Gallery.IsWallOpen}"
                                                            Click="OnGalleryWallClicked" Padding="12,4"
                                                            Content="{Binding Loc.GalleryWall}" />
                                                    <Button Classes="SegmentedTab" Classes.Active="{Binding Gallery.IsQueueOpen}"
                                                            Click="OnGalleryQueueClicked" Padding="12,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Loc.GalleryQueue}" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <Border IsVisible="{Binding Gallery.HasPending}" Background="#FCD34D"
                                                                    CornerRadius="7" Padding="5,0" MinWidth="15" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Gallery.PendingText}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="#1A1206" HorizontalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <TextBox Grid.Column="1" Text="{Binding Gallery.Caption, Mode=TwoWay}"
                                                     PlaceholderText="{Binding Loc.GalleryCaption}" MaxLength="200"
                                                     FontSize="11.5" VerticalAlignment="Center"
                                                     Background="#080B0E" Foreground="#E2E8F0" BorderBrush="#20FFFFFF"
                                                     BorderThickness="1" CornerRadius="10" Padding="10,7" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="ApplePrimaryBtn" Click="OnGalleryUploadClicked" Cursor="Hand"
                                                        Padding="14,7" IsEnabled="{Binding Gallery.IsIdle}">
                                                    <TextBlock Text="{Binding Loc.GalleryUpload}" FontSize="10.5" FontWeight="Bold" />
                                                </Button>
                                                <Button Classes="EmptyActionBtn" Click="OnGalleryRefreshClicked" Cursor="Hand"
                                                        Padding="10,7" IsEnabled="{Binding Gallery.IsIdle}">
                                                    <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                              Width="12" Height="12" Foreground="#CBD5E1" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Spacing="4" Margin="2,0,0,10">
                                        <TextBlock Text="{Binding Loc.GalleryModeration}" FontSize="10.5" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Gallery.Status}" IsVisible="{Binding Gallery.HasStatus}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#FCD34D" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- The wall -->
                                    <Panel Grid.Row="2" IsVisible="{Binding Gallery.IsWallOpen}">
                                        <TextBlock Text="{Binding Loc.GalleryEmpty}" IsVisible="{Binding Gallery.IsEmpty}"
                                                   FontSize="12" Foreground="#64748B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Gallery.Items}" Margin="0,0,8,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="300" Margin="0,0,12,12" Background="#0C1014" BorderBrush="#20FFFFFF"
                                                                BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                            <StackPanel>
                                                                <!-- The picture is fetched when the card comes within reach of
                                                                     the visible part of the wall, not when the list arrives, so
                                                                     opening the tab does not download every picture at once.
                                                                     A click opens it full size, exactly as in the chat. -->
                                                                <Button Classes="ChatIcon" Padding="0" CornerRadius="0"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Click="OnGalleryImageClicked" Cursor="Hand">
                                                                    <Border Height="170" Background="#0A0F0D"
                                                                            EffectiveViewportChanged="OnGalleryImageViewportChanged">
                                                                        <Panel>
                                                                            <Image Source="{Binding Image}" Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                            <TextBlock Text="..." IsVisible="{Binding ImageLoading}" FontSize="14"
                                                                                       Foreground="#64748B" HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding $parent[Window].DataContext.Loc.PulseImageExpired}"
                                                                                       IsVisible="{Binding ImageFailed}" FontSize="10.5" Foreground="#64748B"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Panel>
                                                                    </Border>
                                                                </Button>
                                                                <StackPanel Margin="12,10" Spacing="7">
                                                                    <TextBlock Text="{Binding Caption}" IsVisible="{Binding HasCaption}"
                                                                               FontSize="11.5" Foreground="#E2E8F0" TextWrapping="Wrap"
                                                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                        <TextBlock Text="{Binding Author}" FontSize="10.5" FontWeight="Bold"
                                                                                   Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                        <Border IsVisible="{Binding HasRole}" Background="{Binding RoleTint}"
                                                                                BorderBrush="{Binding RoleEdge}" BorderThickness="1"
                                                                                CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding RoleText}" FontSize="8.5" FontWeight="Bold"
                                                                                       Foreground="{Binding RoleAccent}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Ago}" FontSize="10" Foreground="#64748B"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Panel>

                                    <!-- The queue: developer only, and the server enforces that again -->
                                    <Panel Grid.Row="2" IsVisible="{Binding Gallery.IsQueueOpen}">
                                        <TextBlock Text="{Binding Loc.GalleryQueueEmpty}" IsVisible="{Binding Gallery.QueueIsEmpty}"
                                                   FontSize="12" Foreground="#64748B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Gallery.Pending}" Margin="0,0,8,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="300" Margin="0,0,12,12" Background="#0C1014" BorderBrush="#33FCD34D"
                                                                BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                            <StackPanel>
                                                                <!-- Same rule in the queue: loaded on approach, opened on click.
                                                                     A picture should be looked at properly before it is judged. -->
                                                                <Button Classes="ChatIcon" Padding="0" CornerRadius="0"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Click="OnGalleryImageClicked" Cursor="Hand">
                                                                    <Border Height="170" Background="#0A0F0D"
                                                                            EffectiveViewportChanged="OnGalleryImageViewportChanged">
                                                                        <Panel>
                                                                            <Image Source="{Binding Image}" Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                            <TextBlock Text="..." IsVisible="{Binding ImageLoading}" FontSize="14"
                                                                                       Foreground="#64748B" HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding $parent[Window].DataContext.Loc.PulseImageExpired}"
                                                                                       IsVisible="{Binding ImageFailed}" FontSize="10.5" Foreground="#64748B"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Panel>
                                                                    </Border>
                                                                </Button>
                                                                <StackPanel Margin="12,10" Spacing="8">
                                                                    <TextBlock Text="{Binding Caption}" IsVisible="{Binding HasCaption}"
                                                                               FontSize="11.5" Foreground="#E2E8F0" TextWrapping="Wrap"
                                                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                        <TextBlock Text="{Binding Author}" FontSize="10.5" FontWeight="Bold"
                                                                                   Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Ago}" FontSize="10" Foreground="#64748B"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Button Classes="ApplePrimaryBtn" Click="OnGalleryApproveClicked"
                                                                                Cursor="Hand" Padding="14,6">
                                                                            <TextBlock Text="{Binding $parent[Window].DataContext.Loc.GalleryApprove}"
                                                                                       FontSize="10" FontWeight="Bold" />
                                                                        </Button>
                                                                        <Button Classes="EmptyActionBtn" Click="OnGalleryRejectClicked"
                                                                                Cursor="Hand" Padding="14,6">
                                                                            <TextBlock Text="{Binding $parent[Window].DataContext.Loc.GalleryReject}"
                                                                                       FontSize="10" FontWeight="Bold" Foreground="#F87171" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Panel>
                                </Grid>

                                <!-- CHAT (PULSE in the code). Laid over the games half of the section while
                                     it is open; the grid behind is hidden, not rebuilt, so switching back
                                     is instant. -->
                                <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="*,Auto" ZIndex="5" Margin="0,0,0,14"
                                      IsVisible="{Binding IsPulseOpen}">
                                    <Grid.Styles>
                                        <!-- The hover bar on a message: react, reply, delete -->
                                        <Style Selector="Grid.ChatRow Border.ChatActions">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                                </Transitions>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Grid.ChatRow:pointerover Border.ChatActions">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="IsHitTestVisible" Value="True" />
                                        </Style>
                                        <!-- Sent, not yet confirmed -->
                                        <Style Selector="Grid.ChatRow.Pending">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </Style>

                                        <!-- Small flat icon buttons -->
                                        <Style Selector="Button.ChatIcon">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="Padding" Value="5" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                        <Style Selector="Button.ChatIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="#1FFFFFFF" />
                                        </Style>
                                        <Style Selector="Button.ChatIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="#2EFFFFFF" />
                                        </Style>

                                        <!-- The composer's round buttons -->
                                        <Style Selector="Button.ChatRound">
                                            <Setter Property="Width" Value="38" />
                                            <Setter Property="Height" Value="38" />
                                            <Setter Property="CornerRadius" Value="19" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="#10FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                        <Style Selector="Button.ChatRound:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="#22FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                        </Style>
                                        <Style Selector="Button.ChatRound PathIcon">
                                            <Setter Property="Foreground" Value="#CBD5E1" />
                                        </Style>
                                        <Style Selector="Button.ChatSend">
                                            <Setter Property="Background" Value="#00E07A" />
                                            <Setter Property="BorderBrush" Value="#00FF88" />
                                        </Style>
                                        <Style Selector="Button.ChatSend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="#00FF88" />
                                            <Setter Property="BorderBrush" Value="#7CFFC4" />
                                        </Style>
                                        <Style Selector="Button.ChatSend:disabled /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="#12FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#12FFFFFF" />
                                        </Style>
                                        <Style Selector="Button.ChatSend PathIcon">
                                            <Setter Property="Foreground" Value="#04130B" />
                                        </Style>
                                        <Style Selector="Button.ChatSend:disabled PathIcon">
                                            <Setter Property="Foreground" Value="#475569" />
                                        </Style>

                                        <!-- The message box has no box of its own: the rounded composer is the box -->
                                        <Style Selector="TextBox.ChatInput">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="#F1F5F9" />
                                            <Setter Property="CaretBrush" Value="#00FF88" />
                                            <Setter Property="SelectionBrush" Value="#5500FF88" />
                                            <Setter Property="Padding" Value="4,9" />
                                            <Setter Property="MinHeight" Value="38" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="FontSize" Value="13" />
                                        </Style>
                                        <Style Selector="TextBox.ChatInput /template/ Border#PART_BorderElement">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                        <Style Selector="TextBox.ChatInput:pointerover /template/ Border#PART_BorderElement">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                        <Style Selector="TextBox.ChatInput:focus /template/ Border#PART_BorderElement">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                        <Style Selector="Border.ChatComposer:focus-within">
                                            <Setter Property="BorderBrush" Value="#5500FF88" />
                                        </Style>

                                        <!-- Reaction chips under a message -->
                                        <Style Selector="Button.ReactChip">
                                            <Setter Property="Padding" Value="7,2" />
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Background" Value="#10FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                        <Style Selector="Button.ReactChip.Mine">
                                            <Setter Property="Background" Value="#2200FF88" />
                                            <Setter Property="BorderBrush" Value="#6600FF88" />
                                        </Style>
                                        <Style Selector="Button.ReactChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="#22FFFFFF" />
                                        </Style>
                                    </Grid.Styles>

                                    <Border Grid.Row="0" Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1"
                                            CornerRadius="18" Padding="6">
                                        <Panel>
                                            <!-- No Padding on the ScrollViewer itself: it is not counted in the
                                                 scrollable height, which cut the last message off at the bottom.
                                                 The space lives on the content instead. -->
                                            <ScrollViewer x:Name="PulseScrollViewer" ScrollChanged="OnPulseScrolled"
                                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                          Padding="0">
                                                <StackPanel Spacing="2" Margin="12,8,12,16">
                                                    <TextBlock Text="{Binding Loc.PulseLoadingOlder}" IsVisible="{Binding Pulse.IsLoadingOlder}"
                                                               FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,8" />

                                                    <ItemsControl x:Name="PulseMessagesList" ItemsSource="{Binding Pulse.Messages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:PulseMessageViewModel">
                                                                <Grid Classes="ChatRow" Classes.Pending="{Binding IsPending}" Background="Transparent"
                                                                      ColumnDefinitions="Auto,*" ColumnSpacing="11" Margin="0,5">
                                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" VerticalAlignment="Top"
                                                                            Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                                                        <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold" Foreground="#94A3B8"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock Text="{Binding Author}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                                       VerticalAlignment="Center" />
                                                                            <Border Background="#1A00FF88" BorderBrush="#4400FF88" BorderThickness="1" CornerRadius="5"
                                                                                    Padding="5,0.5" VerticalAlignment="Center" IsVisible="{Binding IsVerified}"
                                                                                    ToolTip.Tip="Verified developer">
                                                                                <TextBlock Text="DEV" FontSize="8" FontWeight="Bold" Foreground="#7CFFC4" LetterSpacing="0.5" />
                                                                            </Border>

                                                                            <!-- And what they are, if anything. A player
                                                                                 gets no badge - it would say nothing. -->
                                                                            <Border Background="{Binding RoleTint}" BorderBrush="{Binding RoleEdge}" BorderThickness="1"
                                                                                    CornerRadius="5" Padding="5,0.5" VerticalAlignment="Center"
                                                                                    IsVisible="{Binding HasRole}">
                                                                                <TextBlock Text="{Binding RoleText}" FontSize="8" FontWeight="Bold"
                                                                                           Foreground="{Binding RoleAccent}" LetterSpacing="0.5" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Ago}" IsVisible="{Binding IsSent}" FontSize="10"
                                                                                       Foreground="#64748B" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding $parent[Window].DataContext.Loc.ChatSending}" IsVisible="{Binding IsPending}"
                                                                                       FontSize="10" Foreground="#7CFFC4" VerticalAlignment="Center" />
                                                                        </StackPanel>

                                                                        <!-- What this answers. Takes you there when it is loaded. -->
                                                                        <Button Classes="ChatIcon" Padding="0" CornerRadius="8" HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasReply}" Click="OnChatReplyQuoteClicked">
                                                                            <Border CornerRadius="8" Background="#0AFFFFFF" MaxWidth="560" ClipToBounds="True">
                                                                                <Grid ColumnDefinitions="3,*">
                                                                                    <Border Grid.Column="0" Background="#00FF88" />
                                                                                    <StackPanel Grid.Column="1" Margin="9,5,12,5" Spacing="1">
                                                                                        <TextBlock Text="{Binding ReplyAuthor}" FontSize="10.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                                                                        <TextBlock Text="{Binding ReplyBody}" FontSize="11" Foreground="#94A3B8"
                                                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Button>

                                                                        <!-- Plain, selectable text. Nothing in the chat is ever a
                                                                             clickable link - a URL can be copied, not followed. -->
                                                                        <Border HorizontalAlignment="Left" CornerRadius="12"
                                                                                Padding="11,7" Background="#1A00FF88" BorderBrush="#2A00FF88" BorderThickness="1">
                                                                            <Border.IsVisible>
                                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                                    <Binding Path="HasBody" />
                                                                                    <Binding Path="IsMine" />
                                                                                </MultiBinding>
                                                                            </Border.IsVisible>
                                                                            <SelectableTextBlock FontSize="12.5" Foreground="#F1F5F9"
                                                                                                 TextWrapping="Wrap" MaxWidth="560" LineHeight="18">
                                                                                <Run Text="{Binding BodyBefore}" /><Run Text="{Binding MentionText}" Foreground="#60A5FA" FontWeight="Bold" /><Run Text="{Binding BodyAfter}" /></SelectableTextBlock>
                                                                        </Border>
                                                                        <Border HorizontalAlignment="Left" CornerRadius="12" Padding="11,7"
                                                                                Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
                                                                            <Border.IsVisible>
                                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                                    <Binding Path="HasBody" />
                                                                                    <Binding Path="IsTheirs" />
                                                                                </MultiBinding>
                                                                            </Border.IsVisible>
                                                                            <SelectableTextBlock FontSize="12.5" Foreground="#E2E8F0"
                                                                                                 TextWrapping="Wrap" MaxWidth="560" LineHeight="18">
                                                                                <Run Text="{Binding BodyBefore}" /><Run Text="{Binding MentionText}" Foreground="#60A5FA" FontWeight="Bold" /><Run Text="{Binding BodyAfter}" /></SelectableTextBlock>
                                                                        </Border>

                                                                        <!-- The picture, in a box sized before it arrives so the
                                                                             conversation does not jump when it does. A click opens it
                                                                             full size, with Save. -->
                                                                        <Button Classes="ChatIcon" Padding="0" CornerRadius="12" HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasImage}" Click="OnChatImageClicked" Cursor="Hand">
                                                                            <Border CornerRadius="12" ClipToBounds="True" Background="#0A0F0D"
                                                                                    BorderBrush="#1CFFFFFF" BorderThickness="1"
                                                                                    Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                                                                    EffectiveViewportChanged="OnChatImageViewportChanged">
                                                                                <Panel>
                                                                                    <Image Source="{Binding Image}" Stretch="UniformToFill"
                                                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                    <TextBlock Text="..." IsVisible="{Binding ImageLoading}" FontSize="14"
                                                                                               Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding $parent[Window].DataContext.Loc.PulseImageExpired}"
                                                                                               IsVisible="{Binding ImageFailed}" FontSize="10.5" Foreground="#64748B"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Panel>
                                                                            </Border>
                                                                        </Button>

                                                                        <!-- Reactions. Yours are the green ones; a tap takes it back. -->
                                                                        <ItemsControl ItemsSource="{Binding Reactions}" IsVisible="{Binding HasReactions}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:ChatReactionViewModel">
                                                                                    <Button Classes="ReactChip" Classes.Mine="{Binding IsMine}"
                                                                                            Click="OnChatReactionClicked" Margin="0,0,5,2">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                            <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji}" FontSize="12" VerticalAlignment="Center" />
                                                                                            <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="Bold"
                                                                                                       Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>

                                                                    <!-- The hover bar: six reactions, reply, delete -->
                                                                    <Border Grid.Column="1" Classes="ChatActions" IsVisible="{Binding IsSent}"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                                                                            Background="#F2151B19" BorderBrush="#26FFFFFF" BorderThickness="1"
                                                                            CornerRadius="11" Padding="3">
                                                                        <StackPanel Orientation="Horizontal" Spacing="1">
                                                                            <ItemsControl ItemsSource="{Binding QuickReactions}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="1" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ChatReactionViewModel">
                                                                                        <Button Classes="ChatIcon" Click="OnChatReactionClicked" Padding="5,2">
                                                                                            <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji}" FontSize="14" />
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <Border Width="1" Background="#22FFFFFF" Margin="3,5" />
                                                                            <Button Classes="ChatIcon" Click="OnChatReplyClicked"
                                                                                    ToolTip.Tip="{Binding $parent[Window].DataContext.Loc.ChatReply}">
                                                                                <PathIcon Data="M10,9V5L3,12L10,19V14.9C15,14.9 18.5,16.5 21,20C20,15 17,10 10,9Z"
                                                                                          Width="14" Height="14" Foreground="#CBD5E1" />
                                                                            </Button>
                                                                            <Button Classes="ChatIcon" Click="OnChatEditClicked" IsVisible="{Binding CanEditNow}"
                                                                                    ToolTip.Tip="Edit what you wrote">
                                                                                <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                                                          Width="13" Height="13" Foreground="#CBD5E1" />
                                                                            </Button>
                                                                            <Button Classes="ChatIcon" Click="OnPulseDeleteClicked" IsVisible="{Binding CanDelete}"
                                                                                    ToolTip.Tip="{Binding $parent[Window].DataContext.Loc.BtnDelete}">
                                                                                <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                                                          Width="13" Height="13" Foreground="#F87171" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <TextBlock Text="{Binding Loc.PulseEmpty}" IsVisible="{Binding Pulse.IsEmpty}" FontSize="12"
                                                       Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Loc.CommunityLoading}" IsVisible="{Binding Pulse.IsFirstLoad}" FontSize="12"
                                                       Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Panel>
                                    </Border>

                                    <!-- The composer: one rounded bar, the same shape language as the rest
                                         of the app. Paste a picture with Ctrl+V, or pick one. -->
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="6">
                                        <Border Classes="ChatComposer" Background="#0E1512" BorderBrush="#24FFFFFF"
                                                BorderThickness="1" CornerRadius="24" Padding="7">
                                            <StackPanel Spacing="7">
                                                <!-- Replying to... -->
                                                <Border IsVisible="{Binding Pulse.IsReplying}" Background="#0CFFFFFF" CornerRadius="14"
                                                        Margin="4,0" ClipToBounds="True">
                                                    <Grid ColumnDefinitions="3,*,Auto">
                                                        <Border Grid.Column="0" Background="#00FF88" />
                                                        <StackPanel Grid.Column="1" Margin="10,6" Spacing="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="{Binding Loc.ChatReplyingTo}" FontSize="10.5" Foreground="#94A3B8" />
                                                                <TextBlock Text="{Binding Pulse.ReplyingToAuthor}" FontSize="10.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Pulse.ReplyingToSnippet}" FontSize="11" Foreground="#CBD5E1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="ChatIcon" Click="OnChatCancelReplyClicked"
                                                                Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                                                      Width="9" Height="9" Foreground="#94A3B8" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- Correcting a message already sent. It borrows the same box,
                                                     so the only new thing on screen is the line saying what Send
                                                     is about to do. -->
                                                <Border IsVisible="{Binding Pulse.IsEditing}" Background="#0CFFFFFF" CornerRadius="14"
                                                        Margin="4,0" ClipToBounds="True">
                                                    <Grid ColumnDefinitions="3,*,Auto">
                                                        <Border Grid.Column="0" Background="#FCD34D" />
                                                        <StackPanel Grid.Column="1" Margin="10,6" Spacing="1">
                                                            <TextBlock Text="Editing your message" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#FCD34D" />
                                                            <TextBlock Text="Send saves the change." FontSize="11" Foreground="#94A3B8"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="ChatIcon" Click="OnChatCancelEditClicked"
                                                                Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                                                      Width="9" Height="9" Foreground="#94A3B8" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- The picture about to be sent, already converted to WebP -->
                                                <Panel IsVisible="{Binding Pulse.HasPendingImage}" HorizontalAlignment="Left" Margin="6,4,0,0">
                                                    <Border CornerRadius="14" ClipToBounds="True" BorderBrush="#3300FF88" BorderThickness="1"
                                                            Width="120" Height="80">
                                                        <Image Source="{Binding Pulse.PendingPreview}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Button Classes="ChatRound" Click="OnPulseRemoveImageClicked" Width="24" Height="24" CornerRadius="12"
                                                            Background="#F0101412" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0">
                                                        <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                                                  Width="8" Height="8" />
                                                    </Button>
                                                </Panel>

                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <Button Grid.Column="0" Classes="ChatRound" Click="OnPulseAttachClicked" VerticalAlignment="Bottom"
                                                            IsEnabled="{Binding !Pulse.IsAttaching}" ToolTip.Tip="{Binding Loc.BtnAttachImage}">
                                                        <PathIcon Data="M21,19V5C21,3.9 20.1,3 19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z"
                                                                  Width="16" Height="16" />
                                                    </Button>

                                                    <Button Grid.Column="1" Classes="ChatRound" VerticalAlignment="Bottom" ToolTip.Tip="Emoji">
                                                        <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M15.5,8C16.33,8 17,8.67 17,9.5C17,10.33 16.33,11 15.5,11C14.67,11 14,10.33 14,9.5C14,8.67 14.67,8 15.5,8M8.5,8C9.33,8 10,8.67 10,9.5C10,10.33 9.33,11 8.5,11C7.67,11 7,10.33 7,9.5C7,8.67 7.67,8 8.5,8M12,17.5C9.67,17.5 7.69,16.04 6.89,14H17.11C16.3,16.04 14.33,17.5 12,17.5Z"
                                                                  Width="17" Height="17" />
                                                        <Button.Flyout>
                                                            <Flyout Placement="TopEdgeAlignedLeft">
                                                                <Border Width="344" Padding="2">
                                                                    <Border.Styles>
                                                                        <Style Selector="Button.EmojiKey">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                            <Setter Property="CornerRadius" Value="9" />
                                                                            <Setter Property="Width" Value="40" />
                                                                            <Setter Property="Height" Value="40" />
                                                                            <Setter Property="Padding" Value="0" />
                                                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                            <Setter Property="Cursor" Value="Hand" />
                                                                        </Style>
                                                                        <Style Selector="Button.EmojiKey:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                                            <Setter Property="Background" Value="#22FFFFFF" />
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <ItemsControl ItemsSource="{Binding Pulse.EmojiPalette}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ChatReactionViewModel">
                                                                                <Button Classes="EmojiKey" Click="OnChatEmojiClicked">
                                                                                    <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji}" FontSize="20" />
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>

                                                    <TextBox x:Name="PulseDraftBox" Grid.Column="2" Classes="ChatInput"
                                                             Text="{Binding Pulse.Draft, Mode=TwoWay}"
                                                             PlaceholderText="{Binding Loc.PulsePlaceholder}" KeyDown="OnPulseDraftKeyDown"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110" MaxLength="600"
                                                             VerticalAlignment="Center" />

                                                    <Panel Grid.Column="3" VerticalAlignment="Center" IsVisible="{Binding Pulse.ShowCharCount}">
                                                        <TextBlock Text="{Binding Pulse.CharCountText}" IsVisible="{Binding !Pulse.IsOverLimit}"
                                                                   FontSize="10" Foreground="#64748B" />
                                                        <TextBlock Text="{Binding Pulse.CharCountText}" IsVisible="{Binding Pulse.IsOverLimit}"
                                                                   FontSize="10" FontWeight="Bold" Foreground="#EF4444" />
                                                    </Panel>

                                                    <Button Grid.Column="4" Classes="ChatRound ChatSend" Click="OnPulseSendClicked"
                                                            IsEnabled="{Binding Pulse.CanSend}" VerticalAlignment="Bottom"
                                                            ToolTip.Tip="{Binding Loc.BtnSend}">
                                                        <PathIcon Data="M2,21L23,12L2,3V10L17,12L2,14V21Z" Width="15" Height="15" Margin="2,0,0,0" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                                            <TextBlock Grid.Column="0" Text="{Binding Loc.PulseRules}" FontSize="10" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Pulse.Status}" IsVisible="{Binding Pulse.HasStatus}"
                                                       FontSize="10.5" Foreground="#FCA5A5" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Panel Grid.Row="2">

                                    <!-- The gate. One field, no account: the name is how other
                                         people see you and it is all we ask for. -->
                                    <Border IsVisible="{Binding Community.IsAnonymous}"
                                            Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1"
                                            CornerRadius="20" Padding="30" MaxWidth="520"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="{Binding Loc.CommunityJoinTitle}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Loc.CommunityJoinHint}" FontSize="11.5" Foreground="#7C8595"
                                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="17" />

                                            <!-- The server caps a display name at 24 characters, but this
                                                 box also accepts the developer passphrase, which is longer.
                                                 Trimming here would cut that sentence in half. -->
                                            <TextBox Text="{Binding Community.NameDraft, Mode=TwoWay}"
                                                     PlaceholderText="{Binding Loc.CommunityNamePlaceholder}"
                                                     MaxLength="64" Height="38" FontSize="13" />

                                            <Button Classes="ApplePrimaryBtn" Click="OnCommunityClaimNameClicked" Cursor="Hand"
                                                    IsEnabled="{Binding Community.CanClaimName}"
                                                    HorizontalAlignment="Center" Padding="26,10">
                                                <TextBlock Text="{Binding Loc.BtnJoinCommunity}" FontSize="12" FontWeight="Bold" Foreground="#F5F5F7" />
                                            </Button>

                                            <TextBlock Text="{Binding Community.StatusMessage}" IsVisible="{Binding Community.HasStatusMessage}"
                                                       FontSize="11.5" Foreground="#FCA5A5" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- The grid -->
                                    <ScrollViewer x:Name="CommunityScrollViewer"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  ScrollChanged="OnCommunityScrolled"
                                                  ClipToBounds="False">
                                        <ScrollViewer.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="Community.IsNamed" />
                                                <Binding Path="IsCommunityGamesOpen" />
                                            </MultiBinding>
                                        </ScrollViewer.IsVisible>
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Community.StatusMessage}" IsVisible="{Binding Community.HasStatusMessage}"
                                                       FontSize="11.5" Foreground="#FCA5A5" TextWrapping="Wrap" HorizontalAlignment="Center" />

                                            <ItemsControl ItemsSource="{Binding Community.Games}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CommunityGameViewModel">
                                                        <Button Classes="CommunityCard" Click="OnCommunityGameClicked" Cursor="Hand"
                                                                Width="352" Margin="7" Padding="0" HorizontalContentAlignment="Stretch">
                                                            <Border Background="#0C1210" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                                    CornerRadius="16" Padding="12" ClipToBounds="True">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                                                    <!-- Cover, or the first letter when there is none -->
                                                                    <Border Grid.Column="0" Width="66" Height="94" CornerRadius="10"
                                                                            ClipToBounds="True" Background="#0A0F0D"
                                                                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                                                                        <Panel>
                                                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                                                   IsVisible="{Binding HasCover}"
                                                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                            <TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasCover}"
                                                                                       FontSize="26" FontWeight="Bold" Foreground="#33FFFFFF"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Panel>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                                        <Border Background="{Binding VerdictTint}" BorderBrush="{Binding VerdictEdge}"
                                                                                BorderThickness="1" CornerRadius="7" Padding="8,2"
                                                                                HorizontalAlignment="Left">
                                                                            <TextBlock Text="{Binding VerdictText}" FontSize="9" FontWeight="Bold"
                                                                                       Foreground="{Binding VerdictAccent}" LetterSpacing="0.6" />
                                                                        </Border>

                                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                                                                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />

                                                                        <!-- The tally: worked / mixed / did not -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding Working}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding Mixed}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                <Ellipse Width="7" Height="7" Fill="#EF4444" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding Broken}" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                                                            </StackPanel>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                                            <TextBlock Text="{Binding ReportsText}" FontSize="10.5" Foreground="#7C8595" />
                                                                            <TextBlock Text="·" FontSize="10.5" Foreground="#7C8595" />
                                                                            <TextBlock Text="{Binding CommentsText}" FontSize="10.5" Foreground="#7C8595" />
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="2" Width="28" Height="28" CornerRadius="14"
                                                                            Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                                            VerticalAlignment="Center">
                                                                        <PathIcon Data="M 9,6 L 15,12 L 9,18" Width="10" Height="10" Foreground="#CBD5E1"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- The next page is on its way. Sits under the grid so the
                                                 rows already on screen stay exactly where they are. -->
                                            <Border IsVisible="{Binding Community.IsLoadingMore}" Margin="0,4,0,0"
                                                    HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Ellipse Width="14" Height="14" StrokeThickness="2"
                                                             StrokeDashArray="2.6,1.6" StrokeLineCap="Round"
                                                             Stroke="{Binding MotifAccentBrush}"
                                                             VerticalAlignment="Center"
                                                             RenderTransformOrigin="50%,50%">
                                                        <Ellipse.Styles>
                                                            <Style Selector="Ellipse">
                                                                <Style.Animations>
                                                                    <Animation Duration="0:0:1.1" IterationCount="Infinite">
                                                                        <KeyFrame Cue="0%">
                                                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                                                        </KeyFrame>
                                                                        <KeyFrame Cue="100%">
                                                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                                                        </KeyFrame>
                                                                    </Animation>
                                                                </Style.Animations>
                                                            </Style>
                                                        </Ellipse.Styles>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Loc.CommunityLoadingMore}" FontSize="11"
                                                               Foreground="#7C8595" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Still fetching. An empty grid and a slow one look the
                                                 same otherwise, which is what read as a freeze. -->
                                            <Border IsVisible="{Binding Community.IsFirstLoad}" Margin="0,60,0,0"
                                                    HorizontalAlignment="Center">
                                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                            Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                            HorizontalAlignment="Center">
                                                        <Ellipse Width="19" Height="19" StrokeThickness="2.4"
                                                                 StrokeDashArray="2.6,1.6" StrokeLineCap="Round"
                                                                 Stroke="{Binding MotifAccentBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 RenderTransformOrigin="50%,50%">
                                                            <Ellipse.Styles>
                                                                <Style Selector="Ellipse">
                                                                    <Style.Animations>
                                                                        <Animation Duration="0:0:1.1" IterationCount="Infinite">
                                                                            <KeyFrame Cue="0%">
                                                                                <Setter Property="RotateTransform.Angle" Value="0" />
                                                                            </KeyFrame>
                                                                            <KeyFrame Cue="100%">
                                                                                <Setter Property="RotateTransform.Angle" Value="360" />
                                                                            </KeyFrame>
                                                                        </Animation>
                                                                    </Style.Animations>
                                                                </Style>
                                                            </Ellipse.Styles>
                                                        </Ellipse>
                                                    </Border>
                                                    <TextBlock Text="{Binding Loc.CommunityLoading}" FontSize="11.5"
                                                               Foreground="#7C8595" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Nobody has posted about anything matching this filter -->
                                            <Border IsVisible="{Binding Community.ShowNothingFound}" Margin="0,40,0,0"
                                                    Background="{DynamicResource GlareCardBrush}" BorderBrush="#18FFFFFF" BorderThickness="1"
                                                    CornerRadius="20" Padding="30" MaxWidth="480" HorizontalAlignment="Center">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc.CommunityEmptyTitle}" FontSize="14" FontWeight="Bold"
                                                               Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Loc.CommunityEmptyHint}" FontSize="11.5" Foreground="#7C8595"
                                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="17" />
                                                </StackPanel>
                                            </Border>

                                            <Border Height="70" IsHitTestVisible="False" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Panel>
                            </Grid>
                        </Border>
                    </Panel>

                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- MANAGE GAME SHEET                                            -->
            <!-- ============================================================ -->
            <Panel IsVisible="{Binding IsManageOpen}" ZIndex="9000">
                <!-- Dimming backdrop: click outside to dismiss -->
                <Border Background="#96000000" PointerPressed="OnManageBackdropPressed" />

                <!-- Back to one width. The only thing that ever needed more was
                     the result log, and that is folded away now. -->
                <!-- The margin keeps it off the frame once the window is resized
                     small; the middle band scrolls to make up the difference. -->
                <Border Classes="GlassModalCard" Width="560" Padding="26,22" MaxHeight="780" Margin="0,20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Three bands: the header, the part that scrolls, and the action
                         row. Only the middle one moves, so the title, SHARE RESULT and
                         the close button never scroll away - and the scrollbar track
                         lives inside that band, where it cannot reach the buttons. -->
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Header.
                             SHARE RESULT lives up here rather than in the action
                             row below: four buttons plus "Complete Installation"
                             do not fit inside a 560px sheet, and the last one was
                             pushed straight out through the frame. -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,18">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="{Binding ManageTitle}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" />

                                <!-- Re-reads this one game rather than the whole library.
                                     It spins while it works: the readout below flickers
                                     through "Checking..." either way, which was too easy
                                     to miss to count as an answer. -->
                                <Button Classes="GlassWindowControlBtn" Click="OnRescanGameClicked" Cursor="Hand"
                                        IsEnabled="{Binding IsManageReady}" VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding Loc.ManageRescanTip}">
                                    <Panel>
                                        <PathIcon Data="M 17.65,6.35 A 8,8 0 1 0 19.73,14 H 17.65 A 6,6 0 1 1 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 H 20 V 4 L 17.65,6.35 Z"
                                                  Width="12" Height="12" Foreground="#A1A1AA" VerticalAlignment="Center"
                                                  IsVisible="{Binding !IsAnalyzing}" />

                                        <Ellipse Width="12" Height="12" StrokeThickness="2"
                                                 StrokeDashArray="2.6,1.6" StrokeLineCap="Round"
                                                 Stroke="{Binding MotifAccentBrush}"
                                                 IsVisible="{Binding IsAnalyzing}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 RenderTransformOrigin="50%,50%">
                                            <Ellipse.Styles>
                                                <Style Selector="Ellipse">
                                                    <Style.Animations>
                                                        <Animation Duration="0:0:1.1" IterationCount="Infinite">
                                                            <KeyFrame Cue="0%">
                                                                <Setter Property="RotateTransform.Angle" Value="0" />
                                                            </KeyFrame>
                                                            <KeyFrame Cue="100%">
                                                                <Setter Property="RotateTransform.Angle" Value="360" />
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>
                                            </Ellipse.Styles>
                                        </Ellipse>
                                    </Panel>
                                </Button>

                                <!-- The game carries an anti-cheat (AntiCheat.detect): a glass
                                     mark like the rescan button, with an amber "!", and the advice
                                     on hover and on a click. Advice, never a block - the install
                                     still works. -->
                                <Button Classes="AntiCheatBadge" IsVisible="{Binding HasAntiCheat}" Cursor="Hand"
                                        VerticalAlignment="Center" ToolTip.Tip="{Binding AntiCheatText}">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <Border Background="#F70B1214" BorderBrush="#66F59E0B" BorderThickness="1"
                                                    CornerRadius="14" Padding="14,12" MaxWidth="320">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Loc.AntiCheatTitle}" FontSize="12.5" FontWeight="Bold" Foreground="#FCD34D" />
                                                    <TextBlock Text="{Binding AntiCheatText}" FontSize="12" Foreground="#E2E8F0"
                                                               TextWrapping="Wrap" LineHeight="17" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                    <TextBlock Text="!" FontSize="14" FontWeight="Black" Foreground="#FCD34D"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>

                            <!-- Stays on screen through an install. It is disabled while one
                                 runs (IsManageReady), but disappearing made the header jump. -->
                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnShareToCommunityClicked" Cursor="Hand"
                                    IsEnabled="{Binding IsManageReady}"
                                    Padding="13,6" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Loc.CommunityShare}" FontSize="10.5" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Button>

                            <!-- Also stays put. Disabled rather than hidden while the mod is
                                 being written: dismissing mid-install is still not allowed,
                                 but the control no longer vanishes from under the cursor. -->
                            <Button Grid.Column="2" Classes="GlassWindowControlBtn Close" Click="OnManageCloseClicked"
                                    IsEnabled="{Binding !IsInstalling}"
                                    VerticalAlignment="Top" ToolTip.Tip="{Binding Loc.Close}">
                                <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                          Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                            </Button>

                            <!-- While the mod is being written, the close control becomes a
                                 spinner: dismissing the sheet mid-install is not an option. -->
                            <Border Grid.Column="3" Classes="ManageBusyRing" IsVisible="{Binding IsInstalling}"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Width="26" Height="26" CornerRadius="13"
                                    Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    IsHitTestVisible="False" ToolTip.Tip="{Binding Loc.ManageInstallingTip}">
                                <Ellipse Width="14" Height="14" StrokeThickness="2"
                                         StrokeDashArray="2.6,1.6" StrokeLineCap="Round"
                                         Stroke="{Binding MotifAccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         RenderTransformOrigin="50%,50%">
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="RotateTransform.Angle" Value="360" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                            </Border>
                        </Grid>

                    <!-- The middle band. Inset from the scrollbar track, which is drawn
                         over the content rather than beside it. -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" Margin="0,0,14,0">

                        <!-- Detected target: reference information, folded away by default -->
                        <Border Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,13">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="{Binding Loc.GameExecutable}" FontSize="10" FontWeight="Bold" Foreground="#7C8595" LetterSpacing="0.8" />
                                        <TextBlock Text="{Binding ManageExePath}" FontSize="12" Foreground="#E2E8F0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Classes="GlassWindowControlBtn" Click="OnToggleTargetDetailsClicked"
                                            Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="{Binding Loc.ManageShowDetails}">
                                        <PathIcon Data="{Binding TargetDetailsToggleIcon}" Width="11" Height="11"
                                                  Foreground="#A1A1AA" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>

                                <!-- nvngx_dlssnr.dll is the file DLSS 5 cannot run without -->
                                <StackPanel Spacing="3" IsVisible="{Binding IsTargetDetailsOpen}">
                                    <TextBlock Text="{Binding Loc.ManageDlss5Status}" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595" LetterSpacing="0.8" />
                                    <TextBlock Text="{Binding ManageDlss5Text}" FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding ManageDlss5Brush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- What the community found with this game, under the file
                                     it is about. One request, made only when this is opened,
                                     and it needs no name: reading is open to everyone. -->
                                <Rectangle Height="1" Fill="#14FFFFFF" HorizontalAlignment="Stretch" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc.CommunitySection}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding Loc.CommunityGlanceHint}" />
                                    <Button Grid.Column="1" Classes="GlassWindowControlBtn" Click="OnToggleCommunityGlanceClicked"
                                            Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="{Binding Loc.CommunityGlanceHint}">
                                        <PathIcon Data="{Binding CommunityGlanceIcon}" Width="11" Height="11"
                                                  Foreground="#A1A1AA" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>

                                <StackPanel Spacing="9" IsVisible="{Binding IsCommunityGlanceOpen}">
                                    <TextBlock Text="{Binding Loc.ManageAskingCommunity}" FontSize="11.5" Foreground="#94A3B8"
                                               IsVisible="{Binding IsCommunityGlanceBusy}" />

                                    <StackPanel Spacing="9" IsVisible="{Binding HasCommunityGlance}">
                                        <TextBlock Text="{Binding CommunityGlanceTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding CommunityGlanceWorking}" FontSize="17" FontWeight="Bold" Foreground="#7CFFC4" />
                                                <TextBlock Text="{Binding Loc.CommunityGlanceWorked}" FontSize="10.5" Foreground="#7C8595" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding CommunityGlanceMixed}" FontSize="17" FontWeight="Bold" Foreground="#FCD34D" />
                                                <TextBlock Text="{Binding Loc.CommunityGlanceMixed}" FontSize="10.5" Foreground="#7C8595" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{Binding CommunityGlanceBroken}" FontSize="17" FontWeight="Bold" Foreground="#FF9C8A" />
                                                <TextBlock Text="{Binding Loc.CommunityGlanceFailed}" FontSize="10.5" Foreground="#7C8595" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="EmptyActionBtn" Click="OnOpenGlanceInCommunityClicked" Cursor="Hand" Padding="14,7">
                                                <TextBlock Text="{Binding Loc.CommunityGlanceOpen}" FontSize="11.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                            </Button>
                                            <!-- The answer is remembered for this game, so nothing is
                                                 asked twice; this is for when it has moved on since. -->
                                            <Button Classes="EmptyActionBtn" Click="OnRefreshGlanceClicked" Cursor="Hand" Padding="14,7"
                                                    IsEnabled="{Binding !IsCommunityGlanceBusy}"
                                                    ToolTip.Tip="{Binding Loc.CommunityGlanceRefreshHint}">
                                                <TextBlock Text="{Binding Loc.CommunityGlanceRefresh}" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding CommunityGlanceMessage}" IsVisible="{Binding HasCommunityGlanceMessage}"
                                               FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>

                                <Rectangle Height="1" Fill="#14FFFFFF" HorizontalAlignment="Stretch"
                                           IsVisible="{Binding IsTargetDetailsOpen}" />

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding IsTargetDetailsOpen}">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="RESHADE" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595" LetterSpacing="0.8" />
                                        <TextBlock Text="{Binding ManageReShadeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="DLSS" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595" LetterSpacing="0.8" />
                                        <TextBlock Text="{Binding ManageDlssText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="STREAMLINE" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595" LetterSpacing="0.8" />
                                        <TextBlock Text="{Binding ManageStreamlineText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Install route: OptiScaler is recommended; the ReShade routes are exclusive with it -->
                        <Border IsVisible="{Binding IsGameTarget}" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,13">
                            <StackPanel Spacing="10">
                                <!-- What the executable and its folder turned out to be -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc.InstallMode}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Border Classes="DetectChip">
                                            <TextBlock Text="{Binding DetectedApiText}" Classes="DetectChipText" />
                                        </Border>
                                        <Border Classes="DetectChip" IsVisible="{Binding HasDetectedArch}">
                                            <TextBlock Text="{Binding DetectedArchText}" Classes="DetectChipText" />
                                        </Border>
                                        <Border Classes="DetectChip" IsVisible="{Binding HasDlssUpscaling}"
                                                ToolTip.Tip="{Binding Loc.ManageShipsDlssTip}">
                                            <TextBlock Text="DLSS" Classes="DetectChipText" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="5">
                                        <Panel>
                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsOptiScalerMode}" Click="OnSetOptiScalerMode"
                                                    IsEnabled="{Binding IsManageReady}" Padding="8,7" Content="OptiScaler" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding Loc.RouteRecommendedTip}" />
                                            <Border Classes="ActiveRouteDot" IsVisible="{Binding IsOptiScalerInstalled}" />
                                        </Panel>
                                        <Panel>
                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx12Mode}" Click="OnSetDx12Mode"
                                                    IsEnabled="{Binding IsManageReady}" Padding="8,7" Content="DX12" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding Loc.RouteDx12Tip}" />
                                            <Border Classes="ActiveRouteDot" IsVisible="{Binding IsDx12Installed}" />
                                        </Panel>
                                        <Panel>
                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx11Mode}" Click="OnSetDx11Mode"
                                                    IsEnabled="{Binding IsManageReady}" Padding="8,7" Content="DX11 - 10" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding Loc.RouteDx11Tip}" />
                                            <Border Classes="ActiveRouteDot" IsVisible="{Binding IsDx11Installed}" />
                                        </Panel>
                                        <Panel>
                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsDx9Mode}" Click="OnSetDx9Mode"
                                                    IsEnabled="{Binding IsManageReady}" Padding="8,7" Content="DX9" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding Loc.RouteDx9Tip}" />
                                            <Border Classes="ActiveRouteDot" IsVisible="{Binding IsDx9Installed}" />
                                        </Panel>
                                        <Panel>
                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsVulkanMode}" Click="OnSetVulkanMode"
                                                    IsEnabled="{Binding IsManageReady}" Padding="8,7" Content="Vulkan" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding Loc.RouteVulkanTip}" />
                                            <Border Classes="ActiveRouteDot" IsVisible="{Binding IsVulkanInstalled}" />
                                        </Panel>
                                    </UniformGrid>
                                </Border>

                                <!-- Graphics API: OptiScaler only. DirectX 12 and Vulkan deploy
                                     the same files and only differ in which library OptiScaler
                                     hooks; neural upstream is a different build of it. -->
                                <Grid Classes="RouteReveal" Classes.Shown="{Binding IsOptiApiChoiceVisible}" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsOptiApiChoiceVisible}">
                                    <TextBlock Grid.Column="0" Text="API" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595"
                                               LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <!-- Two, not three. There is one OptiScaler build now, and
                                             the choice here only decides which DLL name it takes:
                                             dxgi.dll for DirectX 12, winmm.dll for Vulkan. -->
                                        <UniformGrid Columns="2">
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsOptiDx12}" Click="OnSetOptiDx12"
                                                        IsEnabled="{Binding IsManageReady}" Padding="6,6" FontSize="11.5"
                                                        Content="DirectX 12" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.OptiDx12Tip}" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsOptiDx12Installed}" />
                                            </Panel>
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsOptiVulkan}" Click="OnSetOptiVulkan"
                                                        IsEnabled="{Binding IsManageReady}" Padding="6,6" FontSize="11.5"
                                                        Content="Vulkan" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.OptiVulkanTip}" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsOptiVulkanInstalled}" />
                                            </Panel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <!-- Build: only DX11 and DX9 come in two -->
                                <Grid Classes="RouteReveal" Classes.Shown="{Binding IsArchChoiceVisible}" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsArchChoiceVisible}">
                                    <TextBlock Grid.Column="0" Text="BUILD" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595"
                                               LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <UniformGrid Columns="2">
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsBit64}" Click="OnSetBit64"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="64-bit" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsBit64Installed}" />
                                            </Panel>
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsBit32}" Click="OnSetBit32"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="32-bit" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.Arch32Tip}" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsBit32Installed}" />
                                            </Panel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding InstallModeHintText}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16" />
                            </StackPanel>
                        </Border>

                        <!-- AMD mode replaces the route picker entirely -->
                        <Border IsVisible="{Binding IsAmdRouteActive}"
                                Background="#12F59E0B" BorderBrush="#3AF59E0B" BorderThickness="1"
                                CornerRadius="14" Padding="14,11">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Background="#26F59E0B" BorderBrush="#55F59E0B" BorderThickness="1"
                                        CornerRadius="7" Padding="7,2" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding Loc.Beta}" FontSize="9.5" FontWeight="Bold" Foreground="#FCD34D" LetterSpacing="0.8" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Loc.AmdModeNotice}"
                                           FontSize="11" Foreground="#D6C08A" TextWrapping="Wrap" LineHeight="16"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Install options that ride along with a route, as three aligned rows.
                             Neural upstream travels with the DX12, DX11, DX9 and AMD installs;
                             the two RenoDX options exist only where RenoDX itself is installed
                             (the 64-bit DX12, DX11 and DX9 routes). What each does is on its ON
                             button's tooltip, so the card stays tidy. It sits outside the route
                             picker because AMD mode hides that card entirely. -->
                        <Border Classes="RouteReveal" Classes.Shown="{Binding IsNeuralAddonVisible}" IsVisible="{Binding IsNeuralAddonVisible}"
                                Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="16" Padding="16,12">
                            <StackPanel Spacing="9" Grid.IsSharedSizeScope="True">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InstallOptionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                Background="Transparent" ToolTip.Tip="{Binding Loc.TipNeural}">
                                        <TextBlock Text="NEURAL UPSTREAM" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center" />
                                        <Border Background="#26F59E0B" BorderBrush="#55F59E0B" BorderThickness="1"
                                                CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc.Beta}" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="#FCD34D" LetterSpacing="0.6" />
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <UniformGrid Columns="2">
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsNeuralAddonOff}" Click="OnSetNeuralAddonOff"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="OFF" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                            </Panel>
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsNeuralAddonOn}" Click="OnSetNeuralAddonOn"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="ON" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.TipNeural}" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsNeuralAddonInstalled}" />
                                            </Panel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <!-- MFG unlock also applies on the Vulkan route, which carries no
                                     RenoDX; Multipass and deep-fried below do not, since both only
                                     decide what happens to RenoDX itself. -->
                                <Border Height="1" Background="#12FFFFFF" IsVisible="{Binding IsMfgUnlockVisible}" />

                                <Grid ColumnSpacing="12" IsVisible="{Binding IsMfgUnlockVisible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InstallOptionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RENODX-MFGUNLOCK" FontSize="9.5" FontWeight="Bold" ToolTip.Tip="{Binding Loc.TipMfgUnlock}"
                                               Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <UniformGrid Columns="2">
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsMfgUnlockOff}" Click="OnSetMfgUnlockOff"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="OFF" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                            </Panel>
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsMfgUnlockOn}" Click="OnSetMfgUnlockOn"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="ON" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.TipMfgUnlock}" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsMfgUnlockInstalled}" />
                                            </Panel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="12" IsVisible="{Binding IsRenoDxOptionsVisible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InstallOptionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MULTIPASS" FontSize="9.5" FontWeight="Bold" ToolTip.Tip="{Binding Loc.TipMultipass}"
                                               Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <!-- Greyed out while deep-fried chicken is on: that payload
                                         replaces RenoDX, and this only picks a RenoDX build. -->
                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding IsMultipassAvailable}">
                                        <UniformGrid Columns="2">
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsMultipassOff}" Click="OnSetMultipassOff"
                                                        IsEnabled="{Binding IsMultipassAvailable}" Padding="8,6" Content="OFF" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                            </Panel>
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsMultipassOn}" Click="OnSetMultipassOn"
                                                        IsEnabled="{Binding IsMultipassAvailable}" Padding="8,6" Content="ON" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.TipMultipass}" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsMultipassInstalled}" />
                                            </Panel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="12" IsVisible="{Binding IsDeepFriedVisible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InstallOptionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DEEP-FRIED CHICKEN" FontSize="9.5" FontWeight="Bold" ToolTip.Tip="{Binding DeepFriedHint}"
                                               Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <UniformGrid Columns="2">
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsDeepFriedOff}" Click="OnSetDeepFriedOff"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="OFF" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                            </Panel>
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsDeepFriedOn}" Click="OnSetDeepFriedOn"
                                                        IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="ON" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding DeepFriedHint}" />
                                                <Border Classes="ActiveRouteDot" IsVisible="{Binding IsDeepFriedInstalled}" />
                                            </Panel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Emulators install one way, but ReShade can hook either of two
                             slots. This is its own card on purpose: the install-mode card
                             above is hidden for emulators (IsGameTarget), so a row nested
                             inside it could never appear on the one sheet it is meant for. -->
                        <Border IsVisible="{Binding IsEmulatorApiChoiceVisible}" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF"
                                BorderThickness="1" CornerRadius="16" Padding="16,13">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Text="API" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595"
                                               LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <UniformGrid Columns="2">
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsOptiDx12}" Click="OnSetOptiDx12"
                                                        IsEnabled="{Binding IsManageReady}" Padding="6,6" FontSize="11.5"
                                                        Content="DirectX" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.EmuDxTip}" />
                                            </Panel>
                                            <Panel>
                                                <Button Classes="SegmentedTab" Classes.Active="{Binding IsOptiVulkan}" Click="OnSetOptiVulkan"
                                                        IsEnabled="{Binding IsManageReady}" Padding="6,6" FontSize="11.5"
                                                        Content="Vulkan" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="{Binding Loc.EmuVulkanTip}" />
                                            </Panel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Loc.EmuApiHint}"
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" LineHeight="15" />
                            </StackPanel>
                        </Border>

                        <!-- The overlay, switchable per install. Hidden on the routes that
                             cannot host it - see ModInstaller.overlaySupported. Its add-on is
                             downloaded, not installed with the program (CloudAssets): until it
                             is here the switch is replaced by a lock and a way to get it. -->
                        <Border Classes="RouteReveal" Classes.Shown="{Binding IsOverlayRouteSupported}" IsVisible="{Binding IsOverlayRouteSupported}"
                                Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="16" Padding="16,13">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc.OverlaySection}" FontSize="9.5" FontWeight="Bold" ToolTip.Tip="{Binding Loc.TipOverlay}"
                                               Foreground="#7C8595" LetterSpacing="0.8" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014"
                                            BorderBrush="#20FFFFFF" BorderThickness="1" HorizontalAlignment="Stretch"
                                            IsVisible="{Binding IsOverlayDownloaded}">
                                        <UniformGrid Columns="2">
                                            <Button Classes="SegmentedTab" Classes.Active="{Binding !IsOverlayEnabled}" Click="OnSetOverlayOff"
                                                    IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="OFF" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                            <Button Classes="SegmentedTab" Classes.Active="{Binding IsOverlayEnabled}" Click="OnSetOverlayOn"
                                                    IsEnabled="{Binding IsManageReady}" Padding="8,6" Content="ON" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding Loc.TipOverlay}" />
                                        </UniformGrid>
                                    </Border>

                                    <!-- Locked: same footprint as the switch it stands in for -->
                                    <Border Grid.Column="1" CornerRadius="13" Padding="10,3,3,3" Background="#0C1014"
                                            BorderBrush="#33FCD34D" BorderThickness="1" HorizontalAlignment="Stretch"
                                            IsVisible="{Binding IsOverlayLocked}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <PathIcon Grid.Column="0" Data="M 12,17 A 2,2 0 0 0 14,15 A 2,2 0 0 0 12,13 A 2,2 0 0 0 10,15 A 2,2 0 0 0 12,17 Z M 18,8 A 2,2 0 0 1 20,10 V 20 A 2,2 0 0 1 18,22 H 6 A 2,2 0 0 1 4,20 V 10 A 2,2 0 0 1 6,8 H 7 V 6 A 5,5 0 0 1 12,1 A 5,5 0 0 1 17,6 V 8 H 18 Z M 12,3 A 3,3 0 0 0 9,6 V 8 H 15 V 6 A 3,3 0 0 0 12,3 Z"
                                                      Width="11" Height="11" Foreground="#FCD34D" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Loc.OverlayLocked}" FontSize="11" FontWeight="Bold"
                                                       Foreground="#FCD34D" LetterSpacing="0.6" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="AssetPrimaryBtn Small" Click="OnOpenAssetsClicked" Cursor="Hand"
                                                    Content="{Binding Loc.AssetDownload}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CHANGE KEY: every key this install writes, in one place and named for
                             what it opens. OptiScaler's menu on its own route; ReShade's and the
                             overlay's on the routes that put a ReShade in the game. A choice is
                             kept for every install and, on a game already installed, written in
                             at once; during an install it goes in only at the very end. -->
                        <Border Classes="RouteReveal" Classes.Shown="{Binding IsKeysCardVisible}" IsVisible="{Binding IsKeysCardVisible}"
                                Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="16" Padding="16,13">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="#1A00FF88"
                                            BorderBrush="#3300FF88" BorderThickness="1" VerticalAlignment="Center">
                                        <PathIcon Data="M 20,5 H 4 C 2.9,5 2,5.9 2,7 V 17 C 2,18.1 2.9,19 4,19 H 20 C 21.1,19 22,18.1 22,17 V 7 C 22,5.9 21.1,5 20,5 Z M 11,8 H 13 V 10 H 11 Z M 11,11 H 13 V 13 H 11 Z M 8,8 H 10 V 10 H 8 Z M 8,11 H 10 V 13 H 8 Z M 7,13 H 5 V 11 H 7 Z M 7,10 H 5 V 8 H 7 Z M 16,17 H 8 V 15 H 16 Z M 16,13 H 14 V 11 H 16 Z M 16,10 H 14 V 8 H 16 Z M 19,13 H 17 V 11 H 19 Z M 19,10 H 17 V 8 H 19 Z"
                                                  Width="14" Height="14" Foreground="#00FF88" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc.KeysSection}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="0.8" />
                                    </StackPanel>
                                </Grid>

                                <!-- OptiScaler's own menu: one line in its OptiScaler.ini ([Menu] ShortcutKey) -->
                                <Border Classes="KeyRow" IsVisible="{Binding IsOptiScalerMode}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Loc.KeyOptiMenu}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="KeyChip" IsEnabled="{Binding IsManageReady}" Cursor="Hand" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="KeyCap">
                                                    <TextBlock Text="{Binding SelectedOptiMenuKey}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="{Binding Loc.KeyChange}" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" LetterSpacing="0.6" VerticalAlignment="Center" />
                                                <PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" Width="9" Height="9" Foreground="#86EFAC" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="TopEdgeAlignedRight">
                                                    <Border Background="#F70B1214" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">
                                                        <StackPanel Spacing="10" Width="290">
                                                            <TextBlock Text="{Binding Loc.OptiMenuKeyTitle}" FontWeight="Bold" FontSize="13" Foreground="#E2E8F0" />
                                                            <ItemsControl ItemsSource="{Binding OptiMenuKeys}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Classes="SegmentedTab" Content="{Binding}" Tag="{Binding}" Click="OnChooseOptiMenuKey"
                                                                                Padding="12,6" Margin="0,0,6,6" Cursor="Hand" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding OptiKeyStatus}" IsVisible="{Binding HasOptiKeyStatus}" FontSize="10.5"
                                           Foreground="#7CFFC4" TextWrapping="Wrap" />

                                <!-- ReShade's own menu -->
                                <Border Classes="KeyRow" IsVisible="{Binding IsOverlayRouteSupported}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Loc.KeyReShade}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="KeyChip" IsEnabled="{Binding IsManageReady}" Cursor="Hand" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="KeyCap">
                                                    <TextBlock Text="{Binding SelectedReShadeKey}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="{Binding Loc.KeyChange}" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" LetterSpacing="0.6" VerticalAlignment="Center" />
                                                <PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" Width="9" Height="9" Foreground="#86EFAC" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="TopEdgeAlignedRight">
                                                    <Border Background="#F70B1214" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">
                                                        <StackPanel Spacing="10" Width="290">
                                                            <TextBlock Text="{Binding Loc.KeyOpenReShadeWith}" FontWeight="Bold" FontSize="13" Foreground="#E2E8F0" />
                                                            <ItemsControl ItemsSource="{Binding ReShadeKeys}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Classes="SegmentedTab" Content="{Binding}" Tag="{Binding}" Click="OnChooseReShadeKey"
                                                                                Padding="12,6" Margin="0,0,6,6" Cursor="Hand" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- The DLSS 5 overlay: only while there is one to open -->
                                <Border Classes="KeyRow" IsVisible="{Binding IsOverlayKeyVisible}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Loc.KeyOverlay}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="KeyChip" IsEnabled="{Binding IsManageReady}" Cursor="Hand" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="KeyCap">
                                                    <TextBlock Text="{Binding SelectedOverlayHotkey}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="{Binding Loc.KeyChange}" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" LetterSpacing="0.6" VerticalAlignment="Center" />
                                                <PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" Width="9" Height="9" Foreground="#86EFAC" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="TopEdgeAlignedRight">
                                                    <Border Background="#F70B1214" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">
                                                        <StackPanel Spacing="10" Width="290">
                                                            <TextBlock Text="{Binding Loc.KeyOpenOverlayWith}" FontWeight="Bold" FontSize="13" Foreground="#E2E8F0" />
                                                            <ItemsControl ItemsSource="{Binding OverlayHotkeys}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Classes="SegmentedTab" Content="{Binding}" Tag="{Binding}" Click="OnChooseOverlayKey"
                                                                                Padding="12,6" Margin="0,0,6,6" Cursor="Hand" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding KeysStatus}" IsVisible="{Binding HasKeysStatus}" FontSize="10.5"
                                           Foreground="#7CFFC4" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- DLL NAME: folded behind one button at the bottom. The install
                             still picks the proxy name itself; this only renames the
                             OptiScaler / ReShade file afterwards, when asked. -->
                        <Border x:Name="DllNameCard" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="12,9"
                                IsVisible="{Binding IsDllNameCardVisible}">
                            <Border.Styles>
                                <Style Selector="TextBox.DllNameInput">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="#F1F5F9" />
                                    <Setter Property="CaretBrush" Value="#00FF88" />
                                    <Setter Property="SelectionBrush" Value="#5500FF88" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="2,0" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style Selector="TextBox.DllNameInput /template/ Border#PART_BorderElement">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="TextBox.DllNameInput:pointerover /template/ Border#PART_BorderElement">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="TextBox.DllNameInput:focus /template/ Border#PART_BorderElement">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="Border.DllNameField:focus-within">
                                    <Setter Property="BorderBrush" Value="#7700FF88" />
                                </Style>
                            </Border.Styles>
                            <StackPanel Spacing="11">
                                <Button Classes="EmptyActionBtn" Click="OnToggleDllNamesClicked" Cursor="Hand"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,7">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <PathIcon Grid.Column="0" Data="M 6,2 H 14 L 20,8 V 22 H 6 Z M 14,2 V 8 H 20 M 9,13 H 17 M 9,17 H 15"
                                                  Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Loc.DllNameToggle}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center" />
                                        <PathIcon Grid.Column="2" Data="{Binding DllNamesIcon}" Width="11" Height="11"
                                                  Foreground="#A1A1AA" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <StackPanel Spacing="12" IsVisible="{Binding IsDllNamesOpen}" Margin="4,0,4,4">
                                    <TextBlock Text="{Binding Loc.DllNameDesc}" FontSize="11" Foreground="#94A3B8"
                                               TextWrapping="Wrap" LineHeight="16" />

                                    <!-- An emulator on Vulkan: ReShade is a layer, not a DLL. -->
                                    <TextBlock Text="{Binding Loc.DllNameVulkanLayer}" IsVisible="{Binding IsEmulatorVulkanLayer}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#FCD34D" TextWrapping="Wrap" LineHeight="16" />

                                    <!-- OptiScaler -->
                                    <StackPanel Spacing="8" IsVisible="{Binding HasOptiProxy}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="OPTISCALER" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595"
                                                       LetterSpacing="0.8" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Classes="DetectChip">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding Loc.DllNameCurrent}" Classes="DetectChipText" Opacity="0.7" />
                                                    <TextBlock Text="{Binding OptiProxyName}" Classes="DetectChipText" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" Classes="GlassComboBox" ItemsSource="{Binding OptiProxyNames}"
                                                      SelectedItem="{Binding SelectedOptiProxyName, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Height="34" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnRenameOptiPickClicked" Cursor="Hand"
                                                    IsEnabled="{Binding CanApplyDllName}" Padding="14,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc.DllNameApply}" FontSize="11" FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Loc.DllNameCustom}" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0" Classes="DllNameField" Background="#15000000" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                    CornerRadius="13" Height="34" Padding="10,0,4,0">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Grid.Column="0" Classes="DllNameInput"
                                                             Text="{Binding OptiCustomName, Mode=TwoWay}" MaxLength="60"
                                                             PlaceholderText="{Binding Loc.DllNamePlaceholder}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="#2200FF88" BorderBrush="#5500FF88" BorderThickness="1"
                                                            CornerRadius="9" Padding="10,3" VerticalAlignment="Center">
                                                        <TextBlock Text=".dll" FontSize="12.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnRenameOptiCustomClicked" Cursor="Hand"
                                                    IsEnabled="{Binding CanRenameOptiCustom}" Padding="14,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc.DllNameApply}" FontSize="11" FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Loc.DllNameTaken}" IsVisible="{Binding IsOptiCustomTaken}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#F87171" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Height="1" Background="#12FFFFFF">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="HasOptiProxy" />
                                                <Binding Path="HasReShadeProxy" />
                                            </MultiBinding>
                                        </Border.IsVisible>
                                    </Border>

                                    <!-- ReShade -->
                                    <StackPanel Spacing="8" IsVisible="{Binding HasReShadeProxy}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="RESHADE" FontSize="9.5" FontWeight="Bold" Foreground="#7C8595"
                                                       LetterSpacing="0.8" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Classes="DetectChip">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding Loc.DllNameCurrent}" Classes="DetectChipText" Opacity="0.7" />
                                                    <TextBlock Text="{Binding ReShadeProxyName}" Classes="DetectChipText" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" Classes="GlassComboBox" ItemsSource="{Binding ReShadeProxyNames}"
                                                      SelectedItem="{Binding SelectedReShadeProxyName, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Height="34" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnRenameReShadePickClicked" Cursor="Hand"
                                                    IsEnabled="{Binding CanApplyDllName}" Padding="14,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc.DllNameApply}" FontSize="11" FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Loc.DllNameCustom}" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0" Classes="DllNameField" Background="#15000000" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                    CornerRadius="13" Height="34" Padding="10,0,4,0">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Grid.Column="0" Classes="DllNameInput"
                                                             Text="{Binding ReShadeCustomName, Mode=TwoWay}" MaxLength="60"
                                                             PlaceholderText="{Binding Loc.DllNamePlaceholder}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="#2200FF88" BorderBrush="#5500FF88" BorderThickness="1"
                                                            CornerRadius="9" Padding="10,3" VerticalAlignment="Center">
                                                        <TextBlock Text=".dll" FontSize="12.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnRenameReShadeCustomClicked" Cursor="Hand"
                                                    IsEnabled="{Binding CanRenameReShadeCustom}" Padding="14,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc.DllNameApply}" FontSize="11" FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Loc.DllNameTaken}" IsVisible="{Binding IsReShadeCustomTaken}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#F87171" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding DllNameStatus}" IsVisible="{Binding HasDllNameStatus}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{Binding DllNameStatusBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live progress: proves the app is working, never frozen -->
                        <Border Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,13"
                                IsVisible="{Binding IsInstalling}">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding InstallStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding InstallProgress, StringFormat={}{0:F0}%}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Grid>
                                <ProgressBar Value="{Binding InstallProgress}" Minimum="0" Maximum="100" Height="5"
                                             Foreground="{Binding MotifAccentBrush}" Background="#20FFFFFF" CornerRadius="3" />
                            </StackPanel>
                        </Border>

                        <!-- Result banner: the headline, with the deployment log behind
                             a button. Unfolded, that log was the one thing in this sheet
                             long enough to stretch it off the screen. -->
                        <Border Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,12"
                                IsVisible="{Binding HasInstallResult}">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding InstallResultSummary}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{Binding InstallResultBrush}" TextWrapping="Wrap" LineHeight="18"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnToggleInstallResultClicked" Cursor="Hand"
                                            Padding="11,4" VerticalAlignment="Center"
                                            IsVisible="{Binding HasInstallResultDetails}">
                                        <TextBlock Text="{Binding InstallResultToggleText}" FontSize="10" FontWeight="Bold" Foreground="#CBD5E1" />
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding InstallResultText}" IsVisible="{Binding IsInstallResultExpanded}"
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="17" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </ScrollViewer>

                        <!-- Actions: pinned, so they stay reachable however long the
                             middle band grows. -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9" Margin="0,18,0,0">
                            <!-- The folder is an icon now: the words were the widest thing in
                                 this row and bought nothing the tooltip does not say. -->
                            <Button Grid.Column="0" Classes="AppleSecondaryBtn" Click="OnOpenGameFolderClicked" Cursor="Hand"
                                    IsEnabled="{Binding IsManageReady}" Padding="12,9"
                                    ToolTip.Tip="{Binding Loc.OpenGameFolder}">
                                <PathIcon Data="M 10,4 H 4 C 2.89,4 2,4.89 2,6 V 18 C 2,19.1 2.89,20 4,20 H 20 C 21.1,20 22,19.1 22,18 V 8 C 22,6.89 21.1,6 20,6 H 12 L 10,4 Z"
                                          Width="13" Height="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                            </Button>

                            <Button Grid.Column="1" Classes="AppleSecondaryBtn" Click="OnChangeExecutableClicked" Cursor="Hand"
                                    IsEnabled="{Binding IsManageReady}" Content="{Binding Loc.ChangeExe}" ToolTip.Tip="{Binding Loc.ChangeExeTip}" />

                            <!-- Launch: runs the executable this sheet is pointed at, so a
                                 change can be tried without leaving for Explorer. -->
                            <Button Grid.Column="2" Classes="AppleSecondaryBtn" Click="OnLaunchTargetClicked" Cursor="Hand"
                                    HorizontalAlignment="Left" Margin="9,0,0,0"
                                    IsEnabled="{Binding IsManageReady}" ToolTip.Tip="Run this game now">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M 8,5 V 19 L 19,12 Z" Width="11" Height="11" Foreground="#86EFAC" VerticalAlignment="Center" />
                                    <TextBlock Text="Launch" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Classes="ApplePrimaryBtn" Click="OnInstallDlssClicked" Cursor="Hand"
                                    IsVisible="{Binding ShowInstallButton}" IsEnabled="{Binding IsManageReady}"
                                    Content="{Binding Loc.BtnInstall}" />

                            <Button Grid.Column="3" Classes="ApplePrimaryBtn" Click="OnInstallDlssClicked" Cursor="Hand"
                                    IsVisible="{Binding ShowCompleteButton}" IsEnabled="{Binding IsManageReady}"
                                    Content="Complete Installation" ToolTip.Tip="DLSS 5 is present but some files are missing" />

                            <!-- The label grows with the options picked, and this column is
                                 Auto inside a fixed-width sheet - so past a certain length the
                                 button is squeezed below its content. A Button does not clip,
                                 which is how the text ended up painted outside its own frame.
                                 The content trims instead, and the button clips regardless. -->
                            <Button Grid.Column="3" Classes="ApplePrimaryBtn" Click="OnSwitchModeClicked" Cursor="Hand"
                                    IsVisible="{Binding ShowSwitchButton}" IsEnabled="{Binding IsManageReady}"
                                    ClipToBounds="True"
                                    ToolTip.Tip="Removes the route currently installed, then installs the selected one">
                                <TextBlock Text="{Binding SwitchButtonText}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" MaxWidth="210" />
                            </Button>

                            <Button Grid.Column="3" Classes="AppleDangerBtn" Click="OnUninstallDlssClicked" Cursor="Hand"
                                    IsVisible="{Binding ShowUninstallButton}" IsEnabled="{Binding IsManageReady}"
                                    Content="{Binding Loc.RemoveDlss}" />
                        </Grid>
                    </Grid>
                </Border>
            </Panel>

            <!-- ============================================================ -->
            <!-- DOWNLOADS SHEET                                              -->
            <!-- The parts of the payload fetched from our own storage        -->
            <!-- (CloudAssets). It opens by itself once; after that the       -->
            <!-- download button beside the tabs brings it back. Nothing in   -->
            <!-- it is needed to use the program.                             -->
            <!-- ============================================================ -->
            <Panel IsVisible="{Binding IsAssetsOpen}" ZIndex="9200">
                <!-- Dimming backdrop: click outside to put it away -->
                <Border Background="#96000000" PointerPressed="OnAssetsBackdropPressed" />

                <Border Classes="GlassModalCard" Width="600" MaxHeight="700" Margin="0,20" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- A soft wash of the program's green behind the header. It spans
                             every row so its height never decides the header's. -->
                        <Border Grid.RowSpan="3" Height="150" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="12%,0%" GradientOrigin="12%,0%" RadiusX="75%" RadiusY="110%">
                                    <GradientStop Color="#3335D22B" Offset="0.0" />
                                    <GradientStop Color="#0035D22B" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Header -->
                        <Panel Grid.Row="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="26,24,22,4">
                                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="15" BorderThickness="1"
                                        BorderBrush="#6035D22B" VerticalAlignment="Center" BoxShadow="0 8 24 0 #4035D22B">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#5535D22B" Offset="0.0" />
                                            <GradientStop Color="#1500FF88" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Panel>
                                        <PathIcon Data="M 12,3 A 1,1 0 0 1 13,4 V 13.59 L 16.29,10.29 A 1,1 0 0 1 17.71,11.71 L 12.71,16.71 A 1,1 0 0 1 11.29,16.71 L 6.29,11.71 A 1,1 0 0 1 7.71,10.29 L 11,13.59 V 4 A 1,1 0 0 1 12,3 Z M 5,19 H 19 A 1,1 0 0 1 19,21 H 5 A 1,1 0 0 1 5,19 Z"
                                                  Width="21" Height="21" Foreground="#DCFCE7"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsVisible="{Binding Assets.HasMissing}" />
                                        <PathIcon Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 Z"
                                                  Width="21" Height="21" Foreground="#DCFCE7"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsVisible="{Binding Assets.AllReady}" />
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Assets.HeadlineText}" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
                                </StackPanel>

                                <Button Grid.Column="2" Classes="GlassWindowControlBtn Close" Click="OnAssetsCloseClicked"
                                        VerticalAlignment="Top" ToolTip.Tip="{Binding Loc.Close}">
                                    <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                              Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Panel>

                        <!-- One card per bundle -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Assets.Items}" Margin="26,18,26,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SetupItemViewModel">
                                        <Border Classes="AssetCard" Classes.Ready="{Binding IsReady}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                <Border Grid.Column="0" Classes="AssetIcon" VerticalAlignment="Center">
                                                    <Panel>
                                                        <!-- the overlay: a panel over a game -->
                                                        <PathIcon IsVisible="{Binding IsOverlay}"
                                                                  Data="M 3,5 H 21 V 19 H 3 Z M 5,7 V 17 H 19 V 7 Z M 6.5,8.5 H 12 V 11 H 6.5 Z M 6.5,12.5 H 10 V 15 H 6.5 Z"
                                                                  Width="20" Height="20" Foreground="#86EFAC"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <!-- frame generation: frames multiplied -->
                                                        <PathIcon IsVisible="{Binding !IsOverlay}"
                                                                  Data="M 2,7 H 14 V 17 H 2 Z M 4,9 V 15 H 12 V 9 Z M 16,8 H 18 V 16 H 16 Z M 20,9.5 H 22 V 14.5 H 20 Z"
                                                                  Width="20" Height="20" Foreground="#86EFAC"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Panel>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15.5" FontWeight="Bold"
                                                                   Foreground="#F1F5F9" VerticalAlignment="Center" />

                                                        <Border Grid.Column="1" IsVisible="{Binding IsReady}"
                                                                Background="#2235D22B" BorderBrush="#5535D22B" BorderThickness="1"
                                                                CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <PathIcon Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 Z"
                                                                          Width="9" Height="9" Foreground="#86EFAC" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold"
                                                                           Foreground="#86EFAC" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Spacing="9" IsVisible="{Binding ShowButton}" Margin="0,3,0,0">
                                                        <ProgressBar Classes="AssetBar" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                                                     IsIndeterminate="{Binding IsIndeterminate}" />

                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5"
                                                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" IsVisible="{Binding ShowPercent}"
                                                                       FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                            <Button Grid.Column="3" Classes="AssetPrimaryBtn" Content="{Binding ButtonText}"
                                                                    IsEnabled="{Binding CanDownload}" Click="OnAssetDownloadClicked" Cursor="Hand"
                                                                    Margin="6,0,0,0" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Footer: the one reason something failed, then the way out -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="26,18,26,22">
                            <TextBlock Grid.Column="0" Text="{Binding Assets.Notice}" FontSize="11.5" Foreground="#F87171"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />

                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnAssetsCloseClicked" Cursor="Hand"
                                    IsVisible="{Binding Assets.HasMissing}" Padding="18,9">
                                <TextBlock Text="{Binding Loc.AssetsLater}" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" />
                            </Button>

                            <Button Grid.Column="2" Classes="AssetPrimaryBtn Large" Click="OnAssetsDownloadAllClicked" Cursor="Hand"
                                    IsVisible="{Binding Assets.HasMissing}" IsEnabled="{Binding Assets.CanDownloadAll}"
                                    Content="{Binding Loc.AssetsDownloadAll}" />

                            <Button Grid.Column="2" Classes="AssetPrimaryBtn Large" Click="OnAssetsCloseClicked" Cursor="Hand"
                                    IsVisible="{Binding Assets.AllReady}"
                                    Content="{Binding Loc.AssetsDone}" />
                        </Grid>
                    </Grid>
                </Border>
            </Panel>

            <!-- ============================================================ -->
            <!-- SUPPORT PROMPT                                               -->
            <!-- Appears once, ten minutes in, and never again for this build. -->
            <!-- ============================================================ -->
            <Border Classes="GlassModalCard" IsVisible="{Binding IsSupportPromptVisible}"
                    ZIndex="9500" Width="460" Padding="22,18"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="{Binding SupportPromptTitle}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding SupportPromptText}" FontSize="11.5" Foreground="#94A3B8"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>

                        <Button Grid.Column="1" Classes="GlassWindowControlBtn Close" Click="OnDismissSupportPromptClicked"
                                VerticalAlignment="Top" Cursor="Hand" ToolTip.Tip="{Binding Loc.Close}">
                            <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                      Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Button Classes="GlassLinkBtn Donate" Click="OnSupportPromptDonateClicked" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="ko-fi.com/nodix">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M 12,21.35 L 10.55,20.03 C 5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3 9.24,3 10.91,3.81 12,5.09 13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5 22,12.28 18.6,15.36 13.45,20.04 Z"
                                      Width="15" Height="15" Foreground="#FF8FB1" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc.BtnSupportKofi}" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Dynamic Drag-and-Drop Floating Ghost Layer -->
            <Canvas Name="DragOverlayCanvas" IsHitTestVisible="False" ZIndex="99999">
                <Border Name="FloatingDragGhost"
                        IsVisible="{Binding IsDraggingCard}"
                        Width="216" Height="286" CornerRadius="24" ClipToBounds="True"
                        Background="#101814" BorderBrush="#FFFFFF" BorderThickness="1.5"
                        Padding="6"
                        BoxShadow="0 16 40 0 #80000000"
                        Opacity="0.95"
                        RenderTransformOrigin="50%,50%">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                    </Border.RenderTransform>

                    <Border CornerRadius="18" ClipToBounds="True" Background="#080C0A">
                        <Panel>
                            <Image Source="{Binding DraggedCardImage}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <Border BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="18" />
                            <Border VerticalAlignment="Bottom" Background="#E0060A08" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" Padding="8,6">
                                <TextBlock Text="{Binding DraggedCardTitle}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Panel>
                    </Border>
                </Border>
            </Canvas>

            <!-- ============================================================ -->
            <!-- CHAT: SOMEONE REPLIED TO YOU                                 -->
            <!-- Only replies to your own messages, and only inside the app.  -->
            <!-- Click it to open the chat; it also fades out by itself.      -->
            <!-- ============================================================ -->
            <Border IsVisible="{Binding Pulse.HasReplyToast}" ZIndex="9700"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26"
                    Background="#F2101613" BorderBrush="#5500FF88" BorderThickness="1" CornerRadius="16"
                    Padding="13,11" MaxWidth="380" Cursor="Hand" PointerPressed="OnReplyToastPressed">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#2200FF88"
                            VerticalAlignment="Center">
                        <PathIcon Data="M10,9V5L3,12L10,19V14.9C15,14.9 18.5,16.5 21,20C20,15 17,10 10,9Z"
                                  Width="14" Height="14" Foreground="#7CFFC4" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="NEW REPLY" FontSize="9.5" FontWeight="Bold" Foreground="#7CFFC4" LetterSpacing="0.8" />
                        <TextBlock Text="{Binding Pulse.ReplyToastText}" FontSize="12" Foreground="#E2E8F0"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="RouteChip" Click="OnReplyToastCloseClicked" Cursor="Hand"
                            Padding="5" VerticalAlignment="Top">
                        <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                  Width="8" Height="8" Foreground="#94A3B8" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ADD-ONS REMINDER: 10 s after launch, gone 10 s later.        -->
            <!-- Only while an add-on is missing. Click to open Downloads.    -->
            <!-- ============================================================ -->
            <Border IsVisible="{Binding IsDownloadsHintShown}" ZIndex="9690"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                    Background="#F2101613" BorderBrush="#5500FF88" BorderThickness="1" CornerRadius="16"
                    Padding="13,11" MaxWidth="440" Cursor="Hand" PointerPressed="OnDownloadsHintPressed">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#2200FF88"
                            VerticalAlignment="Center">
                        <PathIcon Data="M 5,20 H 19 V 18 H 5 Z M 19,9 H 15 V 3 H 9 V 9 H 5 L 12,16 Z"
                                  Width="14" Height="14" Foreground="#7CFFC4" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc.DownloadsHintTitle}" FontSize="9.5" FontWeight="Bold" Foreground="#7CFFC4" LetterSpacing="0.8" />
                        <TextBlock Text="{Binding Loc.DownloadsHintText}" FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="RouteChip" Click="OnDownloadsHintCloseClicked" Cursor="Hand"
                            Padding="5" VerticalAlignment="Top">
                        <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                  Width="8" Height="8" Foreground="#94A3B8" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- CHAT: A PICTURE AT FULL SIZE                                 -->
            <!-- Click outside it, CLOSE or Esc to go back; SAVE asks where.  -->
            <!-- ============================================================ -->
            <Panel IsVisible="{Binding Pulse.IsViewerOpen}" ZIndex="9800">
                <Border Background="#E6050807" PointerPressed="OnChatViewerBackdropPressed" />

                <Grid RowDefinitions="*,Auto" Margin="48,40,48,28">
                    <Image Grid.Row="0" Source="{Binding Pulse.ViewerImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Classes="ApplePrimaryBtn" Click="OnChatViewerSaveClicked" Cursor="Hand" Padding="18,9">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Width="13" Height="13" />
                                <TextBlock Text="{Binding Loc.ChatSaveImage}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- Copies this picture onto the gallery wall, already approved. Only
                             the developer sees it; the server checks that again before copying. -->
                        <Button Classes="EmptyActionBtn" Click="OnPromoteToGalleryClicked" Cursor="Hand" Padding="18,9"
                                IsVisible="{Binding Pulse.ViewerIsDev}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z"
                                          Width="13" Height="13" Foreground="#FCD34D" />
                                <TextBlock Text="{Binding Loc.GalleryPromote}" FontSize="11.5" FontWeight="Bold"
                                           Foreground="#FCD34D" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="EmptyActionBtn" Click="OnChatViewerCloseClicked" Cursor="Hand" Padding="18,9">
                            <TextBlock Text="{Binding Loc.ChatClose}" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Panel>

            <!-- ============================================================ -->
            <!-- PRIVATE CHAT: A PICTURE AT FULL SIZE                         -->
            <!-- Its own state, like the gallery's: the chat viewer carries   -->
            <!-- actions that act on public messages.                         -->
            <!-- ============================================================ -->
            <Panel IsVisible="{Binding Dm.IsViewerOpen}" ZIndex="9820">
                <Border Background="#E6050807" PointerPressed="OnDmViewerBackdropPressed" />

                <Grid RowDefinitions="*,Auto" Margin="48,40,48,28">
                    <Image Grid.Row="0" Source="{Binding Dm.ViewerImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Classes="EmptyActionBtn" Click="OnDmViewerCloseClicked" Cursor="Hand" Padding="18,9">
                            <TextBlock Text="{Binding Loc.ChatClose}" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Panel>

            <!-- ============================================================ -->
            <!-- GALLERY: A PICTURE AT FULL SIZE                              -->
            <!-- The chat's viewer, on the gallery's own state - so a wall     -->
            <!-- picture can never be mistaken for a chat message, which is    -->
            <!-- what "TO GALLERY" above acts on.                              -->
            <!-- ============================================================ -->
            <Panel IsVisible="{Binding Gallery.IsViewerOpen}" ZIndex="9810">
                <Border Background="#E6050807" PointerPressed="OnGalleryViewerBackdropPressed" />

                <Grid RowDefinitions="*,Auto" Margin="48,40,48,28">
                    <Image Grid.Row="0" Source="{Binding Gallery.ViewerImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Classes="ApplePrimaryBtn" Click="OnGalleryViewerSaveClicked" Cursor="Hand" Padding="18,9">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Width="13" Height="13" />
                                <TextBlock Text="{Binding Loc.ChatSaveImage}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="EmptyActionBtn" Click="OnGalleryViewerCloseClicked" Cursor="Hand" Padding="18,9">
                            <TextBlock Text="{Binding Loc.ChatClose}" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Panel>

            <!-- ============================================================ -->
            <!-- COMMUNITY: ONE GAME'S REPORTS                                -->
            <!-- ============================================================ -->
            <Panel IsVisible="{Binding Community.IsSheetOpen}" ZIndex="9200">
                <Border Background="#96000000" PointerPressed="OnCommunitySheetCloseClicked" />

                <Border Classes="GlassModalCard" Width="760" MaxHeight="700"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <!-- Four rows since 1.2.7: title, the pinned note, the route
                         chips, then the feed. -->
                    <Grid RowDefinitions="Auto,Auto,Auto,*">

                        <!-- Title and close -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{Binding Community.SheetTitle}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Loc.CommunitySection}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#64748B" LetterSpacing="0.6" />
                            </StackPanel>

                            <Button Grid.Column="1" Classes="GlassWindowControlBtn Close" Click="OnCommunitySheetCloseClicked"
                                    VerticalAlignment="Top" ToolTip.Tip="{Binding Loc.Close}">
                                <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                          Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Pinned advice, above the reports because it is usually the
                             answer people are scrolling to find. Only the developer's
                             own device is offered the editor, and the server refuses
                             the write from anyone else regardless. -->
                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,14">
                            <Border IsVisible="{Binding Community.HasSheetNote}"
                                    Background="#1400FF88" BorderBrush="#3300FF88" BorderThickness="1"
                                    CornerRadius="12" Padding="13,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="M 16,12 V 4 H 17 V 2 H 7 V 4 H 8 V 12 L 6,14 V 16 H 11.2 V 22 H 12.8 V 16 H 18 V 14 L 16,12 Z"
                                              Width="13" Height="13" Foreground="#7CFFC4" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Community.SheetNote}" FontSize="12" Foreground="#DCFCE7"
                                               TextWrapping="Wrap" LineHeight="18" MaxWidth="640" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Community.IsDev}">
                                <Button Classes="EmptyActionBtn" Click="OnPinNoteClicked" Cursor="Hand" Padding="12,5"
                                        IsEnabled="{Binding !Community.IsNoteEditorOpen}">
                                    <TextBlock Text="PIN A NOTE" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- "I have run this myself and it works." It pins the
                                     verdict on the game above whatever the reports add
                                     up to, and only this device is offered it - the
                                     server checks the profile again anyway. -->
                                <Button Classes="EmptyActionBtn" Click="OnMarkTestedByDevClicked" Cursor="Hand" Padding="12,5"
                                        IsEnabled="{Binding Community.IsIdle}"
                                        ToolTip.Tip="Mark this game as working, whatever the reports say">
                                    <TextBlock Text="TESTED BY THE DEVELOPER" FontSize="10.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                </Button>
                            </StackPanel>

                            <StackPanel Spacing="7" IsVisible="{Binding Community.IsNoteEditorOpen}">
                                <TextBox Text="{Binding Community.SheetNoteDraft, Mode=TwoWay}"
                                         PlaceholderText="One line of advice for this game - leaving it empty takes the pin down"
                                         AcceptsReturn="False" MaxLength="300" FontSize="12.5" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Classes="EmptyActionBtn" Click="OnCancelNoteClicked" Cursor="Hand" Padding="14,6">
                                        <TextBlock Text="CANCEL" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                    </Button>
                                    <Button Classes="ApplePrimaryBtn" Click="OnSaveNoteClicked" Cursor="Hand" Padding="18,6"
                                            IsEnabled="{Binding Community.IsIdle}">
                                        <TextBlock Text="SAVE" FontSize="10.5" FontWeight="Bold" Foreground="#F5F5F7" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Which install method worked here. One chip per route
                             people actually used, with that route's own tally. -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,14" IsVisible="{Binding Community.HasRouteChips}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="RouteChip" Click="OnCommunitySheetRouteClicked" Tag="" Cursor="Hand" Padding="0">
                                    <Border Background="#0AFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                            CornerRadius="12" Padding="13,9">
                                        <TextBlock Text="ALL" FontSize="11.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                    </Border>
                                </Button>

                                <ItemsControl ItemsSource="{Binding Community.RouteChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RouteChipViewModel">
                                            <Button Classes="RouteChip" Click="OnCommunitySheetRouteClicked" Tag="{Binding Route}"
                                                    Cursor="Hand" Padding="0">
                                                <Border Background="{Binding Tint}" BorderBrush="{Binding Edge}" BorderThickness="1"
                                                        CornerRadius="12" Padding="13,9">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{Binding Accent}" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Working}" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Ellipse Width="6" Height="6" Fill="#F59E0B" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Mixed}" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Broken}" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- The feed -->
                        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <!-- A gutter on the right: the scrollbar overlays its content,
                                 so without it the bar sat on top of the report text. -->
                            <StackPanel Spacing="12" Margin="0,0,14,0">

                                <Border IsVisible="{Binding !Community.HasReports}" Background="#08FFFFFF" BorderBrush="#18FFFFFF"
                                        BorderThickness="1" CornerRadius="16" Padding="24" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <TextBlock Text="{Binding Loc.NoReportsTitle}" FontSize="12.5" Foreground="#94A3B8" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding Community.Reports}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CommunityReportViewModel">
                                            <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                                    CornerRadius="16" Padding="16" Margin="0,0,0,10">
                                                <StackPanel Spacing="11">

                                                    <!-- Who, when, and how it went -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                                Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                                                       Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <TextBlock Text="{Binding Author}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />

                                                                <!-- The developer's own handle. The server refuses every
                                                                     name containing "nodix" to anyone else, so this badge
                                                                     only shows what the server already guaranteed. -->
                                                                <Border Background="#1A00FF88" BorderBrush="#4400FF88" BorderThickness="1"
                                                                        CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsVerified}"
                                                                        ToolTip.Tip="Verified developer">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <PathIcon Data="M 12,2 L 15,5 L 19,5 L 19,9 L 22,12 L 19,15 L 19,19 L 15,19 L 12,22 L 9,19 L 5,19 L 5,15 L 2,12 L 5,9 L 5,5 L 9,5 Z M 10.6,15.6 L 17,9.2 L 15.6,7.8 L 10.6,12.8 L 8.4,10.6 L 7,12 Z"
                                                                                  Width="10" Height="10" Foreground="#00FF88" VerticalAlignment="Center" />
                                                                        <TextBlock Text="DEV" FontSize="8.5" FontWeight="Bold" Foreground="#7CFFC4" LetterSpacing="0.6" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- What this person is. An ordinary player gets no
                                                                     badge at all - one reading "PLAYER" on every post
                                                                     would say nothing and cost a line. -->
                                                                <Border Background="{Binding RoleTint}" BorderBrush="{Binding RoleEdge}" BorderThickness="1"
                                                                        CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                                                        IsVisible="{Binding HasRole}">
                                                                    <TextBlock Text="{Binding RoleText}" FontSize="8.5" FontWeight="Bold"
                                                                               Foreground="{Binding RoleAccent}" LetterSpacing="0.6" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Ago}" FontSize="10.5" Foreground="#64748B" />
                                                        </StackPanel>

                                                        <Border Grid.Column="2" Background="{Binding StatusTint}" BorderBrush="{Binding StatusEdge}"
                                                                BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold"
                                                                       Foreground="{Binding StatusAccent}" LetterSpacing="0.6" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Developer only: correct a verdict in place. The post and
                                                         its replies stay; only the verdict moves. The server
                                                         checks the profile again before accepting it. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsDevViewer}">
                                                        <TextBlock Text="CORRECT TO" FontSize="9" FontWeight="Bold" Foreground="#64748B"
                                                                   LetterSpacing="0.6" VerticalAlignment="Center" />
                                                        <Button Classes="RouteChip" Click="OnCorrectStatusClicked" Tag="working" Cursor="Hand" Padding="9,3">
                                                            <TextBlock Text="WORKING" FontSize="9" FontWeight="Bold" Foreground="#86EFAC" />
                                                        </Button>
                                                        <Button Classes="RouteChip" Click="OnCorrectStatusClicked" Tag="mixed" Cursor="Hand" Padding="9,3">
                                                            <TextBlock Text="MIXED" FontSize="9" FontWeight="Bold" Foreground="#FCD34D" />
                                                        </Button>
                                                        <Button Classes="RouteChip" Click="OnCorrectStatusClicked" Tag="broken" Cursor="Hand" Padding="9,3">
                                                            <TextBlock Text="NOT WORKING" FontSize="9" FontWeight="Bold" Foreground="#FCA5A5" />
                                                        </Button>
                                                        <Border Width="1" Background="#22FFFFFF" Margin="4,2" />
                                                        <!-- For what a correction cannot fix: spam, abuse, or a
                                                             report filed against the wrong game. -->
                                                        <Button Classes="RouteChip" Click="OnRemoveReportClicked" Cursor="Hand" Padding="9,3"
                                                                ToolTip.Tip="Remove this report and its replies">
                                                            <TextBlock Text="REMOVE" FontSize="9" FontWeight="Bold" Foreground="#F87171" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- The author changing their own verdict, with no time limit.
                                                         Drivers change and so do machines; the person who filed it
                                                         is the one who knows. Calling a game broken still needs the
                                                         specs it broke on, and the server enforces that. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsMine}">
                                                        <TextBlock Text="CHANGE YOUR VERDICT" FontSize="9" FontWeight="Bold" Foreground="#64748B"
                                                                   LetterSpacing="0.6" VerticalAlignment="Center" />
                                                        <Button Classes="RouteChip" Click="OnEditOwnStatusClicked" Tag="working" Cursor="Hand" Padding="9,3">
                                                            <TextBlock Text="WORKING" FontSize="9" FontWeight="Bold" Foreground="#86EFAC" />
                                                        </Button>
                                                        <Button Classes="RouteChip" Click="OnEditOwnStatusClicked" Tag="mixed" Cursor="Hand" Padding="9,3">
                                                            <TextBlock Text="MIXED" FontSize="9" FontWeight="Bold" Foreground="#FCD34D" />
                                                        </Button>
                                                        <Button Classes="RouteChip" Click="OnEditOwnStatusClicked" Tag="broken" Cursor="Hand" Padding="9,3">
                                                            <TextBlock Text="NOT WORKING" FontSize="9" FontWeight="Bold" Foreground="#FCA5A5" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- How it was installed - the part the competitor does not show -->
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Border Background="{Binding RouteTint}" BorderBrush="{Binding RouteEdge}" BorderThickness="1"
                                                                CornerRadius="8" Padding="9,3">
                                                            <TextBlock Text="{Binding RouteLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RouteAccent}" />
                                                        </Border>
                                                        <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                                CornerRadius="8" Padding="9,3">
                                                            <TextBlock Text="{Binding TargetLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                                                        </Border>
                                                        <Border Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1"
                                                                CornerRadius="8" Padding="9,3" IsVisible="{Binding HasNeural}">
                                                            <TextBlock Text="NEURAL" FontSize="10.5" FontWeight="Bold" Foreground="#FCD34D" />
                                                        </Border>
                                                        <Border Background="#1A00FF88" BorderBrush="#3300FF88" BorderThickness="1"
                                                                CornerRadius="8" Padding="9,3" IsVisible="{Binding HasOverlay}">
                                                            <TextBlock Text="OVERLAY" FontSize="10.5" FontWeight="Bold" Foreground="#7CFFC4" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Body}" FontSize="12.5"
                                                               Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="19">
                                                        <TextBlock.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="HasBody" />
                                                                <Binding Path="!IsEditingBody" />
                                                            </MultiBinding>
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>

                                                    <!-- Fixing your own words. The verdict has always been
                                                         correctable; the text was not, and that is what people
                                                         meant by "editing does not work". -->
                                                    <Button Classes="RouteChip" Click="OnBeginEditBodyClicked" Cursor="Hand" Padding="9,3"
                                                            HorizontalAlignment="Left" ToolTip.Tip="Edit what you wrote">
                                                        <Button.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsMine" />
                                                                <Binding Path="!IsEditingBody" />
                                                            </MultiBinding>
                                                        </Button.IsVisible>
                                                        <TextBlock Text="EDIT TEXT" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" />
                                                    </Button>

                                                    <StackPanel Spacing="7" IsVisible="{Binding IsEditingBody}">
                                                        <TextBox Text="{Binding BodyDraft, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                                                 MinHeight="70" MaxLength="600" FontSize="12.5" PlaceholderText="What happened in this game?" />
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Button Classes="RouteChip" Click="OnSaveOwnBodyClicked" Cursor="Hand" Padding="11,4">
                                                                <TextBlock Text="SAVE" FontSize="9" FontWeight="Bold" Foreground="#86EFAC" />
                                                            </Button>
                                                            <Button Classes="RouteChip" Click="OnCancelEditBodyClicked" Cursor="Hand" Padding="11,4">
                                                                <TextBlock Text="CANCEL" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" />
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- The machine, only when the poster attached it. The card
                                                         carries the graphics card - what people compare - and a
                                                         small button opens everything else as a tidy list, instead
                                                         of six chips running off the edge under the scrollbar. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HasGpu}">
                                                        <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                                                CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Gpu}" FontSize="10.5" Foreground="#CBD5E1"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                        </Border>
                                                        <Button Classes="RouteChip" Click="OnToggleSpecsClicked" Cursor="Hand" Padding="9,3"
                                                                VerticalAlignment="Center" IsVisible="{Binding HasMoreSpecs}"
                                                                ToolTip.Tip="Show the rest of this machine">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="SPECS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"
                                                                           LetterSpacing="0.6" VerticalAlignment="Center" />
                                                                <PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                                                          Width="9" Height="9" Foreground="#94A3B8" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>

                                                    <Border Background="#08FFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1"
                                                            CornerRadius="10" Padding="12,9" IsVisible="{Binding IsSpecsOpen}">
                                                        <StackPanel Spacing="5">
                                                            <Grid ColumnDefinitions="96,*" IsVisible="{Binding HasDriver}">
                                                                <TextBlock Text="DRIVER" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Driver}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" IsVisible="{Binding HasCpu}">
                                                                <TextBlock Text="PROCESSOR" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Cpu}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" IsVisible="{Binding HasRam}">
                                                                <TextBlock Text="MEMORY" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Ram}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" IsVisible="{Binding HasOs}">
                                                                <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Os}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" IsVisible="{Binding HasVersion}">
                                                                <TextBlock Text="APP" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                                                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Reactions and the reply toggle -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                                                            <Button Classes="EmojiBtn" Click="OnCommunityReactClicked" Tag="1" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji1}" FontSize="13" />
                                                                    <TextBlock Text="{Binding Count1}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="EmojiBtn" Click="OnCommunityReactClicked" Tag="2" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji2}" FontSize="13" />
                                                                    <TextBlock Text="{Binding Count2}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="EmojiBtn" Click="OnCommunityReactClicked" Tag="3" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji3}" FontSize="13" />
                                                                    <TextBlock Text="{Binding Count3}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="EmojiBtn" Click="OnCommunityReactClicked" Tag="4" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji4}" FontSize="13" />
                                                                    <TextBlock Text="{Binding Count4}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="EmojiBtn" Click="OnCommunityReactClicked" Tag="5" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock FontFamily="Segoe UI Emoji" Text="{Binding Emoji5}" FontSize="13" />
                                                                    <TextBlock Text="{Binding Count5}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>

                                                        <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnCommunityCommentsClicked"
                                                                Cursor="Hand" Padding="12,6">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <PathIcon Data="M 20,2 H 4 C 2.9,2 2,2.9 2,4 V 22 L 6,18 H 20 C 21.1,18 22,17.1 22,16 V 4 C 22,2.9 21.1,2 20,2 Z"
                                                                          Width="12" Height="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CommentCountText}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Replies -->
                                                    <StackPanel Spacing="9" IsVisible="{Binding IsCommentsOpen}">
                                                        <Rectangle Height="1" Fill="#12FFFFFF" HorizontalAlignment="Stretch" />

                                                        <ItemsControl ItemsSource="{Binding Comments}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:CommunityCommentViewModel">
                                                                    <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                                                            CornerRadius="12" Padding="12,9" Margin="0,0,0,7">
                                                                        <StackPanel Spacing="4">
                                                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                                                <TextBlock Text="{Binding Author}" FontSize="11.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                                                                <Border Background="#1A00FF88" BorderBrush="#4400FF88" BorderThickness="1"
                                                                                        CornerRadius="5" Padding="5,0.5" VerticalAlignment="Center"
                                                                                        IsVisible="{Binding IsVerified}" ToolTip.Tip="Verified developer">
                                                                                    <TextBlock Text="DEV" FontSize="8" FontWeight="Bold" Foreground="#7CFFC4" LetterSpacing="0.5" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Ago}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Body}" FontSize="12" Foreground="#CBD5E1"
                                                                                       TextWrapping="Wrap" LineHeight="18"
                                                                                       IsVisible="{Binding !IsEditing}" />

                                                                            <!-- Your own reply, fixed from a button: the text is
                                                                                 text until the button is pressed. A reply is
                                                                                 usually where the answer ends up. -->
                                                                            <Button Classes="RouteChip" Click="OnBeginEditCommentClicked" Cursor="Hand"
                                                                                    Padding="8,2" HorizontalAlignment="Left" ToolTip.Tip="Edit this reply">
                                                                                <Button.IsVisible>
                                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                                        <Binding Path="IsMine" />
                                                                                        <Binding Path="!IsEditing" />
                                                                                    </MultiBinding>
                                                                                </Button.IsVisible>
                                                                                <TextBlock Text="EDIT" FontSize="8.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                                                            </Button>

                                                                            <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                                                                                <TextBox Text="{Binding Draft, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                                                                         MinHeight="56" MaxLength="400" FontSize="12" />
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <Button Classes="RouteChip" Click="OnSaveOwnCommentClicked" Cursor="Hand" Padding="10,3">
                                                                                        <TextBlock Text="SAVE" FontSize="8.5" FontWeight="Bold" Foreground="#86EFAC" />
                                                                                    </Button>
                                                                                    <Button Classes="RouteChip" Click="OnCancelEditCommentClicked" Cursor="Hand" Padding="10,3">
                                                                                        <TextBlock Text="CANCEL" FontSize="8.5" FontWeight="Bold" Foreground="#CBD5E1" />
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                                                            <TextBox Grid.Column="0" Text="{Binding ReplyText, Mode=TwoWay}"
                                                                     PlaceholderText="{Binding $parent[Window].DataContext.Loc.ReplyPlaceholder}"
                                                                     MaxLength="400" Height="34" FontSize="12" />
                                                            <Button Grid.Column="1" Classes="EmptyActionBtn" Click="OnCommunityReplyClicked"
                                                                    Cursor="Hand" Padding="14,7" IsEnabled="{Binding CanReply}">
                                                                <TextBlock Text="{Binding $parent[Window].DataContext.Loc.BtnReply}"
                                                                           FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Panel>

            <!-- ============================================================ -->
            <!-- COMMUNITY: THE COMPOSER                                      -->
            <!-- Opened from a game's Manage sheet, so the install method is   -->
            <!-- already known and the user only picks the verdict.            -->
            <!-- ============================================================ -->
            <Panel IsVisible="{Binding Community.IsComposerOpen}" ZIndex="9300">
                <Border Background="#B4000000" PointerPressed="OnComposerCloseClicked" />

                <Border Classes="GlassModalCard" Width="560" MaxHeight="660"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <StackPanel Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{Binding Loc.CommunityPostTitle}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding Community.ComposeTitle}" FontSize="12" Foreground="#94A3B8"
                                           TextTrimming="CharacterEllipsis" MaxWidth="400" HorizontalAlignment="Left" />
                            </StackPanel>

                            <Button Grid.Column="1" Classes="GlassWindowControlBtn Close" Click="OnComposerCloseClicked"
                                    VerticalAlignment="Top" ToolTip.Tip="{Binding Loc.Close}">
                                <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                          Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Verdict -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Loc.CommunityResult}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#7C8595" LetterSpacing="0.6" />
                            <Border CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1">
                                <UniformGrid Columns="3">
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding Community.IsStatusWorking}"
                                            Click="OnComposerStatusClicked" Tag="working" Content="{Binding Loc.StatusWorking}" />
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding Community.IsStatusMixed}"
                                            Click="OnComposerStatusClicked" Tag="mixed" Content="{Binding Loc.StatusMixed}" />
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding Community.IsStatusBroken}"
                                            Click="OnComposerStatusClicked" Tag="broken" Content="{Binding Loc.StatusBroken}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- The route, read straight off the install manifest -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Loc.CommunityInstallMethod}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#7C8595" LetterSpacing="0.6" />
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border Background="#1438BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="9" Padding="11,5">
                                    <TextBlock Text="{Binding Community.ComposeRouteLabel}" FontSize="11.5" FontWeight="Bold" Foreground="#7DD3FC" />
                                </Border>
                                <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="9" Padding="11,5">
                                    <TextBlock Text="{Binding Community.ComposeTargetLabel}" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Note -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Loc.CommunityNote}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#7C8595" LetterSpacing="0.6" />
                            <TextBox Text="{Binding Community.ComposeBody, Mode=TwoWay}"
                                     PlaceholderText="{Binding Loc.CommunityNotePlaceholder}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="600" Height="86" FontSize="12.5" />
                        </StackPanel>

                        <!-- Hardware. Nothing is read until Detect is pressed, and
                             what it found is shown before it is ever sent. -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Loc.CommunitySpecs}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#7C8595" LetterSpacing="0.6" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                    <Button Classes="EmptyActionBtn" Click="OnComposerDetectSpecsClicked" Cursor="Hand" Padding="12,5"
                                            IsVisible="{Binding !Community.HasSpecs}" IsEnabled="{Binding !Community.IsDetectingSpecs}">
                                        <TextBlock Text="{Binding Loc.BtnDetectSpecs}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Button>
                                    <Button Classes="EmptyActionBtn" Click="OnComposerClearSpecsClicked" Cursor="Hand" Padding="12,5"
                                            IsVisible="{Binding Community.HasSpecs}">
                                        <TextBlock Text="{Binding Loc.BtnRemoveSpecs}" FontSize="10.5" FontWeight="Bold" Foreground="#EF4444" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding Community.HasSpecs}">
                                <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="9,3">
                                    <TextBlock Text="{Binding Community.SpecsGpu}" FontSize="10.5" Foreground="#CBD5E1" />
                                </Border>
                                <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="9,3">
                                    <TextBlock Text="{Binding Community.SpecsDriver}" FontSize="10.5" Foreground="#CBD5E1" />
                                </Border>
                                <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="9,3">
                                    <TextBlock Text="{Binding Community.SpecsRam}" FontSize="10.5" Foreground="#CBD5E1" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Community.SpecsOs}" IsVisible="{Binding Community.HasSpecs}"
                                       FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Community.SpecsCpu}" IsVisible="{Binding Community.HasSpecs}"
                                       FontSize="10.5" Foreground="#7C8595" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Text="{Binding Community.StatusMessage}" IsVisible="{Binding Community.HasStatusMessage}"
                                   FontSize="11.5" Foreground="#FCA5A5" TextWrapping="Wrap" />

                        <Button Classes="ApplePrimaryBtn" Click="OnComposerPostClicked" Cursor="Hand"
                                IsEnabled="{Binding Community.IsIdle}" HorizontalAlignment="Right" Padding="28,10">
                            <TextBlock Text="{Binding Loc.BtnPost}" FontSize="12" FontWeight="Bold" Foreground="#F5F5F7" />
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>
        </Panel>
    </Border>

    <!-- Resize grips. There is no system frame to grab (WindowDecorations="None"),
         so these hand the drag to the OS with BeginResizeDrag. Thin enough to
         miss the controls near the edges; hidden while maximised. -->
    <Panel x:Name="ResizeGrips">
        <Border Tag="North" Height="6" VerticalAlignment="Top" Margin="18,0" Background="Transparent" Cursor="TopSide" PointerPressed="OnResizeGripPressed" />
        <Border Tag="South" Height="6" VerticalAlignment="Bottom" Margin="18,0" Background="Transparent" Cursor="BottomSide" PointerPressed="OnResizeGripPressed" />
        <Border Tag="West" Width="6" HorizontalAlignment="Left" Margin="0,18" Background="Transparent" Cursor="LeftSide" PointerPressed="OnResizeGripPressed" />
        <Border Tag="East" Width="6" HorizontalAlignment="Right" Margin="0,18" Background="Transparent" Cursor="RightSide" PointerPressed="OnResizeGripPressed" />
        <Border Tag="NorthWest" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="OnResizeGripPressed" />
        <Border Tag="NorthEast" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="OnResizeGripPressed" />
        <Border Tag="SouthWest" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="OnResizeGripPressed" />
        <Border Tag="SouthEast" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizeGripPressed" />
    </Panel>
    </Panel>
</Window>
