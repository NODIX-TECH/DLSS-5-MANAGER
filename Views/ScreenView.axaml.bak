<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DLSS_5_MANAGER.Views.ScreenView" x:DataType="vm:ScreenViewModel" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" xmlns:vm="using:DLSS_5_MANAGER.ViewModels">
  <UserControl.Resources>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#94A3B8" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
    <ControlTheme x:Key="ScreenSlider" TargetType="Slider">
      <Setter Property="Height" Value="40" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Margin="0,3" ClipToBounds="True">
            <Border Height="32" CornerRadius="16" BorderBrush="#35FFFFFF" BorderThickness="1">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#35FFFFFF" Offset="0" /><GradientStop Color="#0CFFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
            </Border>
            <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="Horizontal">
              <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Focusable="False" HorizontalAlignment="Stretch" Padding="0" BorderThickness="0"><RepeatButton.Template><ControlTemplate><Border Height="30" CornerRadius="15,0,0,15" Background="{DynamicResource SliderTrackValueFill}" Opacity="0.65" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseButton>
              <Track.Thumb><Thumb Name="PART_Thumb" Width="6" Height="26"><Thumb.Template><ControlTemplate><Border CornerRadius="3" BorderBrush="#60FFFFFF" BorderThickness="1" Background="{DynamicResource SliderThumbBackground}" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Focusable="False" HorizontalAlignment="Stretch" Padding="0" BorderThickness="0"><RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.ScreenCard">
      <Setter Property="Background" Value="#10000000" />
      <Setter Property="BorderBrush" Value="#25FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="LetterSpacing" Value="2" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

  </UserControl.Styles>
  <ScrollViewer x:Name="ScreenScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
    <Border Padding="28,14,28,90">
      <StackPanel Spacing="12" MaxWidth="1040">
        <Grid x:Name="ScreenHeader" ColumnDefinitions="*,Auto" Margin="4,4,4,8">
          <TextBlock Text="SCREEN" FontSize="24" FontWeight="Bold" LetterSpacing="2" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Ellipse Width="16" Height="16" Stroke="#76B900" StrokeThickness="2" StrokeDashArray="2.6,1.6" StrokeLineCap="Round" IsVisible="{Binding IsPreparing}" RenderTransformOrigin="50%,50%">
                <Ellipse.Styles><Style Selector="Ellipse"><Style.Animations><Animation Duration="0:0:1.1" IterationCount="Infinite"><KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame><KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame></Animation></Style.Animations></Style></Ellipse.Styles>
              </Ellipse>
              <TextBlock Text="{Binding Status}" Foreground="#CBD5E1" VerticalAlignment="Center" />
              <Button Classes="AppleSecondaryBtn" Content="Overlay · Shift+O" Click="OnOpenOverlay" />
            </StackPanel>
            <TextBlock Text="{Binding GpuText}" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF9C8A" TextWrapping="Wrap" />
        <TextBlock x:Name="NoResults" Text="No Screen options match your search." IsVisible="{Binding NoSearchResults}" Foreground="#94A3B8" />
        <Border x:Name="ProcessingCard" Classes="ScreenCard" IsVisible="{Binding ShowProcessing}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="8">
            <TextBlock Classes="SectionTitle" Text="PROCESSING" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="*,Auto" Grid.Column="0" Grid.Row="0">
                <TextBlock Text="DLSS 5 NR" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !Nr}" Content="OFF" Command="{Binding NrOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding Nr}" Content="ON" Command="{Binding NrOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8" Grid.Column="1" Grid.Row="0">
                <Grid ColumnDefinitions="*,Auto" Grid.ColumnSpan="2">
                  <TextBlock Text="DLSS 4.5 FG" VerticalAlignment="Center" />
                  <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !FrameGeneration}" Content="OFF" Command="{Binding FrameGenerationOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding FrameGeneration}" Content="ON" Command="{Binding FrameGenerationOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
                </Grid>
                <ComboBox Classes="GlassComboBox" Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Multipliers}" SelectedIndex="{Binding MultiplierIndex, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Grid.Column="0" Grid.Row="1">
                <TextBlock Text="Boost" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !Boost}" Content="OFF" Command="{Binding BoostOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding Boost}" Content="ON" Command="{Binding BoostOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
              </Grid>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="1">
                <TextBlock Text="Multi-pass" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <Slider Theme="{StaticResource ScreenSlider}" Minimum="1" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PassCount, Mode=TwoWay}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding PassCount, StringFormat={}{0:0}×}" />
                </Grid>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding FgInfo}" IsVisible="{Binding HasFgInfo}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Network resolution" />
                <TextBlock Grid.Column="1" Text="{Binding WorkSize}" Foreground="#94A3B8" />
              </Grid>
              <Slider Theme="{StaticResource ScreenSlider}" Minimum="0.1" Maximum="{Binding ScaleCap}" Value="{Binding WorkScale, Mode=TwoWay}" TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="{Binding Boost}" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="SegmentedTab" Content="Fast" Command="{Binding FastResolutionCommand}" Padding="10,4" />
                  <Button Classes="SegmentedTab" Content="Balanced" Command="{Binding BalancedResolutionCommand}" Padding="10,4" />
                  <Button Classes="SegmentedTab" Content="Quality" Command="{Binding QualityResolutionCommand}" Padding="10,4" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Finer detail" FontSize="11" Foreground="#94A3B8" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="SourceCard" Classes="ScreenCard" IsVisible="{Binding ShowSource}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <TextBlock Classes="SectionTitle" Text="SOURCE" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="SegmentedTab" Content="Refresh" Command="{Binding RefreshSourcesCommand}" Padding="10,4" />
              <Button Grid.Column="2" Classes="SegmentedTab" Content="Reconnect" Command="{Binding RetrySourceCommand}" Padding="10,4" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Windows}" SelectedItem="{Binding Window, Mode=TwoWay}" PlaceholderText="Select a window" MaxDropDownHeight="300" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="AppleSecondaryBtn" Content="Go to app" Command="{Binding FocusSourceCommand}" IsEnabled="{Binding IsWindowMode}" />
                <Button Classes="AppleSecondaryBtn" Content="Clear" Command="{Binding FullscreenCommand}" IsEnabled="{Binding IsWindowMode}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="EffectCard" Classes="ScreenCard" IsVisible="{Binding ShowEffect}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="8">
            <TextBlock Classes="SectionTitle" Text="EFFECT" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="0">
                <TextBlock Text="Profile" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="0">
                <TextBlock Text="Model" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Models}" SelectedIndex="{Binding ModelIndex, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Intensity" />
                  <TextBlock Grid.Column="1" Text="{Binding Intensity, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource ScreenSlider}" Minimum="0" Maximum="1" Value="{Binding Intensity, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Local tone" />
                  <TextBlock Grid.Column="1" Text="{Binding LocalTone, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource ScreenSlider}" Minimum="0" Maximum="2" Value="{Binding LocalTone, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Local structure" />
                  <TextBlock Grid.Column="1" Text="{Binding LocalStructure, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource ScreenSlider}" Minimum="0" Maximum="2" Value="{Binding LocalStructure, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Skin structure" />
                  <TextBlock Grid.Column="1" Text="{Binding SkinStructure, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource ScreenSlider}" Minimum="-1" Maximum="2.5" Value="{Binding SkinStructure, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="ComparisonCard" Classes="ScreenCard" IsVisible="{Binding ShowComparison}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="12">
            <TextBlock Classes="SectionTitle" Text="COMPARISON" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Before / after wipe" />
              <TextBlock Grid.Column="1" Text="{Binding Split, StringFormat={}{0:P0}}" />
            </Grid>
            <Slider Theme="{StaticResource ScreenSlider}" Minimum="0" Maximum="1" Value="{Binding Split, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True">
              <Slider.Resources>
                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#76B900" />
                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#8ED600" />
                <SolidColorBrush x:Key="SliderThumbBackground" Color="#76B900" />
                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#8ED600" />
              </Slider.Resources>
            </Slider>
          </StackPanel>
        </Border>
        <Border x:Name="PresetsCard" Classes="ScreenCard" IsEnabled="{Binding IsReady}" IsVisible="{Binding ShowPresets}">
          <StackPanel Spacing="12">
            <TextBlock Classes="SectionTitle" Text="MY PRESETS" />
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF9C8A" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="Preset name" />
                <TextBox Text="{Binding PresetName, Mode=TwoWay}" PlaceholderText="Name your preset" MaxLength="80" CornerRadius="12" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Saved presets" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding SavedPresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" PlaceholderText="Choose a preset" MaxDropDownHeight="240" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <Button Classes="AppleSecondaryBtn" Content="Save new" Command="{Binding SavePresetCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="1" Classes="AppleSecondaryBtn" Content="Update selected" Command="{Binding UpdatePresetCommand}" IsEnabled="{Binding CanDeletePreset}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="2" Classes="AppleSecondaryBtn" Content="Apply" Command="{Binding ApplyPresetCommand}" IsEnabled="{Binding CanDeletePreset}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="3" Classes="AppleSecondaryBtn" Content="Delete" Command="{Binding DeletePresetCommand}" IsEnabled="{Binding CanDeletePreset}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="SettingsCard" Classes="ScreenCard" IsEnabled="{Binding IsReady}" IsVisible="{Binding ShowSettings}">
          <StackPanel Spacing="8">
            <TextBlock Classes="SectionTitle" Text="SETTINGS" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto">
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="0">
                <TextBlock Text="Processing GPU" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Gpus}" SelectedItem="{Binding Gpu, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="0">
                <TextBlock Text="Display" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Monitors}" SelectedItem="{Binding Monitor, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="1">
                <TextBlock Text="Motion estimation" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding MotionBackends}" SelectedItem="{Binding MotionBackend, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Skip static frames" VerticalAlignment="Center" />
                  <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !SkipStatic}" Content="OFF" Command="{Binding SkipStaticOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding SkipStatic}" Content="ON" Command="{Binding SkipStaticOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="HDR compatibility" VerticalAlignment="Center" />
                  <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !Hdr}" Content="OFF" Command="{Binding HdrOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding Hdr}" Content="ON" Command="{Binding HdrOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="CaptureCard" Classes="ScreenCard" IsVisible="{Binding ShowCapture}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="8">
            <TextBlock Text="CAPTURE" Classes="SectionTitle" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding CanConfigureCapture}">
              <StackPanel Spacing="6">
                <TextBlock Text="Microphone" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Recording rate" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding RecordingRates}" SelectedIndex="{Binding RecordingRateIndex, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <CheckBox Content="System audio" IsChecked="{Binding SystemAudio, Mode=TwoWay}" IsEnabled="{Binding CanConfigureCapture}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding CanConfigureCapture}">
              <TextBox Text="{Binding OutputFolder, Mode=TwoWay}" PlaceholderText="Output folder" CornerRadius="12" />
              <Button Grid.Column="1" Classes="AppleSecondaryBtn" Content="Choose folder" Click="OnChooseOutput" />
            </Grid>
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
              <Button Classes="AppleSecondaryBtn" Content="Screenshot" Command="{Binding ScreenshotCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="1" Classes="AppleSecondaryBtn" Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding RecordingTime}" IsVisible="{Binding IsRecording}" Foreground="#EF7777" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding CaptureMessage}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="OBS output · Spout2" VerticalAlignment="Center" />
              <Border Grid.Column="1" CornerRadius="13" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !ExternalOutput}" Content="OFF" Command="{Binding ExternalOutputOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding ExternalOutput}" Content="ON" Command="{Binding ExternalOutputOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
            </Grid>
            <TextBlock Text="OBS: install the plugin, restart OBS, then Sources → + → Spout2 Capture → DLSS 5 MANAGER Screen. This is a video source, not Image. Enable NR or FG so frames are available." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
            <Button Classes="AppleSecondaryBtn" Content="Get OBS Spout2 plugin" Command="{Binding OpenObsPluginCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
