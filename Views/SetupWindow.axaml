<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DLSS_5_MANAGER.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="840" d:DesignHeight="520"
        Width="840" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        x:Class="DLSS_5_MANAGER.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Icon="/Assets/logo.ico"
        Title="DLSS 5 MANAGER"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="True">

    <Design.DataContext>
        <vm:SetupViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="ProgressBar.Thin">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="Foreground" Value="#35D22B" />
        </Style>

        <!-- The colour goes on the ContentPresenter: in this theme that is
             the part which draws a button's background, so setting it
             Transparent (which the glass buttons elsewhere do) would paint
             straight over anything put on the Button itself. -->
        <Style Selector="Button.SetupPrimary">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#06170A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.SetupPrimary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#35D22B" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Button.SetupPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4AE840" />
        </Style>

        <Style Selector="Button.SetupPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2BB023" />
        </Style>

        <Style Selector="Button.SetupPrimary:disabled">
            <Setter Property="Foreground" Value="#5C6B60" />
        </Style>

        <Style Selector="Button.SetupPrimary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#16211A" />
        </Style>
    </Window.Styles>

    <!-- The whole face of it drags: there is no title bar to grab. -->
    <Border CornerRadius="18"
            Background="#0A0F0C"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            ClipToBounds="True"
            PointerPressed="OnDragArea">

        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- a hairline of the program's green, the way the rest of it is marked -->
            <Border Grid.Row="0" Height="3" Background="#35D22B" />

            <!-- ============================ header ============================ -->
            <Grid Grid.Row="1" Margin="30,22,20,0" ColumnDefinitions="Auto,*,Auto">
                <Image Grid.Column="0" Source="/Assets/logo_bar.png" Width="150" Stretch="Uniform"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />

                <Button Grid.Column="2" Classes="GlassWindowControlBtn" Cursor="Hand"
                        Click="OnCloseClicked" ToolTip.Tip="Close">
                    <TextBlock Text="&#x2715;" FontSize="12" />
                </Button>
            </Grid>

            <!-- ============================= body ============================= -->
            <StackPanel Grid.Row="2" Margin="30,20,30,0" Spacing="6">
                <TextBlock Text="{Binding HeadlineText}" FontSize="22" FontWeight="SemiBold"
                           Foreground="#F1F5F9" />
                <TextBlock Text="These two come straight from our own storage rather than riding along inside the setup, which keeps the download small and lets a newer overlay reach you without a new release. They are downloaded once and kept."
                           FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="700"
                           HorizontalAlignment="Left" Margin="0,0,0,6" />

                <!-- Every card carries the same right margin, so the panel
                     gives that width back on the right to keep the last card
                     level with the buttons underneath it. -->
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,-14,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetupItemViewModel">
                            <Border CornerRadius="16" Background="#10FFFFFF" BorderBrush="#20FFFFFF"
                                    BorderThickness="1" Padding="20,18" Margin="0,0,14,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" />
                                    <TextBlock Text="{Binding Blurb}" FontSize="12" Foreground="#94A3B8"
                                               TextWrapping="Wrap" MinHeight="34" />

                                    <ProgressBar Classes="Thin"
                                                 Value="{Binding Progress}"
                                                 Minimum="0" Maximum="100"
                                                 IsIndeterminate="{Binding IsIndeterminate}" />

                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                               Foreground="{Binding StatusBrush}" TextWrapping="Wrap"
                                               MinHeight="17" />

                                    <Button Classes="SetupPrimary"
                                            Content="{Binding ButtonText}"
                                            IsEnabled="{Binding CanDownload}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand"
                                            Click="OnDownloadClicked" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============================ footer ============================ -->
            <Grid Grid.Row="3" Margin="30,0,30,24" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Notice}" FontSize="11.5" Foreground="#F87171"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                           HorizontalAlignment="Left" />

                <Button Grid.Column="1" Classes="EmptyActionBtn" Cursor="Hand" Margin="0,0,10,0"
                        Click="OnDownloadAllClicked" FontSize="12">
                    <TextBlock Text="DOWNLOAD BOTH" />
                </Button>

                <Button Grid.Column="2" Classes="SetupPrimary" Cursor="Hand"
                        IsEnabled="{Binding CanContinue}" Click="OnContinueClicked">
                    <TextBlock Text="CONTINUE" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
